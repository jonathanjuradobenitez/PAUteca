  },
  {
   "id": "matematicas-2019-junio-3",
   "n": 3,
   "num": 3,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Calcula todas las matrices \\(X=\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}\\) tales que \\(a+d=1\\), tienen determinante 1 y cumplen \\(AX=XA\\), siendo \\(A=\\begin{pmatrix}0&-1\\\\1&0\\end{pmatrix}\\).",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>Impongo \\(AX=XA\\):</p>\\[AX=\\begin{pmatrix}0&-1\\\\1&0\\end{pmatrix}\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}=\\begin{pmatrix}-c&-d\\\\a&b\\end{pmatrix}\\qquad XA=\\begin{pmatrix}a&b\\\\c&d\\end{pmatrix}\\begin{pmatrix}0&-1\\\\1&0\\end{pmatrix}=\\begin{pmatrix}b&-a\\\\d&-c\\end{pmatrix}\\]<p>Igualando: \\(-c=b\\), \\(-d=-a\\), \\(a=d\\), \\(b=-c\\). Es decir, \\(d=a\\) y \\(c=-b\\):</p>\\[X=\\begin{pmatrix}a&b\\\\-b&a\\end{pmatrix}\\]<p><b>Traza:</b> \\(a+d=1\\iff2a=1\\iff a=\\dfrac12\\).</p><p><b>Determinante 1:</b></p>\\[|X|=a^2+b^2=1\\iff\\frac14+b^2=1\\iff b^2=\\frac34\\iff b=\\pm\\frac{\\sqrt3}2\\]<div class='res'>Hay dos matrices: \\(X=\\begin{pmatrix}\\frac12&\\frac{\\sqrt3}2\\\\-\\frac{\\sqrt3}2&\\frac12\\end{pmatrix}\\) y \\(X=\\begin{pmatrix}\\frac12&-\\frac{\\sqrt3}2\\\\\\frac{\\sqrt3}2&\\frac12\\end{pmatrix}\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "matrices",
     "tipo": "ops",
     "apartados": ""
    }
   ],
   "origen": {
    "documento": "MAT-2019-JUNIO.pdf"
   },
