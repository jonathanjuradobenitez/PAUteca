4.0V8.0'/></g><line x1='91.9' y1='162.2' x2='91.9' y2='168.2' stroke='currentColor'/><text x='88.9' y='179.2' font-size='10'>1</text><line x1='202.6' y1='162.2' x2='202.6' y2='168.2' stroke='currentColor'/><text x='199.6' y='179.2' font-size='10'>3</text><line x1='33.6' y1='107.1' x2='39.6' y2='107.1' stroke='currentColor'/><text x='20.6' y='111.1' font-size='10'>2</text><line x1='33.6' y1='49.0' x2='39.6' y2='49.0' stroke='currentColor'/><text x='20.6' y='53.0' font-size='10'>4</text></svg></div><div class='res'>La gráfica (a) es la de \\(f\\) y la (b) la de \\(f'\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>La región sombreada está entre \\(x=1\\) y \\(x=3\\), con \\(f\\) por encima de \\(f'\\). Como \\(f\\) es una primitiva de \\(f'\\):</p>\\[\\int(f-f')\\,dx=\\int\\left(\\frac2x+2\\ln x\\right)dx-f(x)=2\\ln x+2(x\\ln x-x)-f(x)\\]<p>(Por partes<i class='n' data-t='th'>Integración por partes: \\(\\int u\\,dv=uv-\\int v\\,du\\).</i>, \\(\\int\\ln x\\,dx=x\\ln x-x\\).)</p>\\[\\int_1^3\\left(\\frac2x+2\\ln x\\right)dx=\\bigl[2\\ln x+2x\\ln x-2x\\bigr]_1^3=(8\\ln3-6)-(-2)=8\\ln3-4\\]\\[\\int_1^3f'(x)\\,dx=f(3)-f(1)=\\frac23+2\\ln3-2=2\\ln3-\\frac43\\]\\[A=8\\ln3-4-2\\ln3+\\frac43=6\\ln3-\\frac83\\]<div class='res'>Área \\(=6\\ln3-\\dfrac83\\approx3{,}93\\ u^2\\)</div></div>"}],"clasificacion":[{"tema":"funciones","tipo":"mono","apartados":"a"},{"tema":"integ","tipo":"area","apartados":"b"},{"tema":"integ","tipo":"part","apartados":"b"}],"origen":{"documento":"MAT-2009-RESERVA_5.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2009-reserva-5-7","n":7,"num":3,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Considera las matrices \\(A=\\begin{pmatrix}-2&-2&1\\\\-2&1&-2\\\\1&-2&-2\\end{pmatrix}\\) y \\(X=\\begin{pmatrix}x\\\\y\\\\z\\end{pmatrix}\\).","apartados":["(1 p.) Calcula, si existe, \\(A^{-1}\\).","(1,5 p.) Resuelve el sistema \\(AX=3X\\) e interpreta geométricamente el conjunto de sus soluciones."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>Por la regla de Sarrus<i class='n' data-t='th'>Regla de Sarrus: se suman los productos de la diagonal principal y de los dos triángulos con un lado paralelo a ella (en verde) y se restan los de la diagonal secundaria y sus dos triángulos (en rojo).<span style='display:block;margin:6px 0 0'><svg viewBox='0 0 206 106' width='100%' style='max-width:230px' font-family='system-ui,sans-serif'><text x='0' y='30' font-size='20' font-weight='700' fill='#17a673'>+</text><text x='0' y='86' font-size='20' font-weight='700' fill='#e8487a'>−</text><polygon points='26,10 41,25 56,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='10' r='3.6' fill='#17a673'/><circle cx='41' cy='10' r='2.2' fill='#9ca3af'/><circle cx='56' cy='10' r='2.2' fill='#9ca3af'/><circle cx='26' cy='25' r='2.2' fill='#9ca3af'/><circle cx='41' cy='25' r='3.6' fill='#17a673'/><circle cx='56' cy='25' r='2.2' fill='#9ca3af'/><circle cx='26' cy='40' r='2.2' fill='#9ca3af'/><circle cx='41' cy='40' r='2.2' fill='#9ca3af'/><circle cx='56' cy='40' r='3.6' fill='#17a673'/><polygon points='103,10 118,25 88,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='10' r='2.2' fill='#9ca3af'/><circle cx='103' cy='10' r='3.6' fill='#17a673'/><circle cx='118' cy='10' r='2.2' fill='#9ca3af'/><circle cx='88' cy='25' r='2.2' fill='#9ca3af'/><circle cx='103' cy='25' r='2.2' fill='#9ca3af'/><circle cx='118' cy='25' r='3.6' fill='#17a673'/><circle cx='88' cy='40' r='3.6' fill='#17a673'/><circle cx='103' cy='40' r='2.2' fill='#9ca3af'/><circle cx='118' cy='40' r='2.2' fill='#9ca3af'/><polygon points='180,10 150,25 165,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='10' r='2.2' fill='#9ca3af'/><circle cx='165' cy='10' r='2.2' fill='#9ca3af'/><circle cx='180' cy='10' r='3.6' fill='#17a673'/><circle cx='150' cy='25' r='3.6' fill='#17a673'/><circle cx='165' cy='25' r='2.2' fill='#9ca3af'/><circle cx='180' cy='25' r='2.2' fill='#9ca3af'/><circle cx='150' cy='40' r='2.2' fill='#9ca3af'/><circle cx='165' cy='40' r='3.6' fill='#17a673'/><circle cx='180' cy='40' r='2.2' fill='#9ca3af'/><polygon points='56,66 41,81 26,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='66' r='2.2' fill='#9ca3af'/><circle cx='41' cy='66' r='2.2' fill='#9ca3af'/><circle cx='56' cy='66' r='3.6' fill='#e8487a'/><circle cx='26' cy='81' r='2.2' fill='#9ca3af'/><circle cx='41' cy='81' r='3.6' fill='#e8487a'/><circle cx='56' cy='81' r='2.2' fill='#9ca3af'/><circle cx='26' cy='96' r='3.6' fill='#e8487a'/><circle cx='41' cy='96' r='2.2' fill='#9ca3af'/><circle cx='56' cy='96' r='2.2' fill='#9ca3af'/><polygon points='88,66 118,81 103,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='66' r='3.6' fill='#e8487a'/><circle cx='103' cy='66' r='2.2' fill='#9ca3af'/><circle cx='118' cy='66' r='2.2' fill='#9ca3af'/><circle cx='88' cy='81' r='2.2' fill='#9ca3af'/><circle cx='103' cy='81' r='2.2' fill='#9ca3af'/><circle cx='118' cy='81' r='3.6' fill='#e8487a'/><circle cx='88' cy='96' r='2.2' fill='#9ca3af'/><circle cx='103' cy='96' r='3.6' fill='#e8487a'/><circle cx='118' cy='96' r='2.2' fill='#9ca3af'/><polygon points='165,66 150,81 180,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='66' r='2.2' fill='#9ca3af'/><circle cx='165' cy='66' r='3.6' fill='#e8487a'/><circle cx='180' cy='66' r='2.2' fill='#9ca3af'/><circle cx='150' cy='81' r='3.6' fill='#e8487a'/><circle cx='165' cy='81' r='2.2' fill='#9ca3af'/><circle cx='180' cy='81' r='2.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i>:</p>\\[|A|=\\begin{vmatrix}-2&-2&1\\\\-2&1&-2\\\\1&-2&-2\\end{vmatrix}\\]\\[=\\bigl(4+4+4\\bigr)-\\bigl(1-8-8\\bigr)\\]\\[=27\\]<p>Como \\(|A|\\neq0\\), existe la inversa: \\(A^{-1}=\\dfrac1{|A|}(\\operatorname{Adj}A)^t\\).</p>\\[\\operatorname{Adj}A=\\begin{pmatrix}-6 & -6 & 3\\\\-6 & 3 & -6\\\\3 & -6 & -6\\end{pmatrix}\\Rightarrow A^{-1}=\\frac1{27}\\begin{pmatrix}-6 & -6 & 3\\\\-6 & 3 & -6\\\\3 & -6 & -6\\end{pmatrix}=\\begin{pmatrix}- \\frac{2}{9} & - \\frac{2}{9} & \\frac{1}{9}\\\\- \\frac{2}{9} & \\frac{1}{9} & - \\frac{2}{9}\\\\\\frac{1}{9} & - \\frac{2}{9} & - \\frac{2}{9}\\end{pmatrix}\\]<div class='res'>\\(A^{-1}=\\dfrac19\\begin{pmatrix}-2 & -2 & 1\\\\-2 & 1 & -2\\\\1 & -2 & -2\\end{pmatrix}\\)</div><i class='n' data-t='tp'>Es \\(\\frac19A\\): de hecho \\(A^2=9I\\).</i></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>\\(AX=3X\\iff(A-3I)X=O\\): sistema homogéneo (siempre compatible).</p>\\[A-3I=\\begin{pmatrix}-5 & -2 & 1\\\\-2 & -2 & -2\\\\1 & -2 & -5\\end{pmatrix}\\]\\[|A-3I|=\\begin{vmatrix}-5&-2&1\\\\-2&-2&-2\\\\1&-2&-5\\end{vmatrix}\\]\\[=\\bigl(-50+4+4\\bigr)-\\bigl(-2-20-20\\bigr)\\]\\[=0\\]<p>\\(\\begin{vmatrix}-5&-2\\\\-2&-2\\end{vmatrix}=6\\neq0\\): rango 2, compatible indeterminado con un parámetro. </p><p>Doy a la incógnita \\(z\\) el valor \\(z=t\\) y lo paso al segundo miembro<i class='n' data-t='why'>La incógnita que no está en el menor no nulo pasa al segundo miembro como parámetro; así queda un sistema con tantas ecuaciones como incógnitas y determinante distinto de 0, que se resuelve por Cramer.</i>:</p>\\[\\begin{cases}-5x-2y=- t\\\\-2x-2y=2 t\\end{cases}\\]<p>Lo resuelvo por la regla de Cramer<i class='n' data-t='th'>Regla de Cramer: si \\(|A|\\neq0\\), cada incógnita es el cociente entre el determinante que resulta de sustituir su columna por la de los términos independientes y el determinante \\(|A|\\) de la matriz de coeficientes.</i>:</p>\\[|A|=\\begin{vmatrix}-5&-2\\\\-2&-2\\end{vmatrix}=6\\]\\[x=\\frac{\\begin{vmatrix}- t&-2\\\\2 t&-2\\end{vmatrix}}{6}=\\frac{6 t}{6}=t\\]\\[y=\\frac{\\begin{vmatrix}-5&- t\\\\-2&2 t\\end{vmatrix}}{6}=\\frac{- 12 t}{6}=- 2 t\\]<div class='res'>\\(x=t,\\ y=-2t,\\ z=t\\) (\\(t\\in\\mathbb R\\)): es la recta que pasa por el origen con vector director \\((1,-2,1)\\)</div><i class='n' data-t='why'>Las tres ecuaciones son tres planos que pasan por el origen; como el rango es 2, se cortan en una recta.</i></div>"}],"clasificacion":[{"tema":"matrices","tipo":"inv","apartados":"a"},{"tema":"sistemas","tipo":"res","apartados":"b"}],"origen":{"documento":"MAT-2009-RESERVA_5.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2009-reserva-5-8","n":8,"num":4,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Sea la recta \\(r\\) definida por \\(\\begin{cases}3x+2y=0\\\\3x+z=0\\end{cases}\\)","apartados":["(1 p.) Determina la ecuación del plano perpendicular a \\(r\\) que pasa por el punto \\(P(1,1,1)\\).","(1,5 p.) Halla los puntos de \\(r\\) cuya distancia al origen es de 4 unidades."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>\\(r\\): con \\(x=2t\\), \\(y=-3t\\) y \\(z=-6t\\). Es \\(r\\equiv(2t,\\,-3t,\\,-6t)\\), que pasa por el origen con \\(\\vec d=(2,-3,-6)\\).</p><p>El plano es perpendicular a \\(r\\): su normal es \\(\\vec d\\), y es de la forma \\(2x-3y-6z+D=0\\). Pasa por \\(P\\): \\(2-3-6+D=0\\iff D=7\\).</p><div class='res'>\\(2x-3y-6z+7=0\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>Un punto de \\(r\\) es \\(Q(2t,-3t,-6t)\\):</p>\\[|\\overrightarrow{OQ}|=\\sqrt{4t^2+9t^2+36t^2}=7|t|=4\\iff t=\\pm\\frac47\\]<div class='f3d' data-f='{\"az\":-87,\"el\":24,\"p\":[[\"line\",[-1.5,2.25,4.5],[1.5,-2.25,-4.5],\"#2563eb\",2.2,false],[\"txt\",[1.5,-2.25,-4.5],\"r\",\"#2563eb\",6,0],[\"line\",[0,0,0],[1.143,-1.714,-3.429],\"#e11d48\",1.4,false],[\"line\",[0,0,0],[-1.143,1.714,3.429],\"#e11d48\",1.4,false],[\"pt\",[0,0,0],\"O\",7,-6],[\"pt\",[1.143,-1.714,-3.429],\"Q₁\",7,-6],[\"pt\",[-1.143,1.714,3.429],\"Q₂\",7,-6]],\"ley\":[\"recta\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 300' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m09r5b4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m09r5b4d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='m09r5b4g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#64748b'/></marker><marker id='m09r5b4r' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#2563eb'/></marker></defs><line x1='26.0' y1='18.0' x2='88.2' y2='246.0' stroke='#2563eb' stroke-width='2.2'/><text x='94.2' y='246.0' fill='#2563eb' font-weight='700' font-style='italic'>r</text><line x1='57.1' y1='132.0' x2='80.8' y2='218.9' stroke='#e11d48' stroke-width='1.4'/><line x1='57.1' y1='132.0' x2='33.4' y2='45.1' stroke='#e11d48' stroke-width='1.4'/><circle cx='57.1' cy='132.0' r='3.8' fill='#e8487a'/><text x='64.1' y='126.0' font-weight='700'>O</text><circle cx='80.8' cy='218.9' r='3.8' fill='#e8487a'/><text x='87.8' y='212.9' font-weight='700'>Q₁</text><circle cx='33.4' cy='45.1' r='3.8' fill='#e8487a'/><text x='40.4' y='39.1' font-weight='700'>Q₂</text><line x1='24' y1='270' x2='40.0' y2='270.3' stroke='#64748b' stroke-width='1.2'/><text x='42.6' y='274.5' fill='#64748b' font-size='10'>x</text><line x1='24' y1='270' x2='24.8' y2='263.5' stroke='#64748b' stroke-width='1.2'/><text x='22.1' y='265.2' fill='#64748b' font-size='10'>y</text><line x1='24' y1='270' x2='24.0' y2='255.4' stroke='#64748b' stroke-width='1.2'/><text x='21.0' y='254.3' fill='#64748b' font-size='10'>z</text><g transfor