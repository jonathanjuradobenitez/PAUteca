   },
   "dificultad": null,
   "etiquetas": [],
   "revision": "borrador"
  },
  {
   "id": "matematicas-2006-reserva-6-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "",
    "apartados": [
     "(0,75 p.) Haz un esbozo del recinto limitado por las curvas \\(y=\\dfrac{15}{1+x^2}\\) e \\(y=x^2-1\\).",
     "(1,75 p.) Calcula el área de dicho recinto."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'><p>Cortes: \\(\\frac{15}{1+x^2}=x^2-1\\iff15=x^4-1\\iff x^4=16\\iff x=\\pm2\\) (puntos \\((\\pm2,3)\\)). La primera tiene máximo \\((0,15)\\) y tiende a 0; la segunda es una parábola con vértice \\((0,-1)\\).</p><div style='overflow-x:auto'><svg viewBox='0 0 300 230' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='63.3,160.3 65.5,159.0 67.7,157.6 69.8,156.1 72.0,154.5 74.2,152.9 76.3,151.1 78.5,149.2 80.7,147.2 82.8,145.1 85.0,142.9 87.2,140.5 89.3,138.0 91.5,135.4 93.7,132.5 95.8,129.5 98.0,126.4 100.2,123.0 102.3,119.5 104.5,115.7 106.7,111.8 108.8,107.6 111.0,103.3 113.2,98.7 115.3,94.0 117.5,89.1 119.7,84.0 121.8,78.9 124.0,73.7 126.2,68.4 128.3,63.2 130.5,58.1 132.7,53.1 134.8,48.5 137.0,44.2 139.2,40.3 141.3,37.0 143.5,34.4 145.7,32.4 147.8,31.2 150.0,30.8 152.2,31.2 154.3,32.4 156.5,34.4 158.7,37.0 160.8,40.3 163.0,44.2 165.2,48.5 167.3,53.1 169.5,58.1 171.7,63.2 173.8,68.4 176.0,73.7 178.2,78.9 180.3,84.0 182.5,89.1 184.7,94.0 186.8,98.7 189.0,103.3 191.2,107.6 193.3,111.8 195.5,115.7 197.7,119.5 199.8,123.0 202.0,126.4 204.2,129.5 206.3,132.5 208.5,135.4 210.7,138.0 212.8,140.5 215.0,142.9 217.2,145.1 219.3,147.2 221.5,149.2 223.7,151.1 225.8,152.9 228.0,154.5 230.2,156.1 232.3,157.6 234.5,159.0 236.7,160.3 236.7,160.3 234.5,162.5 232.3,164.6 230.2,166.6 228.0,168.5 225.8,170.5 223.7,172.3 221.5,174.1 219.3,175.9 217.2,177.6 215.0,179.2 212.8,180.8 210.7,182.4 208.5,183.8 206.3,185.3 204.2,186.7 202.0,188.0 199.8,189.2 197.7,190.5 195.5,191.6 193.3,192.7 191.2,193.8 189.0,194.8 186.8,195.7 184.7,196.6 182.5,197.5 180.3,198.2 178.2,199.0 176.0,199.6 173.8,200.3 171.7,200.8 169.5,201.3 167.3,201.8 165.2,202.2 163.0,202.6 160.8,202.8 158.7,203.1 156.5,203.3 154.3,203.4 152.2,203.5 150.0,203.5 147.8,203.5 145.7,203.4 143.5,203.3 141.3,203.1 139.2,202.8 137.0,202.6 134.8,202.2 132.7,201.8 130.5,201.3 128.3,200.8 126.2,200.3 124.0,199.6 121.8,199.0 119.7,198.