+5+\\frac{x^2}4-4\\right)dx+\\int_2^3\\bigl(x+5-x^2+1\\bigr)dx\\]\\[=\\Bigl[\\frac{x^3}{12}+\\frac{x^2}2+x\\Bigr]_{-2}^2+\\Bigl[-\\frac{x^3}3+\\frac{x^2}2+6x\\Bigr]_2^3=\\frac{16}3+\\frac{13}6=\\frac{15}2\\]<div class='res'>Área \\(=\\dfrac{15}2\\ u^2\\)</div></div>"}],"clasificacion":[{"tema":"funciones","tipo":"tang","apartados":"a"},{"tema":"integ","tipo":"area","apartados":"b"}],"origen":{"documento":"MAT-2011-SEPTIEMBRE.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2011-septiembre-7","n":7,"num":3,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Sean las matrices \\(A=\\begin{pmatrix}\\alpha&1\\\\-\\alpha&3\\end{pmatrix}\\) y \\(B=\\begin{pmatrix}1&3&1\\\\-1&4&2\\end{pmatrix}\\).","apartados":["(1,25 p.) Calcula los valores de \\(\\alpha\\) para los que la matriz inversa de \\(A\\) es \\(\\frac1{12}A\\).","(1,25 p.) Para \\(\\alpha=-3\\), determina la matriz \\(X\\) que verifica la ecuación \\(A^tX=B\\), siendo \\(A^t\\) la matriz traspuesta de \\(A\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'>\\[|A|=3\\alpha+\\alpha=4\\alpha,\\qquad A^{-1}=\\frac1{4\\alpha}\\begin{pmatrix}3&-1\\\\\\alpha&\\alpha\\end{pmatrix}\\ (\\alpha\\neq0)\\]<p>Igualo término a término con \\(\\frac1{12}A=\\frac1{12}\\begin{pmatrix}\\alpha&1\\\\-\\alpha&3\\end{pmatrix}\\):</p>\\[\\frac3{4\\alpha}=\\frac\\alpha{12},\\quad\\frac{-1}{4\\alpha}=\\frac1{12},\\quad\\frac\\alpha{4\\alpha}=\\frac{-\\alpha}{12},\\quad\\frac\\alpha{4\\alpha}=\\frac3{12}\\]<p>La segunda da \\(\\alpha=-3\\), y con ella se cumplen todas (\\(\\alpha^2=9\\), \\(\\frac14=\\frac3{12}\\)).</p><div class='res'>\\(\\alpha=-3\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>Con \\(\\alpha=-3\\): \\(A^t=\\begin{pmatrix}-3 & 3\\\\1 & 3\\end{pmatrix}\\), \\(|A^t|=-12\\neq0\\). Multiplico por \\((A^t)^{-1}\\) por la izquierda: \\(X=(A^t)^{-1}B\\).</p>\\[(A^t)^{-1}=\\frac1{-12}\\begin{pmatrix}3&-3\\\\-1&-3\\end{pmatrix}=\\begin{pmatrix}- \\frac{1}{4} & \\frac{1}{4}\\\\\\frac{1}{12} & \\frac{1}{4}\\end{pmatrix}\\]\\[X=\\begin{pmatrix}- \\frac{1}{4} & \\frac{1}{4}\\\\\\frac{1}{12} & \\frac{1}{4}\\end{pmatrix}\\begin{pmatrix}1 & 3 & 1\\\\-1 & 4 & 2\\end{pmatrix}=\\begin{pmatrix}- \\frac{1}{2} & \\frac{1}{4} & \\frac{1}{4}\\\\- \\frac{1}{6} & \\frac{5}{4} & \\frac{7}{12}\\end{pmatrix}\\]<div class='res'>\\(X=\\begin{pmatrix}- \\frac{1}{2} & \\frac{1}{4} & \\frac{1}{4}\\\\- \\frac{1}{6} & \\frac{5}{4} & \\frac{7}{12}\\end{pmatrix}\\)</div></div>"}],"clasificacion":[{"tema":"matrices","tipo":"inv","apartados":"a, b"},{"tema":"matrices","tipo":"ecmat","apartados":"b"}],"origen":{"documento":"MAT-2011-SEPTIEMBRE.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2011-septiembre-8","n":8,"num":4,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Dados el plano \\(\\pi\\) de ecuación \\(x+2y-z=0\\) y la recta \\(r\\) de ecuaciones \\(\\begin{cases}3x-y=5\\\\x+y-4z=-13\\end{cases}\\)","apartados":["(0,75 p.) Halla el punto de intersección del plano \\(\\pi\\) y la recta \\(r\\).","(1,75 p.) Halla el punto simétrico del punto \\(Q(1,-2,3)\\) respecto del plano \\(\\pi\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>Paso \\(r\\) a paramétricas. Con \\(x=t\\): \\(y=3t-5\\) y \\(z=\\frac{x+y+13}4=t+2\\). Sustituyo en \\(\\pi\\):</p>\\[t+2(3t-5)-(t+2)=0\\iff6t-12=0\\iff t=2\\]<div class='res'>El punto de intersección es \\((2,1,4)\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p><b>Paso 1. Recta perpendicular al plano por el punto.</b> Como la recta \\(s\\) y el plano \\(\\pi\\) son perpendiculares, el vector normal del plano es paralelo al vector director de la recta<i class='n' data-t='why'>Si la recta es perpendicular al plano, su dirección es la del vector normal del plano: por eso sirve \\(\\vec n\\) como vector director.</i>: \\(\\vec d=\\vec n=(1,\\ 2,\\ -1)\\). Pasa por \\(Q(1,\\ -2,\\ 3)\\):</p>\\[s\\equiv\\begin{cases}x=1+t\\\\y=-2+2t\\\\z=3-t\\end{cases}\\]<p><b>Paso 2. Punto de corte.</b> Sustituyo las paramétricas de \\(s\\) en \\(\\pi\\equiv x+2y-z=0\\):</p>\\[(1+t)+2(-2+2t)-(3-t)=0\\iff 6t-6=0\\iff t=1\\]\\[M(2,\\ 0,\\ 2)\\]<p><b>Paso 3. Punto medio.</b> \\(M\\) es el punto medio entre \\(Q\\) y su simétrico \\(Q'(a,b,c)\\)<i class='n' data-t='th'>El simétrico \\(P'\\) cumple que \\(M\\) es el punto medio del segmento \\(PP'\\): cada coordenada de \\(M\\) es la media de las de \\(P\\) y \\(P'\\).</i>:</p>\\[\\frac{1+a}2=2,\\qquad\\frac{-2+b}2=0,\\qquad\\frac{3+c}2=2\\]\\[a=3,\\qquad b=2,\\qquad c=1\\]<div class='f3d' data-f='{\"az\":24,\"el\":27,\"p\":[[\"poly\",[[0.605,1.592,3.789],[4.11,-0.161,3.789],[3.395,-1.592,0.211],[-0.11,0.161,0.211]],\"#8b5cf6\",\"#7c3aed\"],[\"txt\",[3.395,-1.592,0.211],\"π\",\"#7c3aed\",4,0],[\"line\",[0.65,-2.7,3.35],[3.35,2.7,0.65],\"#2563eb\",2.2,false],[\"txt\",[3.35,2.7,0.65],\"s\",\"#2563eb\",6,0],[\"vec\",[0.7,-2.6,3.3],[1.19,-1.62,2.81],\"#16a34a\",\"d\",4,-4],[\"vec\",[3.315,-0.657,2.0],[3.804,0.323,1.51],\"#dc2626\",\"n\",4,-4],[\"line\",[1.78,-0.44,2.22],[2.262,-0.681,2.22],\"#475569\",1.3,false],[\"line\",[2.262,-0.681,2.22],[2.482,-0.241,2.0],\"#475569\",1.3,false],[\"pt\",[1.0,-2.0,3.0],\"Q\",7,-6],[\"pt\",[2.0,0.0,2.0],\"M\",8,12],[\"pt\",[3.0,2.0,1.0],\"Q′\",7,-6]],\"ley\":[\"plano\",\"recta\",\"vector normal\",\"vector director\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 409 300' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m11sb4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m11sb4d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='m11sb4g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#64748b