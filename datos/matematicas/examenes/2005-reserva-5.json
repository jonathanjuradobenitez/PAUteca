  {
   "id": "matematicas-2005-reserva-5-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sea \\(f:\\mathbb R\\to\\mathbb R\\) la función definida por \\(f(x)=x^2\\,\\mathrm{sen}(2x)\\). Calcula la primitiva de \\(f\\) cuya gráfica pasa por el punto \\((0,1)\\).",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>Por partes dos veces<i class='n' data-t='th'>Integración por partes: \\(\\int u\\,dv=uv-\\int v\\,du\\).</i>:</p>\\[u=x^2,\\ dv=\\mathrm{sen}\\,2x\\,dx:\\quad\\int x^2\\mathrm{sen}\\,2x\\,dx=-\\frac{x^2\\cos2x}2+\\int x\\cos2x\\,dx\\]\\[u=x,\\ dv=\\cos2x\\,dx:\\quad\\int x\\cos2x\\,dx=\\frac{x\\,\\mathrm{sen}\\,2x}2-\\int\\frac{\\mathrm{sen}\\,2x}2dx=\\frac{x\\,\\mathrm{sen}\\,2x}2+\\frac{\\cos2x}4\\]\\[F(x)=-\\frac{x^2\\cos2x}2+\\frac{x\\,\\mathrm{sen}\\,2x}2+\\frac{\\cos2x}4+C,\\qquad F(0)=\\frac14+C=1\\iff C=\\frac34\\]<div class='res'>\\(F(x)=-\\dfrac{x^2\\cos2x}2+\\dfrac{x\\,\\mathrm{sen}\\,2x}2+\\dfrac{\\cos2x}4+\\dfrac34\\)</div></div>"
    }
   ],
   "clasificacion": [
