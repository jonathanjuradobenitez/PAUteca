  {
   "id": "matematicas-2007-reserva-5-2",
   "n": 2,
   "num": 2,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sea \\(f:\\mathbb R\\to\\mathbb R\\) la función definida por \\(f(x)=\\begin{cases}1+\\alpha x&\\text{si }x\\lt0\\\\e^{-x}&\\text{si }x\\geq0\\end{cases}\\)",
    "apartados": [
     "(1 p.) Determina el valor de \\(\\alpha\\) sabiendo que \\(f\\) es derivable.",
     "(0,5 p.) Haz un esbozo de la gráfica de \\(f\\).",
     "(1 p.) Calcula \\(\\displaystyle\\int_{-1}^1f(x)\\,dx\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'><p>Cada trozo es derivable. En \\(x=0\\): continuidad, \\(\\displaystyle\\lim_{x\\to0^-}(1+\\alpha x)=1=e^0=f(0)\\) (se cumple para todo \\(\\alpha\\)). Derivadas laterales:</p>\\[f'(0^-)=\\alpha,\\qquad f'(0^+)=-e^{-x}\\big|_{x=0}=-1\\]<div class='res'>\\(\\alpha=-1\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>Para \\(x\\lt0\\) es la recta \\(y=1-x\\); para \\(x\\geq0\\), la exponencial decreciente \\(e^{-x}\\), que tiende a 0. Enlazan suavemente en \\((0,1)\\).</p><div style='overflow-x:auto'><svg viewBox='0 0 300 190' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='61.6,57.5 63.3,59.1 65.1,60.6 66.8,62.2 68.5,63.8 70.3,65.3 72.0,66.9 73.7,68.4 75.5,70.0 77.2,71.6 78.9,73.1 80.7,74.7 82.4,76.2 84.1,77.8 85.9,79.4 87.6,80.9 89.3,82.5 91.1,84.1 92.8,85.6 94.5,87.2 96.3,88.7 98.0,90.3 99.7,91.9 101.5,93.4 103.2,95.0 104.9,96.6 106.7,98.1 108.4,99.7 110.1,101.2 111.9,102.8 113.6,104.4 115.3,105.9 117.1,107.4 118.8,108.8 120.5,110.2 122.3,111.6 124.0,112.9 125.7,114.1 127.5,115.3 129.2,116.5 130.9,117.7 132.7,118.8 134.4,119.8 136.1,120.9 137.9,121.9 139.6,122.8 141.3,123.8 143.1,124.7 144.8,125.5 146.5,126.4 148.3,127.2 150.0,128.0 151.7,128.7 153.5,129.5 155.2,130.2 156.9,130.9 158.7,131.5 160.4,132.2 162.1,132.8 163.9,133.4 165.6,134.0 165.6,151.2 163.9,151.2 162.1,151.2 160.4,151.2 158.7,151.2 156.9,151.2 155.2,151.2 153.5,151.2 151.7,151.2 150.0,151.2 148.3,151.2 146.5,151.2 144.8,151.2 143.1,151.2 141.3,151.2 139.6,151.2 137.9,151.2 136.1,151.2 134.4,151.2 132.7,151.2 130.9,151.2 129.2,151.2 127.5,151.2 125.7,151.2 124.0,151.2 122.3,151.2 120.5,151.2 118.8,151.2 117.1,151.2 115.3,151.2 113.6,151.2 111.9,151.2 110.1,151.2 108.4,151.2 106.7,151.2 104.9,151.2 103.2,151.2 101.5,151.2 99.7,151.2 98.0,151.2 96.3,151.2 94.5,151.2 92.8,151.2 91.1,151.2 89.3,151.2 87.6,151.2 85.9,151.2 84.1,151.2 82.4,151.2 80.7,151.2 78.9,151.2 77.2,151.2 75.5,151.2 73.7,151.2 72.0,151.2 70.3,151.2 68.5,151.2 66.8,151.2 65.1,151.2 63.3,151.2 61.6,151.2' fill='#b9a4f5' fill-opacity='.55'/><polyline points='25.2,24.7 69.4,64.5 113.6,104.4' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='113.6,104.4 116.3,106.7 119.0,109.0 121.7,111.1 124.3,113.1 127.0,115.0 129.7,116.9 132.4,118.6 135.1,120.2 137.8,121.8 140.5,123.3 143.2,124.7 145.8,126.0 148.5,127.3 151.2,128.5 153.9,129.7 156.6,130.7 159.3,131.8 162.0,132.8 164.6,133.7 167.3,134.6 170.0,135.4 172.7,136.2 175.4,137.0 178.1,137.7 180.8,138.4 183.5,139.0 186.1,139.6 188.8,140.2 191.5,140.8 194.2,141.3 196.9,141.8 199.6,142.3 202.3,142.7 204.9,143.2 207.6,143.6 210.3,144.0 213.0,144.3 215.7,144.7 218.4,145.0 221.1,145.3 223.8,145.6 226.4,145.9 229.1,146.2 231.8,146.4 234.5,146.7 237.2,146.9 239.9,147.1 242.6,147.3 245.2,147.5 247.9,147.7 250.6,147.9 253.3,148.1 256.0,148.2 258.7,148.4 261.4,148.5 264.1,148.7 266.7,148.8 269.4,148.9 272.1,149.0 274.8,149.1' fill='none' stroke='#2f6df0' stroke-width='2'/><line x1='61.6' y1='151.2' x2='61.6' y2='57.5' stroke='#94a3b8' stroke-width='1.4' stroke-dasharray='5 4'/><line x1='165.6' y1='151.2' x2='165.6' y2='134.0' stroke='#94a3b8' stroke-width='1.4' stroke-dasharray='5 4'/><circle cx='113.6' cy='104.4' r='3.5' fill='#e8487a'/><text x='119.6' y='98.4'>(0,1)</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 151.2H294.0M113.6 184.0V8.0'/></g><line x1='61.6' y1='148.2' x2='61.6' y2='154.2' stroke='currentColor'/><text x='58.6' y='165.2' font-size='10'>-1</text><line x1='165.6' y1='148.2' x2='165.6' y2='154.2' stroke='currentColor'/><text x='162.6' y='165.2' font-size='10'>1</text><line x1='217.6' y1='148.2' x2='217.6' y2='154.2' stroke='currentColor'/><text x='214.6' y='165.2' font-size='10'>2</text><line x1='110.6' y1='104.4' x2='116.6' y2='104.4' stroke='currentColor'/><text x='97.6' y='108.4' font-size='10'>1</text><line x1='110.6' y1='57.5' x2='116.6' y2='57.5' stroke='currentColor'/><text x='97.6' y='61.5' font-size='10'>2</text></svg></div></div>"
    },
    {
     "titulo": "Apartado c",
     "html": "<div class='ex'>\\[\\int_{-1}^1f(x)\\,dx=\\int_{-1}^0(1-x)\\,dx+\\int_0^1e^{-x}\\,dx=\\Bigl[x-\\frac{x^2}2\\Bigr]_{-1}^0+\\Bigl[-e^{-x}\\Bigr]_0^1=\\frac32+1-\\frac1e\\]<div class='res'>\\(\\displaystyle\\int_{-1}^1f(x)\\,dx=\\frac52-\\frac1e\\approx2{,}132\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "funciones",
     "tipo": "cont",
     "apartados": "a"
    },
    {
     "tema": "funciones",
