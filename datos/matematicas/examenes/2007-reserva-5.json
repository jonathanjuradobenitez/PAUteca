  {
   "id": "matematicas-2007-reserva-5-5",
   "n": 5,
   "num": 1,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sea \\(f\\) la función definida, para \\(x\\neq2\\) y \\(x\\neq-2\\), por \\(f(x)=\\dfrac{x^2+3}{x^2-4}\\).",
    "apartados": [
     "(1 p.) Determina las asíntotas de la gráfica de \\(f\\).",
     "(1 p.) Determina los intervalos de crecimiento y de decrecimiento y los extremos relativos de \\(f\\) (puntos donde se obtienen y valores que se alcanzan).",
     "(0,5 p.) Esboza la gráfica de \\(f\\)."
    ]
