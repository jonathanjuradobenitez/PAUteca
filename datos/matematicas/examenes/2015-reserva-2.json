  {
   "id": "matematicas-2015-reserva-2-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sean \\(f:[0,\\infty)\\to\\mathbb R\\) y \\(g:\\mathbb R\\to\\mathbb R\\) las funciones definidas por \\(f(x)=\\sqrt{2x}\\) y \\(g(x)=\\frac12x^2\\).",
    "apartados": [
     "(0,75 p.) Halla los puntos de corte de las gráficas de \\(f\\) y \\(g\\). Haz un esbozo del recinto que limitan.",
     "(1,75 p.) Calcula el área de dicho recinto."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[\\sqrt{2x}=\\frac{x^2}2\\Rightarrow2x=\\frac{x^4}4\\iff x^4-8x=0\\iff x(x^3-8)=0\\iff x=0\\ \\text{ o }\\ x=2\\]<p>Las dos valen (al elevar al cuadrado hay que comprobar: \\(\\sqrt4=2=\\frac42\\) ✓). \\(f\\) es media parábola «tumbada» y \\(g\\) una parábola con vértice en el origen:</p><div style='overflow-x:auto'><svg viewBox='0 0 300 220' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='55.1,181.1 57.5,168.8 59.8,163.8 62.2,159.9 64.5,156.6 66.8,153.7 69.2,151.1 71.5,148.7 73.9,146.5 76.2,144.4 78.6,142.4 80.9,140.5 83.2,138.7 85.6,137.0 87.9,135.3 90.3,133.7 92.6,132.1 95.0,130.6 97.3,129.2 99.6,127.7 102.0,126.4 104.3,125.0 106.7,123.7 109.0,122.4 111.4,121.1 113.7,119.9 116.0,118.7 118.4,117.5 120.7,116.3 123.1,115.2 125.4,114.1 127.7,113.0 130.1,111.9 132.4,110.8 134.8,109.7 137.1,108.7 139.5,107.7 141.8,106.7 144.1,105.7 146.5,104.7 148.8,103.7 151.2,102.7 153.5,101.8 155.9,100.9 158.2,99.9 160.5,99.0 162.9,98.1 165.2,97.2 167.6,96.3 169.9,95.4 172.3,94.6 174.6,93.7 176.9,92.9 179.3,92.0 181.6,91.2 184.0,90.3 186.3,89.5 188.6,88.7 191.0,87.9 193.3,87.1 195.7,86.3 195.7,86.3 193.3,89.4 191.0,92.5 188.6,95.6 186.3,98.5 184.0,101.4 181.6,104.3 179.3,107.1 176.9,109.9 174.6,112.6 172.3,115.3 169.9,117.9 167.6,120.4 165.2,122.9 162.9,125.4 160.5,127.8 158.2,130.1 155.9,132.4 153.5,134.6 151.2,136.8 148.8,138.9 146.5,141.0 144.1,143.1 141.8,145.0 139.5,146.9 137.1,148.8 134.8,150.6 132.4,152.4 130.1,154.1 127.7,155.8 125.4,157.4 123.1,158.9 120.7,160.4 118.4,161.9 116.0,163.3 113.7,164.6 111.4,165.9 109.0,167.1 106.7,168.3 104.3,169.4 102.0,170.5 99.6,171.6 97.3,172.5 95.0,173.4 92.6,174.3 90.3,175.1 87.9,175.9 85.6,176.6 83.2,177.3 80.9,177.9 78.6,178.4 76.2,178.9 73.9,179.4 71.5,179.8 69.2,180.1 66.8,180.4 64.5,180.6 62.2,180.8 59.8,180.9 57.5,181.0 55.1,181.1' fill='#b9a4f5' fill-opacity='.55'/><polyline points='55.1,181.1 57.9,167.7 60.8,162.1 63.6,157.8 66.4,154.3 69.2,151.1 72.0,148.2 74.8,145.6 77.6,143.2 80.4,140.9 83.2,138.7 86.1,136.6 88.9,134.6 91.7,132.7 94.5,130.9 97.3,129.2 100.1,127.5 102.9,125.8 105.7,124.2 108.5,122.7 111.4,121.1 114.2,119.7 117.0,118.2 119.8,116.8 122.6,115.4 125.4,114.1 128.2,112.7 131.0,111.4 133.8,110.2 136.6,108.9 139.5,107.7 142.3,106.5 145.1,105.3 147.9,104.1 150.7,102.9 153.5,101.8 156.3,100.7 159.1,99.6 161.9,98.5 164.8,97.4 167.6,96.3 170.4,95.3 173.2,94.2 176.0,93.2 178.8,92.2 181.6,91.2 184.4,90.2 187.2,89.2 190.1,88.2 192.9,87.3 195.7,86.3 198.5,85.4 201.3,84.4 204.1,83.5 206.9,82.6 209.7,81.7 212.5,80.8 215.4,79.9 218.2,79.0 221.0,78.1 223.8,77.3 226.6,76.4 229.4,75.6 232.2,74.7 235.0,73.9 237.8,73.0 240.6,72.2 243.5,71.4 246.3,70.6 249.1,69.8 251.9,69.0 254.7,68.2 257.5,67.4 260.3,66.6 263.1,65.8 265.9,65.0 268.8,64.3 271.6,63.5 274.4,62.7 277.2,62.0 280.0,61.2' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='20.0,175.1 23.6,176.3 27.1,177.3 30.7,178.2 34.3,179.0 37.9,179.6 41.4,180.2 45.0,180.6 48.6,180.8 52.1,181.0 55.7,181.1 59.3,181.0 62.9,180.8 66.4,180.4 70.0,180.0 73.6,179.4 77.2,178.7 80.7,177.9 84.3,177.0 87.9,175.9 91.4,174.7 95.0,173.4 98.6,172.0 102.2,170.4 105.7,168.8 109.3,167.0 112.9,165.1 116.4,163.0 120.0,160.9 123.6,158.6 127.2,156.2 130.7,153.6 134.3,151.0 137.9,148.2 141.5,145.3 145.0,142.3 148.6,139.2 152.2,135.9 155.7,132.5 159.3,129.0 162.9,125.4 166.5,121.6 170.0,117.7 173.6,113.7 177.2,109.6 180.7,105.4 184.3,101.0 187.9,96.5 191.5,91.9 195.0,87.2 198.6,82.3 202.2,77.3 205.7,72.3 209.3,67.0 212.9,61.7 216.5,56.2 220.0,50.6 223.6,44.9 227.2,39.1 230.8,33.1 234.3,27.0' fill='none' stroke='#f0a30a' stroke-width='2'/><circle cx='195.7' cy='86.3' r='3.5' fill='#e8487a'/><text x='201.7' y='96.3'>(2,2)</text><circle cx='55.1' cy='181.1' r='3.5' fill='#e8487a'/><text x='55.1' y='181.1'></text><text x='230.8' y='60.3' fill='#2f6df0' font-size='12'>f</text><text x='202.7' y='38.9' fill='#f0a30a' font-size='12'>g</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 181.1H294.0M55.1 214.0V8.0'/></g><line x1='125.4' y1='178.1' x2='125.4' y2='184.1' stroke='currentColor'/><text x='122.4' y='195.1' font-size='10'>1</text><line x1='195.7' y1='178.1' x2='195.7' y2='184.1' stroke='currentColor'/><text x='192.7' y='195.1' font-size='10'>2</text><line x1='265.9' y1='178.1' x2='265.9' y2='184.1' stroke='currentColor'/><text x='262.9' y='195.1' font-size='10'>3</text><line x1='52.1' y1='133.7' x2='58.1' y2='133.7' stroke='currentColor'/><text x='39.1' y='137.7' font-size='10'>1</text><line x1='52.1' y1='86.3' x2='58.1' y2='86.3' stroke='currentColor'/><text x='39.1' y='90.3' font-size='10'>2</text><line x1='52.1' y1='38.9' x2='58.1' y2='38.9' stroke='currentColor'/><text x='39.1' y='42.9' font-size='10'>3</text></svg></div><div class='res'>Se cortan en \\((0,0)\\) y \\((2,2)\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>En \\((0,2)\\) la gráfica de \\(f\\) queda por encima (en \\(x=1\\): \\(\\sqrt2\\gt\\frac12\\)):</p>\\[A=\\int_0^2\\left(\\sqrt2\\,x^{1/2}-\\frac{x^2}2\\right)dx=\\Bigl[\\sqrt2\\cdot\\frac23x^{3/2}-\\frac{x^3}6\\Bigr]_0^2=\\sqrt2\\cdot\\frac23\\cdot2\\sqrt2-\\frac86=\\frac83-\\frac43=\\frac43\\]<div class='res'>Área \\(=\\dfrac43\\ u^2\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "integ",
     "tipo": "area",
     "apartados": "a, b"
    }
