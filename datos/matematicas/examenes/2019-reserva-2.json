7.0,56.8 180.0,53.2 183.0,50.0 186.0,47.0 189.0,44.3 192.0,42.0 195.0,40.0 198.0,38.3 201.1,37.0 204.1,36.1 207.1,35.5 210.1,35.3 213.1,35.5 216.1,36.1 219.1,37.0 222.1,38.3 225.1,40.0 228.1,42.0 231.1,44.3 234.1,47.0 237.1,50.0 240.1,53.2 243.1,56.8 246.1,60.5 249.1,64.5 252.1,68.7 255.1,73.1 258.1,77.6 261.1,82.2 264.1,87.0 267.1,91.7 270.1,96.5' fill='none' stroke='#e8487a' stroke-width='2'/><circle cx='180.0' cy='53.2' r='3.5' fill='#e8487a'/><text x='186.0' y='47.2'>(π/4, √2/2)</text><circle cx='59.9' cy='139.8' r='3.5' fill='#e8487a'/><text x='-0.1' y='155.8'>(−3π/4, −√2/2)</text><text x='111.8' y='28.0' fill='#2f6df0' font-size='10'>cos x</text><text x='222.6' y='28.0' fill='#e8487a' font-size='10'>sen x</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 96.5H294.0M150.0 184.0V8.0'/></g><line x1='35.3' y1='93.5' x2='35.3' y2='99.5' stroke='currentColor'/><text x='32.3' y='110.5' font-size='10'>-3</text><line x1='73.5' y1='93.5' x2='73.5' y2='99.5' stroke='currentColor'/><text x='70.5' y='110.5' font-size='10'>-2</text><line x1='111.8' y1='93.5' x2='111.8' y2='99.5' stroke='currentColor'/><text x='108.8' y='110.5' font-size='10'>-1</text><line x1='188.2' y1='93.5' x2='188.2' y2='99.5' stroke='currentColor'/><text x='185.2' y='110.5' font-size='10'>1</text><line x1='226.5' y1='93.5' x2='226.5' y2='99.5' stroke='currentColor'/><text x='223.5' y='110.5' font-size='10'>2</text><line x1='264.7' y1='93.5' x2='264.7' y2='99.5' stroke='currentColor'/><text x='261.7' y='110.5' font-size='10'>3</text><line x1='147.0' y1='157.8' x2='153.0' y2='157.8' stroke='currentColor'/><text x='134.0' y='161.8' font-size='10'>-1</text><line x1='147.0' y1='35.3' x2='153.0' y2='35.3' stroke='currentColor'/><text x='134.0' y='39.3' font-size='10'>1</text></svg></div><div class='res'>Se cortan en \\(\\left(\\dfrac\\pi4,\\dfrac{\\sqrt2}2\\right)\\) y \\(\\left(-\\dfrac{3\\pi}4,-\\dfrac{\\sqrt2}2\\right)\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>En \\(\\left[-\\frac{3\\pi}4,\\frac\\pi4\\right]\\) el coseno va por encima (en \\(x=0\\): \\(1\\gt0\\)):</p>\\[A=\\int_{-3\\pi/4}^{\\pi/4}(\\cos x-\\mathrm{sen}\\,x)\\,dx=\\Bigl[\\mathrm{sen}\\,x+\\cos x\\Bigr]_{-3\\pi/4}^{\\pi/4}=\\left(\\frac{\\sqrt2}2+\\frac{\\sqrt2}2\\right)-\\left(-\\frac{\\sqrt2}2-\\frac{\\sqrt2}2\\right)=2\\sqrt2\\]<div class='res'>Área \\(=2\\sqrt2\\approx2{,}828\\ u^2\\)</div></div>"}],"clasificacion":[{"tema":"integ","tipo":"area","apartados":"a, b"}],"origen":{"documento":"MAT-2019-RESERVA_2.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2019-reserva-2-7","n":7,"num":3,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Dadas las matrices \\(A=\\begin{pmatrix}a&1&1\\\\1&a&1\\\\1&1&a\\end{pmatrix}\\) y \\(X=\\begin{pmatrix}x\\\\y\\\\z\\end{pmatrix}\\).","apartados":["(1,5 p.) Encuentra los valores de \\(a\\) para los que el sistema dado por \\(AX=2X\\) tiene infinitas soluciones.","(1 p.) Para \\(a=0\\), si es posible, resuelve \\(AX=2X\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>\\(AX=2X\\iff(A-2I)X=0\\): sistema homogéneo, siempre compatible. Tiene infinitas soluciones si y solo si \\(|A-2I|=0\\)<i class='n' data-t='th'>Rouché-Frobenius: en un sistema homogéneo \\(\\operatorname{rg}A=\\operatorname{rg}A^*\\); hay infinitas soluciones si ese rango es menor que 3.</i>. Por la regla de Sarrus<i class='n' data-t='th'>Regla de Sarrus: se suman los productos de la diagonal principal y de los dos triángulos con un lado paralelo a ella (en verde) y se restan los de la diagonal secundaria y sus dos triángulos (en rojo).<span style='display:block;margin:6px 0 0'><svg viewBox='0 0 206 106' width='100%' style='max-width:230px' font-family='system-ui,sans-serif'><text x='0' y='30' font-size='20' font-weight='700' fill='#17a673'>+</text><text x='0' y='86' font-size='20' font-weight='700' fill='#e8487a'>−</text><polygon points='26,10 41,25 56,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='10' r='3.6' fill='#17a673'/><circle cx='41' cy='10' r='2.2' fill='#9ca3af'/><circle cx='56' cy='10' r='2.2' fill='#9ca3af'/><circle cx='26' cy='25' r='2.2' fill='#9ca3af'/><circle cx='41' cy='25' r='3.6' fill='#17a673'/><circle cx='56' cy='25' r='2.2' fill='#9ca3af'/><circle cx='26' cy='40' r='2.2' fill='#9ca3af'/><circle cx='41' cy='40' r='2.2' fill='#9ca3af'/><circle cx='56' cy='40' r='3.6' fill='#17a673'/><polygon points='103,10 118,25 88,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='10' r='2.2' fill='#9ca3af'/><circle cx='103' cy='10' r='3.6' fill='#17a673'/><circle cx='118' cy='10' r='2.2' fill='#9ca3af'/><circle cx='88' cy='25' r='2.2' fill='#9ca3af'/><circle cx='103' cy='25' r='2.2' fill='#9ca3af'/><circle cx='118' cy='25' r='3.6' fill='#17a673'/><circle cx='88' cy='40' r='3.6' fill='#17a673'/><circle cx='103' cy='40' r='2.2' fill='#9ca3af'/><circle cx='118' cy='40' r='2.2' fill='#9ca3af'/><polygon points='180,10 150,25 165,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='10' r='2.2' fill='#9ca3af'/><circle cx='165' cy='10' r='2.2' fill='#9ca3af'/><circle cx='180' cy='10' r='3.6' fill='#17a673'/><circle cx='150' cy='25' r='3.6' fill='#17a673'/><circle cx='165' cy='25' r='2.2' fill='#9ca3af'/><circle cx='180' cy='25' r='2.2' fill='#9ca3af'/><circle cx='150' cy='40' r='2.2' fill='#9ca3af'/><circle cx='165' cy='40' r='3.6' fill='#17a673'/><circle cx='180' cy='40' r='2.2' fill='#9ca3af'/><polygon points='56,66 41,81 26,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='66' r='2.2' fill='#9ca3af'/><circle cx='41' cy='66' r='2.2' fill='#9ca3af'/><circle cx='56' cy='66' r='3.6' fill='#e8487a'/><circle cx='26' cy='81' r='2.2' fill='#9ca3af'/><circle cx='41' cy='81' r='3.6' fill='#e8487a'/><circle cx='56' cy='81' r='2.2' fill='#9ca3af'/><circle cx='26' cy='96' r='3.6' fill='#e8487a'/><circle cx='41' cy='96' r='2.2' fill='#9ca3af'/><circle cx='56' cy='96' r='2.2' fill='#9ca3af'/><polygon points='88,66 118,81 103,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='66' r='3.6' fill='#e8487a'/><circle cx='103' cy='66' r='2.2' fill='#9ca3af'/><circle cx='118' cy='66' r='2.2' fill='#9ca3af'/><circle cx='88' cy='81' r='2.2' fill='#9ca3af'/><circle cx='103' cy='81' r='2.2' fill='#9ca3af'/><circle cx='118' cy='81' r='3.6' fill='#e8487a'/><circle cx='88' cy='96' r='2.2' fill='#9ca3af'/><circle cx='103' cy='96' r='3.6' fill='#e8487a'/><circle cx='118' cy='96' r='2.2' fill='#9ca3af'/><polygon points='165,66 150,81 180,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='66' r='2.2' fill='#9ca3af'/><circle cx='165' cy='66' r='3.6' fill='#e8487a'/><circle cx='180' cy='66' r='2.2' fill='#9ca3af'/><circle cx='150' cy='81' r='3.6' fill='#e8487a'/><circle cx='165' cy='81' r='2.2' fill='#9ca3af'/><circle cx='180' cy='81' r='2.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i>:</p>\\[A-2I=\\begin{pmatrix}a-2&1&1\\\\1&a-2&1\\\\1&1&a-2\\end{pmatrix}\\]\\[|A-2I|=\\begin{vmatrix}a-2&1&1\\\\1&a-2&1\\\\1&1&a-2\\end{vmatrix}\\]\\[=\\bigl(a^{3} - 6 a^{2} + 12 a - 8+1+1\\bigr)-\\bigl(a - 2+a - 2+a - 2\\bigr)\\]\\[=(a-2)^3-3(a-2)+2=(a-3)^2\\,a\\]<p>(Con \\(b=a-2\\), \\(b^3-3b+2=(b-1)^2(b+2)\\).)</p><div class='res'>Tiene infinitas soluciones para \\(a=3\\) y para \\(a=0\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>Con \\(a=0\\):</p>\\[\\begin{cases}-2x+y+z=0\\\\x-2y+z=0\\\\x+y-2z=0\\end{cases}\\]<p>El menor \\(\\begin{vmatrix}-2&1\\\\1&-2\\end{vmatrix}=3\\neq0\\): las dos primeras ecuaciones son independientes y la tercera depende de ellas (es la suma de las dos cambiada de signo). La elimino y tomo \\(z=t\\): </p><p>Doy a la incógnita \\(z\\) el valor \\(z=t\\) y lo paso al segundo miembro<i class='n' data-t='why'>La incógnita que no está en el menor no nulo pasa al segundo miembro como parámetro; así queda un sistema con tantas ecuaciones como incógnitas y determinante distinto de 0, que se resuelve por Cramer.</i>:</p>\\[\\begin{cases}-2x+y=- t\\\\x-2y=- t\\end{cases}\\]<p>Lo resuelvo por la regla de Cramer<i class='n' data-t='th'>Regla de Cramer: si \\(|A|\\neq0\\), cada incógnita es el cociente entre el determinante que resulta de sustituir su columna por la de los términos independientes y el determinante \\(|A|\\) de la matriz de coeficientes.</i>:</p>\\[|A|=\\begin{vmatrix}-2&1\\\\1&-2\\end{vmatrix}=3\\]\\[x=\\frac{\\begin{vmatrix}- t&1\\\\- t&-2\\end{vmatrix}}{3}=\\frac{3 t}{3}=t\\]\\[y=\\frac{\\begin{vmatrix}-2&- t\\\\1&- t\\end{vmatrix}}{3}=\\frac{3 t}{3}=t\\]<div class='res'>\\(x=y=z=t\\), con \\(t\\in\\mathbb R\\)</div></div>"}],"clasificacion":[{"tema":"sistemas","tipo":"disc","apartados":"a"},{"tema":"sistemas","tipo":"res","apartados":"b"}],"origen":{"documento":"MAT-2019-RESERVA_2.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2019-reserva-2-8","n":8,"num":4,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Considera el punto \\(P(-5,3,1)\\) y la recta \\(r\\equiv\\dfrac x2=\\dfrac{y-3}2=\\dfrac{z-2}{-1}\\).","apartados":["(1 p.) Calcula la ecuación general del plano que pasa por \\(P\\) y contiene a \\(r\\).","(1,5 p.) Calcula la ecuación de la recta que pasa por \\(P\\) y corta perpendicularmente a \\(r\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>\\(r\\) pasa por \\(R(0,3,2)\\) con \\(\\vec d=(2,2,-1)\\). El plano contiene a \\(\\vec d\\) y a \\(\\overrightarrow{RP}=(-5,0,-1)\\); su vector normal es perpendicular a ambos:</p>\\[\\vec n=\\vec d\\times\\overrightarrow{RP}=\\begin{vmatrix}\\vec i&\\vec j&\\vec k\\\\2&2&-1\\\\-5&0&-1\\end{vmatrix}=(-2,\\,7,\\,10)\\]<p>El plano es de la forma \\(-2x+7y+10z+D=0\\) y como contiene a \\(R(0,3,2)\\): \\(21+20+D=0\\iff D=-41\\).</p><div class='res'>\\(\\pi\\equiv-2x+7y+10z-41=0\\) (o \\(2x-7y-10z+41=0\\))</div><i class='n' data-t='tp'>Comprobación: \\(P(-5,3,1)\\): \\(10+21+10-41=0\\) ✓.</i></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>La recta pedida pasa por \\(P\\) y por su proyección ortogonal \\(M\\) sobre \\(r\\).</p><p><b>Paso 1. Plano perpendicular a </b>\\(r\\)<b> por </b>\\(P\\)<b>.</b> Como el plano y la recta son perpendiculares, el vector director de \\(r\\) es paralelo al vector normal del plano: \\(2x+2y-z+D=0\\), y como contiene a \\(P(-5,3,1)\\): \\(-10+6-1+D=0\\iff D=5\\).</p><p><b>Paso 2. Punto de corte con </b>\\(r\\equiv(2t,\\,3+2t,\\,2-t)\\)<b>:</b></p>\\[4t+2(3+2t)-(2-t)+5=0\\iff9t+9=0\\iff t=-1\\Rightarrow M(-2,\\,1,\\,3)\\]<p><b>Paso 3.</b> \\(\\overrightarrow{PM}=(3,-2,2)\\):</p><div class='f3d' data-f='{\"az\":102,\"el\":52,\"p\":[[\"poly\",[[-4.615,-0.168,3.294],[3.822,2.243,3.294],[2.77,5.926,0.506],[-5.667,3.515,0.506]],\"#8b5cf6\",\"#7c3aed\"],[\"txt\",[2.77,5.926,0.506],\"π\",\"#7c3aed\",4,0],[\"line\",[-4.0,-1.0,4.0],[2.4,5.4,0.8],\"#2563eb\",2.2,false],[\"txt\",[2.4,5.4,0.8],\"r\",\"#2563eb\",6,0],[\"vec\",[0,3,2],[0.667,3.667,1.667],\"#16a34a\",\"d\",4,-4],[\"line\",[-5.6,3.4,0.6],[-1.1,0.4,3.6],\"#2563eb\",2.2,false],[\"txt\",[-1.1,0.4,3.6],\"s\",\"#2563eb\",6,0],[\"line\",[-1.733,1.267,2.867],[-2.024,1.461,2.673],\"#475569\",1.3,false],[\"line\",[-2.024,1.461,2.673],[-2.291,1.194,2.806],\"#475569\",1.3,false],[\"pt\",[-5,3,1],\"P\",7,-6],[\"pt\",[0,3,2],\"R\",7,-6],[\"pt\",[-2,1,3],\"M\",8,12]],\"ley\":[\"plano\",\"recta\",\"vector director\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 275' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m19r2b4n