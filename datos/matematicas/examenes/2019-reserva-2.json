='24' y1='245' x2='20.7' y2='257.3' stroke='#64748b' stroke-width='1.2'/><text x='16.5' y='265.6' fill='#64748b' font-size='10'>y</text><line x1='24' y1='245' x2='24.0' y2='235.1' stroke='#64748b' stroke-width='1.2'/><text x='21.0' y='235.7' fill='#64748b' font-size='10'>z</text><g transform='translate(56.0,267)'><rect x='0' y='-8' width='12' height='9' fill='#8b5cf6' fill-opacity='.4' stroke='#7c3aed'/><text x='18' y='0' font-size='10'>plano</text></g><g transform='translate(106.5,267)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#2563eb' stroke-width='2'/><text x='18' y='0' font-size='10'>recta</text></g><g transform='translate(157.0,267)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#16a34a' stroke-width='2.4'/><text x='18' y='0' font-size='10'>vector director</text></g><g transform='translate(260.5,267)'><circle cx='6' cy='-4' r='3.8' fill='#e8487a'/><text x='18' y='0' font-size='10'>puntos</text></g></svg><p class='mut' style='font-size:.8rem;margin:.2rem 0;text-align:center'>Figura interactiva: arrástrala para girarla en 3D.</p></div><div class='res'>\\(s\\equiv\\begin{cases}x=-5+3\\lambda\\\\y=3-2\\lambda\\\\z=1+2\\lambda\\end{cases}\\)</div><i class='n' data-t='tp'>Comprobación: \\((3,-2,2)\\cdot(2,2,-1)=6-4-2=0\\) ✓.</i></div>"}],"clasificacion":[{"tema":"geom","tipo":"ecs","apartados":"a"},{"tema":"geom","tipo":"perp","apartados":"b"}],"origen":{"documento":"MAT-2019-RESERVA_2.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"}]}