  {
   "id": "matematicas-2005-reserva-1-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Considera la función \\(f:\\mathbb R\\to\\mathbb R\\) definida por \\(f(x)=e^{-x/2}\\).",
    "apartados": [
     "(0,75 p.) Halla la ecuación de la recta tangente a la gráfica de \\(f\\) en el punto de abscisa \\(x=0\\).",
     "(1,75 p.) Calcula el área de la región acotada que está limitada por la gráfica de \\(f\\), la recta de ecuación \\(x=2\\) y la recta tangente obtenida en (a)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[f(0)=1,\\qquad f'(x)=-\\frac12e^{-x/2}\\Rightarrow f'(0)=-\\frac12\\]<div class='res'>\\(y=1-\\dfrac x2\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>\\(f''(x)=\\frac14e^{-x/2}\\gt0\\): \\(f\\) es convexa y queda por encima de su tangente. El recinto va de \\(x=0\\) (tangencia) a \\(x=2\\):</p><div style='overflow-x:auto'><svg viewBox='0 0 300 180' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='63.3,49.5 66.9,51.3 70.6,53.1 74.2,54.8 77.8,56.5 81.4,58.1 85.0,59.7 88.6,61.3 92.2,62.8 95.8,64.3 99.4,65.8 103.1,67.2 106.7,68.6 110.3,69.9 113.9,71.2 117.5,72.5 121.1,73.8 124.7,75.0 128.3,76.2 131.9,77.3 135.6,78.5 139.2,79.6 142.8,80.6 146.4,81.7 150.0,82.7 153.6,83.7 157.2,84.7 160.8,85.6 164.4,86.6 168.1,87.5 171.7,88.4 175.3,89.2 178.9,90.0 182.5,90.9 186.1,91.7 189.7,92.4 193.3,93.2 196.9,93.9 200.6,94.7 204.2,95.4 207.8,96.1 207.8,123.2 204.2,121.3 200.6,119.5 196.9,117.6 193.3,115.8 189.7,113.9 186.1,112.1 182.5,110.3 178.9,108.4 175.3,106.6 171.7,104.7 168.1,102.9 164.4,101.1 160.8,99.2 157.2,97.4 153.6,95.5 150.0,93.7 146.4,91.8 142.8,90.0 139.2,88.2 135.6,86.3 131.9,84.5 128.3,82.6 124.7,80.8 121.1,78.9 117.5,77.1 113.9,75.3 110.3,73.4 106.7,71.6 103.1,69.7 99.4,67.9 95.8,66.1 92.2,64.2 88.6,62.4 85.0,60.5 81.4,58.7 77.8,56.8 74.2,55.0 70.6,53.2 66.9,51.3 63.3,49.5' fill='#b9a4f5' fill-opacity='.55'/><polyline points='27.2,28.5 31.4,31.3 35.6,33.9 39.9,36.5 44.1,39.0 48.3,41.4 52.5,43.7 56.7,46.0 60.9,48.2 65.1,50.4 69.4,52.5 73.6,54.5 77.8,56.5 82.0,58.4 86.2,60.3 90.4,62.1 94.6,63.8 98.8,65.5 103.1,67.2 107.3,68.8 111.5,70.4 115.7,71.9 119.9,73.4 124.1,74.8 128.3,76.2 132.5,77.5 136.8,78.8 141.0,80.1 145.2,81.3 149.4,82.6 153.6,83.7 157.8,84.9 162.0,86.0 166.2,87.0 170.5,88.1 174.7,89.1 178.9,90.0 183.1,91.0 187.3,91.9 191.5,92.8 195.7,93.7 200.0,94.5 204.2,95.4 208.4,96.2 212.6,96.9 216.8,97.7 221.0,98.4 225.2,99.1 229.4,99.8 233.7,100.5 237.9,101.1 242.1,101.8 246.3,102.4 250.5,103.0 254.7,103.6 258.9,104.1 263.1,104.7 267.4,105.2 271.6,105.7 275.8,106.2 280.0,106.7' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='27.2,31.1 146.4,91.8 265.6,152.6' fill='none' stroke='#f0a30a' stroke-width='2'/><line x1='207.8' y1='160.0' x2='207.8' y2='20.0' stroke='#94a3b8' stroke-width='1.4' stroke-dasharray='5 4'/><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 123.2H294.0M63.3 174.0V8.0'/></g><line x1='135.6' y1='120.2' x2='135.6' y2='126.2' stroke='currentColor'/><text x='132.6' y='137.2' font-size='10'>1</text><line x1='207.8' y1='120.2' x2='207.8' y2='126.2' stroke='currentColor'/><text x='204.8' y='137.2' font-size='10'>2</text><line x1='60.3' y1='49.5' x2='66.3' y2='49.5' stroke='currentColor'/><text x='47.3' y='53.5' font-size='10'>1</text></svg></div>\\[A=\\int_0^2\\left(e^{-x/2}-1+\\frac x2\\right)dx=\\Bigl[-2e^{-x/2}-x+\\frac{x^2}4\\Bigr]_0^2=\\left(-\\frac2e-2+1\\right)-(-2)=1-\\frac2e\\]<div class='res'>Área \\(=1-\\dfrac2e\\approx0{,}264\\ u^2\\)</div></div>"
