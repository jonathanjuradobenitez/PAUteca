4 73.8,88.8 76.0,88.3 78.3,87.7 80.5,87.1 82.8,86.5 85.0,86.0 87.2,85.4 89.5,84.8 91.7,84.2 94.0,83.6 96.2,83.0 98.4,82.4 100.7,81.8 102.9,81.2 105.2,80.6 107.4,80.0 109.6,79.4 111.9,78.8 114.1,78.3 116.4,77.7 118.6,77.2 120.9,76.7 123.1,76.2 125.3,75.8 127.6,75.3 129.8,74.9 132.1,74.5 134.3,74.2 136.5,73.9 138.8,73.7 141.0,73.5 143.3,73.3 145.5,73.2 147.7,73.2 150.0,73.2 152.2,73.3 154.5,73.4 156.7,73.6 158.9,74.0 161.2,74.3 163.4,74.8 165.7,75.4 167.9,76.0 170.2,76.8 172.4,77.6 174.6,78.5 176.9,79.5 179.1,80.7 181.4,81.9 183.6,83.2 185.8,84.6 188.1,86.0 190.3,87.6 192.6,89.2 194.8,90.9 197.0,92.6 199.3,94.3 201.5,96.1 203.8,97.8 206.0,99.5 208.3,101.1 210.5,102.6 212.7,103.9 215.0,105.1 217.2,105.9 219.5,106.5 221.7,106.7 223.9,106.3 226.2,105.5 228.4,103.9 230.7,101.6 232.9,98.3 235.1,94.0 237.4,88.4 239.6,81.5 241.9,72.9 244.1,62.4' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='20.0,101.8 22.2,101.6 24.3,101.5 26.5,101.3 28.7,101.2 30.9,101.0 33.0,100.8 35.2,100.7 37.4,100.5 39.5,100.3 41.7,100.1 43.9,100.0 46.1,99.8 48.2,99.6 50.4,99.4 52.6,99.3 54.7,99.1 56.9,98.9 59.1,98.7 61.3,98.6 63.4,98.4 65.6,98.2 67.8,98.1 69.9,97.9 72.1,97.8 74.3,97.6 76.5,97.5 78.6,97.4 80.8,97.3 83.0,97.2 85.1,97.1 87.3,97.0 89.5,96.9 91.7,96.9 93.8,96.8 96.0,96.8 98.2,96.8 100.3,96.9 102.5,96.9 104.7,97.0 106.9,97.1 109.0,97.2 111.2,97.4 113.4,97.6 115.5,97.8 117.7,98.1 119.9,98.4 122.1,98.7 124.2,99.1 126.4,99.5 128.6,100.0 130.7,100.5 132.9,101.1 135.1,101.7 137.3,102.4 139.4,103.1 141.6,103.9 143.8,104.8 145.9,105.7 148.1,106.6 150.3,107.7 152.5,108.7 154.6,109.9 156.8,111.1 159.0,112.3 161.2,113.6 163.3,115.0 165.5,116.4 167.7,117.8 169.8,119.3 172.0,120.8 174.2,122.3 176.4,123.8 178.5,125.3 180.7,126.8 182.9,128.2 185.0,129.6 187.2,130.9 189.4,132.1 191.6,133.1 193.7,134.0 195.9,134.7 198.1,135.1 200.2,135.2 202.4,135.0 204.6,134.3 206.8,133.2 208.9,131.6 211.1,129.3 213.3,126.3 215.4,122.4 217.6,117.6 219.8,111.8 222.0,104.8 224.1,96.4 226.3,86.5 228.5,74.9 230.6,61.4 232.8,45.8 235.0,27.9 237.2,7.2' fill='none' stroke='#f0a30a' stroke-width='2'/><text x='162.8' y='57.1' fill='#2f6df0' font-size='11'>② = f</text><text x='96.9' y='134.5' fill='#f0a30a' font-size='11'>① = f′</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 106.7H294.0M221.4 164.0V8.0'/></g><line x1='148.2' y1='103.7' x2='148.2' y2='109.7' stroke='currentColor'/><text x='145.2' y='120.7' font-size='10'>-2</text></svg></div>\\[A=\\int_{-2}^0\\bigl(f(x)-f'(x)\\bigr)dx=\\int_{-2}^0x^2e^x\\,dx-\\bigl[f(x)\\bigr]_{-2}^0\\]<p>Por partes dos veces<i class='n' data-t='th'>Integración por partes: \\(\\int u\\,dv=uv-\\int v\\,du\\).</i>: \\(\\int x^2e^xdx=x^2e^x-\\int2xe^xdx=x^2e^x-2xe^x+2e^x=e^x(x^2-2x+2)\\).</p>\\[\\int_{-2}^0x^2e^x\\,dx=2-e^{-2}\\cdot10=2-\\frac{10}{e^2},\\qquad\\bigl[f(x)\\bigr]_{-2}^0=0-\\frac4{e^2}\\]\\[A=2-\\frac{10}{e^2}+\\frac4{e^2}=2-\\frac6{e^2}\\]<div class='res'>Área \\(=2-\\dfrac6{e^2}\\approx1{,}19\\ u^2\\)</div></div>"
    }
   ],
