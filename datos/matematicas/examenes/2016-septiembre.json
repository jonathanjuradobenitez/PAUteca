  {
   "id": "matematicas-2016-septiembre-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Calcula \\(\\displaystyle\\int\\frac x{1+\\sqrt x}\\,dx\\) (sugerencia: \\(t=\\sqrt x\\)).",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>Con el cambio \\(t=\\sqrt x\\): \\(x=t^2\\), \\(dx=2t\\,dt\\).</p>\\[\\int\\frac x{1+\\sqrt x}\\,dx=\\int\\frac{t^2}{1+t}\\,2t\\,dt=2\\int\\frac{t^3}{t+1}\\,dt\\]<p>Divido (por Ruffini): \\(t^3=(t+1)(t^2-t+1)-1\\):</p>\\[2\\int\\left(t^2-t+1-\\frac1{t+1}\\right)dt=2\\left(\\frac{t^3}3-\\frac{t^2}2+t-\\ln|t+1|\\right)+C\\]<p>Deshago el cambio (\\(t+1=\\sqrt x+1\\gt0\\)):</p><div class='res'>\\(\\displaystyle\\int\\frac x{1+\\sqrt x}\\,dx=\\frac23x\\sqrt x-x+2\\sqrt x-2\\ln\\left(1+\\sqrt x\\right)+C\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "integ",
     "tipo": "cambio",
     "apartados": ""
    },
    {
     "tema": "integ",
     "tipo": "racional",
     "apartados": ""
    }
   ],
   "origen": {
    "documento": "MAT-2016-SEPTIEMBRE.pdf"
   },
