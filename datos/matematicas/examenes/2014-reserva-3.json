58.8' r='3.5' fill='#e8487a'/><text x='56.0' y='162.8'>(−1,1)</text><circle cx='200.0' cy='158.8' r='3.5' fill='#e8487a'/><text x='208.0' y='162.8'>(1,1)</text><circle cx='50.0' cy='49.2' r='3.5' fill='#e8487a'/><text x='10.0' y='43.2'>(−2,4)</text><circle cx='250.0' cy='49.2' r='3.5' fill='#e8487a'/><text x='256.0' y='43.2'>(2,4)</text><text x='250.0' y='85.8' fill='#2f6df0' font-size='10'>y = x²</text><text x='157.5' y='111.3' fill='#16a34a' font-size='10'>y = 2 − x²</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 195.4H294.0M150.0 224.0V8.0'/></g><line x1='50.0' y1='192.4' x2='50.0' y2='198.4' stroke='currentColor'/><text x='47.0' y='209.4' font-size='10'>-2</text><line x1='100.0' y1='192.4' x2='100.0' y2='198.4' stroke='currentColor'/><text x='97.0' y='209.4' font-size='10'>-1</text><line x1='200.0' y1='192.4' x2='200.0' y2='198.4' stroke='currentColor'/><text x='197.0' y='209.4' font-size='10'>1</text><line x1='250.0' y1='192.4' x2='250.0' y2='198.4' stroke='currentColor'/><text x='247.0' y='209.4' font-size='10'>2</text><line x1='147.0' y1='158.8' x2='153.0' y2='158.8' stroke='currentColor'/><text x='134.0' y='162.8' font-size='10'>1</text><line x1='147.0' y1='122.3' x2='153.0' y2='122.3' stroke='currentColor'/><text x='134.0' y='126.3' font-size='10'>2</text><line x1='147.0' y1='49.2' x2='153.0' y2='49.2' stroke='currentColor'/><text x='134.0' y='53.2' font-size='10'>4</text></svg></div><div class='res'>Puntos de corte: \\((-1,1)\\), \\((1,1)\\), \\((-2,4)\\) y \\((2,4)\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>El recinto es simétrico respecto del eje \\(OY\\). En \\([0,1]\\) el borde inferior es \\(y=2-x^2\\) y en \\([1,2]\\) es \\(y=x^2\\):</p>\\[A=2\\left[\\int_0^1\\bigl(4-(2-x^2)\\bigr)dx+\\int_1^2(4-x^2)\\,dx\\right]\\]\\[\\int_0^1(2+x^2)\\,dx=\\Bigl[2x+\\frac{x^3}3\\Bigr]_0^1=\\frac73\\qquad\\int_1^2(4-x^2)\\,dx=\\Bigl[4x-\\frac{x^3}3\\Bigr]_1^2=\\frac{16}3-\\frac{11}3=\\frac53\\]\\[A=2\\left(\\frac73+\\frac53\\right)=8\\]<div class='res'>Área \\(=8\\ u^2\\)</div></div>"}],"clasificacion":[{"tema":"integ","tipo":"area","apartados":"a, b"}],"origen":{"documento":"MAT-2014-RESERVA_3.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2014-reserva-3-7","n":7,"num":3,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Considera las matrices \\(A=\\begin{pmatrix}1&0&2\\\\1&1&1\\\\2&3&0\\end{pmatrix}\\) y \\(B=\\begin{pmatrix}2&0&-3\\\\3&-1&-3\\\\-1&-2&-1\\end{pmatrix}\\).","apartados":["(0,5 p.) Calcula \\(A^{-1}\\).","(2 p.) Halla la matriz \\(X\\) que verifica que \\(A^tX+B=I\\), siendo \\(I\\) la matriz identidad y \\(A^t\\) la matriz traspuesta de \\(A\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>Calculo \\(|A|\\) por la regla de Sarrus<i class='n' data-t='th'>Regla de Sarrus: se suman los productos de la diagonal principal y de los dos triángulos con un lado paralelo a ella (en verde) y se restan los de la diagonal secundaria y sus dos triángulos (en rojo).<span style='display:block;margin:6px 0 0'><svg viewBox='0 0 206 106' width='100%' style='max-width:230px' font-family='system-ui,sans-serif'><text x='0' y='30' font-size='20' font-weight='700' fill='#17a673'>+</text><text x='0' y='86' font-size='20' font-weight='700' fill='#e8487a'>−</text><polygon points='26,10 41,25 56,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='10' r='3.6' fill='#17a673'/><circle cx='41' cy='10' r='2.2' fill='#9ca3af'/><circle cx='56' cy='10' r='2.2' fill='#9ca3af'/><circle cx='26' cy='25' r='2.2' fill='#9ca3af'/><circle cx='41' cy='25' r='3.6' fill='#17a673'/><circle cx='56' cy='25' r='2.2' fill='#9ca3af'/><circle cx='26' cy='40' r='2.2' fill='#9ca3af'/><circle cx='41' cy='40' r='2.2' fill='#9ca3af'/><circle cx='56' cy='40' r='3.6' fill='#17a673'/><polygon points='103,10 118,25 88,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='10' r='2.2' fill='#9ca3af'/><circle cx='103' cy='10' r='3.6' fill='#17a673'/><circle cx='118' cy='10' r='2.2' fill='#9ca3af'/><circle cx='88' cy='25' r='2.2' fill='#9ca3af'/><circle cx='103' cy='25' r='2.2' fill='#9ca3af'/><circle cx='118' cy='25' r='3.6' fill='#17a673'/><circle cx='88' cy='40' r='3.6' fill='#17a673'/><circle cx='103' cy='40' r='2.2' fill='#9ca3af'/><circle cx='118' cy='40' r='2.2' fill='#9ca3af'/><polygon points='180,10 150,25 165,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='10' r='2.2' fill='#9ca3af'/><circle cx='165' cy='10' r='2.2' fill='#9ca3af'/><circle cx='180' cy='10' r='3.6' fill='#17a673'/><circle cx='150' cy='25' r='3.6' fill='#17a673'/><circle cx='165' cy='25' r='2.2' fill='#9ca3af'/><circle cx='180' cy='25' r='2.2' fill='#9ca3af'/><circle cx='150' cy='40' r='2.2' fill='#9ca3af'/><circle cx='165' cy='40' r='3.6' fill='#17a673'/><circle cx='180' cy='40' r='2.2' fill='#9ca3af'/><polygon points='56,66 41,81 26,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='66' r='2.2' fill='#9ca3af'/><circle cx='41' cy='66' r='2.2' fill='#9ca3af'/><circle cx='56' cy='66' r='3.6' fill='#e8487a'/><circle cx='26' cy='81' r='2.2' fill='#9ca3af'/><circle cx='41' cy='81' r='3.6' fill='#e8487a'/><circle cx='56' cy='81' r='2.2' fill='#9ca3af'/><circle cx='26' cy='96' r='3.6' fill='#e8487a'/><circle cx='41' cy='96' r='2.2' fill='#9ca3af'/><circle cx='56' cy='96' r='2.2' fill='#9ca3af'/><polygon points='88,66 118,81 103,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='66' r='3.6' fill='#e8487a'/><circle cx='103' cy='66' r='2.2' fill='#9ca3af'/><circle cx='118' cy='66' r='2.2' fill='#9ca3af'/><circle cx='88' cy='81' r='2.2' fill='#9ca3af'/><circle cx='103' cy='81' r='2.2' fill='#9ca3af'/><circle cx='118' cy='81' r='3.6' fill='#e8487a'/><circle cx='88' cy='96' r='2.2' fill='#9ca3af'/><circle cx='103' cy='96' r='3.6' fill='#e8487a'/><circle cx='118' cy='96' r='2.2' fill='#9ca3af'/><polygon points='165,66 150,81 180,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='66' r='2.2' fill='#9ca3af'/><circle cx='165' cy='66' r='3.6' fill='#e8487a'/><circle cx='180' cy='66' r='2.2' fill='#9ca3af'/><circle cx='150' cy='81' r='3.6' fill='#e8487a'/><circle cx='165' cy='81' r='2.2' fill='#9ca3af'/><circle cx='180' cy='81' r='2.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i>:</p>\\[|A|=\\begin{vmatrix}1&0&2\\\\1&1&1\\\\2&3&0\\end{vmatrix}\\]\\[=\\bigl(0+0+6\\bigr)-\\bigl(4+3+0\\bigr)\\]\\[=-1\\]<p>Como \\(|A|\\neq0\\), existe la inversa: \\(A^{-1}=\\dfrac1{|A|}(\\operatorname{Adj}A)^t\\).</p>\\[\\operatorname{Adj}A=\\begin{pmatrix}-3 & 2 & 1\\\\6 & -4 & -3\\\\-2 & 1 & 1\\end{pmatrix}\\Rightarrow A^{-1}=-\\begin{pmatrix}-3 & 6 & -2\\\\2 & -4 & 1\\\\1 & -3 & 1\\end{pmatrix}=\\begin{pmatrix}3 & -6 & 2\\\\-2 & 4 & -1\\\\-1 & 3 & -1\\end{pmatrix}\\]<div class='res'>\\(A^{-1}=\\begin{pmatrix}3 & -6 & 2\\\\-2 & 4 & -1\\\\-1 & 3 & -1\\end{pmatrix}\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>\\(A^tX=I-B\\). Como \\(|A^t|=|A|\\neq0\\), \\(A^t\\) es invertible y \\((A^t)^{-1}=(A^{-1})^t\\)<i class='n' data-t='th'>La inversa de la traspuesta es la traspuesta de la inversa.</i>:</p>\\[X=(A^{-1})^t(I-B)\\]\\[(A^{-1})^t=\\begin{pmatrix}3 & -2 & -1\\\\-6 & 4 & 3\\\\2 & -1 & -1\\end{pmatrix},\\qquad I-B=\\begin{pmatrix}-1 & 0 & 3\\\\-3 & 2 & 3\\\\1 & 2 & 2\\end{pmatrix}\\]\\[X=\\begin{pmatrix}3 & -2 & -1\\\\-6 & 4 & 3\\\\2 & -1 & -1\\end{pmatrix}\\begin{pmatrix}-1 & 0 & 3\\\\-3 & 2 & 3\\\\1 & 2 & 2\\end{pmatrix}=\\begin{pmatrix}2 & -6 & 1\\\\-3 & 14 & 0\\\\0 & -4 & 1\\end{pmatrix}\\]<div class='res'>\\(X=\\begin{pmatrix}2 & -6 & 1\\\\-3 & 14 & 0\\\\0 & -4 & 1\\end{pmatrix}\\)</div></div>"}],"clasificacion":[{"tema":"matrices","tipo":"inv","apartados":"a"},{"tema":"matrices","tipo":"ecmat","apartados":"b"}],"origen":{"documento":"MAT-2014-RESERVA_3.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2014-reserva-3-8","n":8,"num":4,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Sea \\(r\\) la recta dada por \\(\\dfrac{x+2}2=y+1=\\dfrac{z-1}{-3}\\) y sea \\(s\\) la recta dada por \\(\\begin{cases}x-y-3=0\\\\3y-z+6=0\\end{cases}\\)","apartados":["(1 p.) Estudia la posición relativa de \\(r\\) y \\(s\\).","(1,5 p.) Halla la ecuación general del plano que contiene a \\(r\\) y es paralelo a \\(s\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>\\(r\\) pasa por \\(R(-2,-1,1)\\) con \\(\\vec u=(2,1,-3)\\). Paso \\(s\\) a paramétricas: con \\(y=\\lambda\\), \\(x=3+\\lambda\\), \\(z=6+3\\lambda\\); pasa por \\(S(3,0,6)\\) con \\(\\vec v=(1,1,3)\\).</p><p>Los directores no son proporcionales. Con \\(\\overrightarrow{RS}=(5,1,5)\\) calculo el producto mixto por la regla de Sarrus<i class='n' data-t='th'>Regla de Sarrus: se suman los productos de la diagonal principal y de los dos triángulos con un lado paralelo a ella (en verde) y se restan los de la diagonal secundaria y sus dos triángulos (en rojo).<span style='display:block;margin:6px 0 0'><svg viewBox='0 0 206 106' width='100%' style='max-width:230px' font-family='system-ui,sans-serif'><text x='0' y='30' font-size='20' font-weight='700' fill='#17a673'>+</text><text x='0' y='86' font-size='20' font-weight='700' fill='#e8487a'>−</text><polygon points='26,10 41,25 56,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='10' r='3.6' fill='#17a673'/><circle cx='41' cy='10' r='2.2' fill='#9ca3af'/><circle cx='56' cy='10' r='2.2' fill='#9ca3af'/><circle cx='26' cy='25' r='2.2' fill='#9ca3af'/><circle cx='41' cy='25' r='3.6' fill='#17a673'/><circle cx='56' cy='25' r='2.2' fill='#9ca3af'/><circle cx='26' cy='40' r='2.2' fill='#9ca3af'/><circle cx='41' cy='40' r='2.2' fill='#9ca3af'/><circle cx='56' cy='40' r='3.6' fill='#17a673'/><polygon points='103,10 118,25 88,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='10' r='2.2' fill='#9ca3af'/><circle cx='103' cy='10' r='3.6' fill='#17a673'/><circle cx='118' cy='10' r='2.2' fill='#9ca3af'/><circle cx='88' cy='25' r='2.2' fill='#9ca3af'/><circle cx='103' cy='25' r='2.2' fill='#9ca3af'/><circle cx='118' cy='25' r='3.6' fill='#17a673'/><circle cx='88' cy='40' r='3.6' fill='#17a673'/><circle cx='103' cy='40' r='2.2' fill='#9ca3af'/><circle cx='118' cy='40' r='2.2' fill='#9ca3af'/><polygon points='180,10 150,25 165,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='10' r='2.2' fill='#9ca3af'/><circle cx='165' cy='10' r='2.2' fill='#9ca3af'/><circle cx='180' cy='10' r='3.6' fill='#17a673'/><circle cx='150' cy='25' r='3.6' fill='#17a673'/><circle cx='165' cy='25' r='2.2' fill='#9ca3af'/><circle cx='180' cy='25' r='2.2' fill='#9ca3af'/><circle cx='150' cy='40' r='2.2' fill='#9ca3af'/><circle cx='165' cy='40' r='3.6' fill='#17a673'/><circle cx='180' cy='40' r='2.2' fill='#9ca3af'/><polygon points='56,66 41,81 26,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='66' r='2.2' fill='#9ca3af'/><circle cx='41' cy='66' r='2.2' fill='#9ca3af'/><circle cx='56' cy='66' r='3.6' fill='#e8487a'/><circle cx='26' cy='81' r='2.2' fill='#9ca3af'/><circle cx='41' cy='81' r='3.6' fill='#e8487a'/><circle cx='56' cy='81' r='2.2' fill='#9ca3af'/><circle cx='26' cy='96' r='3.6' fill='#e8487a'/><circle cx='41' cy='96' r='2.2' fill='#9ca3af'/><circle cx='56' cy='96' r='2.2' fill='#9ca3af'/><polygon points='88,66 118,81 103,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='66' r='3.6' fill='#e8487a'/><circle cx='103' cy='66' r='2.2' fill='#9ca3af'/><circle cx='118' cy='66' r='2.2' fill='#9ca3af'/><circle cx='88' cy='81' r='2.2' fill='#9ca3af'/><circle cx='103' cy='81' r='2.2' fill='#9ca3af'/><circle cx='118' cy='81' r='3.6' fill='#e8487a'/><circle cx='88' cy='96' r='2.2' fill='#9ca3af'/><circle cx='103' cy='96' r='3.6' fill='#e8487a'/><circle cx='118' cy='96' r='2.2' fill='#9ca3af'/><polygon points='165,66 150,81 180,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='66' r='2.2' fill='#9ca3af'/><circle cx='165' cy='66' r='3.6' fill='#e8487a'/><circle cx='180' cy='66' r='2.2' fill='#9ca3af'/><circle cx='150' cy='81' r='3.6' fill='#e8487a'/><circle cx='165' cy='81' r='2.2' fill='#9ca3af'/><circle cx='180' cy='81' r='2.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i><i class='n' data-t='th'>Si el producto mixto es 0 las rectas se cortan; si no, se cruzan.</i>:</p>\\[[\\overrightarrow{RS},\\vec u,\\vec v]=\\begin{vmatrix}5&1&5\\\\2&1&-3\\\\1&1&3\\end{vmatrix}\\]\\[=\\bigl(15-3+10\\bigr)-\\bigl(5-15+6\\bigr)\\]\\[=26\\neq0\\]<div class='res'>\\(r\\) y \\(s\\) se cruzan</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>El plano contiene a \\(\\vec u\\) (contiene a \\(r\\)) y a \\(\\vec v\\) (es paralelo a \\(s\\)):</p>\\[\\vec n=\\vec u\\times\\vec v=\\begin{vmatrix}\\vec i&\\vec j&\\vec k\\\\2&1&-3\\\\1&1&3\\end{vmatrix}=(6,\\,-9,\\,1)\\]<p>Es de la forma \\(6x-9y+z+D=0\\) y contiene a \\(R\\): \\(-12+9+1+D=0\\iff D=2\\).</p><div class='f3d' data-f='{\"az\":-54,\"el\":8,\"p\":[[\"poly\",[[-0.365,0.468,4.398],[-3.984,-1.945,4.398],[-3.666,-2.422,-1.798],[-0.047,-0.009,-1.798]],\"#8b5cf6\",\"#7c3aed\"],[\"txt\",[-3.666,-2.