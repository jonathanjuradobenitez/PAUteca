 de abscisa \\(x=2\\).","(1,25 p.) Calcula el área del recinto limitado por la gráfica de \\(g\\) y el eje de abscisas."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>\\(g(x)=\\frac x4(x^2-4x+4)=\\frac{x(x-2)^2}4\\): corta al eje en \\(x=0\\) y \\(x=2\\) (raíz doble, donde es tangente al eje).</p><p>\\(g'(x)=\\frac34x^2-2x+1=\\frac{(3x-2)(x-2)}4\\): máximo en \\(\\left(\\frac23,\\frac8{27}\\right)\\) y mínimo en \\((2,0)\\).</p><div style='overflow-x:auto'><svg viewBox='0 0 300 190' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='69.5,116.0 72.6,113.1 75.7,110.6 78.8,108.3 81.9,106.3 85.0,104.5 88.1,103.0 91.2,101.7 94.3,100.6 97.4,99.8 100.5,99.1 103.6,98.7 106.7,98.4 109.8,98.2 112.9,98.3 116.0,98.4 119.0,98.7 122.1,99.1 125.2,99.7 128.3,100.3 131.4,101.0 134.5,101.8 137.6,102.6 140.7,103.5 143.8,104.5 146.9,105.5 150.0,106.4 153.1,107.4 156.2,108.4 159.3,109.4 162.4,110.4 165.5,111.3 168.6,112.2 171.7,113.0 174.8,113.7 177.9,114.4 181.0,114.9 184.0,115.4 187.1,115.7 190.2,115.9 193.3,116.0 193.3,116.0 190.2,116.0 187.1,116.0 184.0,116.0 181.0,116.0 177.9,116.0 174.8,116.0 171.7,116.0 168.6,116.0 165.5,116.0 162.4,116.0 159.3,116.0 156.2,116.0 153.1,116.0 150.0,116.0 146.9,116.0 143.8,116.0 140.7,116.0 137.6,116.0 134.5,116.0 131.4,116.0 128.3,116.0 125.2,116.0 122.1,116.0 119.0,116.0 116.0,116.0 112.9,116.0 109.8,116.0 106.7,116.0 103.6,116.0 100.5,116.0 97.4,116.0 94.3,116.0 91.2,116.0 88.1,116.0 85.0,116.0 81.9,116.0 78.8,116.0 75.7,116.0 72.6,116.0 69.5,116.0' fill='#b9a4f5' fill-opacity='.55'/><polyline points='32.4,176.8 34.8,171.2 37.2,165.8 39.6,160.7 42.0,155.8 44.5,151.1 46.9,146.7 49.3,142.6 51.7,138.6 54.1,134.9 56.5,131.4 58.9,128.1 61.4,125.0 63.8,122.1 66.2,119.4 68.6,116.9 71.0,114.6 73.4,112.5 75.8,110.5 78.3,108.7 80.7,107.1 83.1,105.6 85.5,104.3 87.9,103.1 90.3,102.0 92.7,101.1 95.2,100.4 97.6,99.7 100.0,99.2 102.4,98.8 104.8,98.5 107.2,98.3 109.6,98.2 