#e8487a'/><circle cx='41' cy='96' r='2.2' fill='#9ca3af'/><circle cx='56' cy='96' r='2.2' fill='#9ca3af'/><polygon points='88,66 118,81 103,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='66' r='3.6' fill='#e8487a'/><circle cx='103' cy='66' r='2.2' fill='#9ca3af'/><circle cx='118' cy='66' r='2.2' fill='#9ca3af'/><circle cx='88' cy='81' r='2.2' fill='#9ca3af'/><circle cx='103' cy='81' r='2.2' fill='#9ca3af'/><circle cx='118' cy='81' r='3.6' fill='#e8487a'/><circle cx='88' cy='96' r='2.2' fill='#9ca3af'/><circle cx='103' cy='96' r='3.6' fill='#e8487a'/><circle cx='118' cy='96' r='2.2' fill='#9ca3af'/><polygon points='165,66 150,81 180,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='66' r='2.2' fill='#9ca3af'/><circle cx='165' cy='66' r='3.6' fill='#e8487a'/><circle cx='180' cy='66' r='2.2' fill='#9ca3af'/><circle cx='150' cy='81' r='3.6' fill='#e8487a'/><circle cx='165' cy='81' r='2.2' fill='#9ca3af'/><circle cx='180' cy='81' r='2.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i>:</p>\\[|A|=\\begin{vmatrix}m&2&1\\\\1&m&0\\\\2&0&m\\end{vmatrix}\\]\\[=\\bigl(m^{3}+0+0\\bigr)-\\bigl(2 m+0+2 m\\bigr)\\]\\[=m^3-4m=m(m-2)(m+2)\\]<div class='res'>Tiene infinitas soluciones para \\(m=0\\), \\(m=2\\) y \\(m=-2\\)</div></div>"}],"clasificacion":[{"tema":"sistemas","tipo":"disc","apartados":"a, b, c"}],"origen":{"documento":"MAT-2004-RESERVA-2.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2004-reserva-2-8","n":8,"num":4,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Considera los puntos \\(P(6,-1,-10)\\), \\(Q(0,2,2)\\) y \\(R\\), que es el punto de intersección del plano \\(\\pi\\equiv2x+\\lambda y+z-2=0\\) y la recta \\(r\\equiv\\begin{cases}x+y+z-1=0\\\\y=1\\e