,33.7 276.2,33.2' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='20.0,125.8 148.1,78.9 276.2,31.9' fill='none' stroke='#f0a30a' stroke-width='2'/><circle cx='246.3' cy='42.9' r='3.5' fill='#e8487a'/><text x='238.3' y='32.9'>(e,2)</text><circle cx='38.4' cy='119.0' r='3.5' fill='#e8487a'/><text x='32.4' y='133.0'>−e</text><circle cx='156.4' cy='119.0' r='3.5' fill='#e8487a'/><text x='156.4' y='133.0'>1/e</text><text x='257.1' y='81.0' fill='#2f6df0' font-size='10'>1+ln x</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 119.0H294.0M142.4 194.0V8.0'/></g><line x1='65.9' y1='116.0' x2='65.9' y2='122.0' stroke='currentColor'/><text x='62.9' y='133.0' font-size='10'>-2</text><line x1='104.1' y1='116.0' x2='104.1' y2='122.0' stroke='currentColor'/><text x='101.1' y='133.0' font-size='10'>-1</text><line x1='180.6' y1='116.0' x2='180.6' y2='122.0' stroke='currentColor'/><text x='177.6' y='133.0' font-size='10'>1</text><line x1='218.8' y1='116.0' x2='218.8' y2='122.0' stroke='currentColor'/><text x='215.8' y='133.0' font-size='10'>2</text><line x1='257.1' y1='116.0' x2='257.1' y2='122.0' stroke='currentColor'/><text x='254.1' y='133.0' font-size='10'>3</text><line x1='139.4' y1='81.0' x2='145.4' y2='81.0' stroke='currentColor'/><text x='126.4' y='85.0' font-size='10'>1</text><line x1='139.4' y1='42.9' x2='145.4' y2='42.9' stroke='currentColor'/><text x='126.4' y='46.9' font-size='10'>2</text></svg></div>\\[\\text{Triángulo}=\\frac{2e\\cdot2}2=2e,\\qquad\\int_{1/e}^e(1+\\ln x)\\,dx=\\bigl[x\\ln x\\bigr]_{1/e}^e=e-\\frac1e\\ln\\frac1e=e+\\frac1e\\]<p>(Una primitiva de \\(1+\\ln x\\) es \\(x\\ln x\\): basta derivarla.)</p>\\[A=2e-\\left(e+\\frac1e\\right)=e-\\frac1e\\]<div class='res'>Área \\(=e-\\dfrac1e\\approx2{,}35\\ u^2\\)</div></div>"}],"clasificacion":[{"tema":"funciones","tipo":"tang","apartados":"a"},{"tema":"integ","tipo":"area","apartados":"b"}],"origen":{"documento":"MAT-2009-RESERVA_4.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2009-reserva-4-3","n":3,"num":3,"bloque":"Opción A","puntos":"2,5","enunciado":{"intro":"Dadas las matrices \\(A=\\begin{pmatrix}3&7\\\\1&2\\end{pmatrix}\\) y \\(B=\\begin{pmatrix}1&-3\\\\-4&2\\end{pmatrix}\\)","apartados":["(1 p.) Calcula, si existe, la matriz inversa de \\(A\\).","(1,5 p.) Calcula las matrices \\(X\\) e \\(Y\\) que satisfacen las ecuaciones matriciales \\(XA=A+2B\\) y \\(AY=A+2B\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'>\\[|A|=6-7=-1\\neq0,\\qquad A^{-1}=\\frac1{|A|}(\\operatorname{Adj}A)^t=-\\begin{pmatrix}2 & -7\\\\-1 & 3\\end{pmatrix}=\\begin{pmatrix}-2 & 7\\\\1 & -3\\end{pmatrix}\\]<div class='res'>\\(A^{-1}=\\begin{pmatrix}-2 & 7\\\\1 & -3\\end{pmatrix}\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'>\\[A+2B=\\begin{pmatrix}3 & 7\\\\1 & 2\\end{pmatrix}+\\begin{pmatrix}2 & -6\\\\-8 & 4\\end{pmatrix}=\\begin{pmatrix}5 & 1\\\\-7 & 6\\end{pmatrix}\\]<p>\\(XA=A+2B\\): multiplicando por \\(A^{-1}\\) por la <b>derecha</b>, \\(X=(A+2B)A^{-1}\\). \\(AY=A+2B\\): multiplicando por \\(A^{-1}\\) por la <b>izquierda</b>, \\(Y=A^{-1}(A+2B)\\)<i class='n' data-t='why'>El producto de matrices no es conmutativo: \\(A^{-1}\\) hay que ponerlo en el mismo lado en que está \\(A\\).</i>:</p>\\[X=\\begin{pmatrix}5 & 1\\\\-7 & 6\\end{pmatrix}\\begin{pmatrix}-2 & 7\\\\1 & -3\\end{pmatrix}=\\begin{pmatrix}-9 & 32\\\\20 & -67\\end{pmatrix},\\qquad Y=\\begin{pmatrix}-2 & 7\\\\1 & -3\\end{pmatrix}\\begin{pmatrix}5 & 1\\\\-7 & 6\\end{pmatrix}=\\begin{pmatrix}-59 & 40\\\\26 & -17\\end{pmatrix}\\]<div class='res'>\\(X=\\begin{pmatrix}-9 & 32\\\\20 & -67\\end{pmatrix}\\), \\(Y=\\begin{pmatrix}-59 & 40\\\\26 & -17\\end{pmatrix}\\)</div></div>"}],"clasificacion":[{"tema":"matrices","tipo":"inv","apartados":"a"},{"tema":"matrices","tipo":"ecmat","apartados":"b"}],"origen":{"documento":"MAT-2009-RESERVA_4.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2009-reserva-4-4","n":4,"num":4,"bloque":"Opción A","puntos":"2,5","enunciado":{"intro":"Considera el punto \\(P(1,0,-2)\\), la recta \\(r\\) definida por \\(\\begin{cases}x-2y-1=0\\\\y+z-2=0\\end{cases}\\) y el plano \\(\\pi\\) de ecuación \\(2x+y+3z-1=0\\).","apartados":["(1,25 p.) Halla la ecuación del plano que pasa por \\(P\\), es paralelo a \\(r\\) y es perpendicular a \\(\\pi\\).","(1,25 p.) Halla la ecuación de la recta que pasa por \\(P\\), corta a \\(r\\) y es paralela a \\(\\pi\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>\\(r\\): con \\(y=t\\), \\(x=1+2t\\), \\(z=2-t\\): \\(r\\equiv(1+2t,\\,t,\\,2-t)\\), con \\(\\vec d=(2,1,-1)\\). Normal de \\(\\pi\\): \\(\\vec n=(2,1,3)\\).</p><p>El plano contiene la dirección \\(\\vec d\\) (paralelo a \\(r\\)) y la dirección \\(\\vec n\\) (perpendicular a \\(\\pi\\)). Su normal:</p>\\[\\vec d\\times\\vec n=\\begin{vmatrix}\\vec i&\\vec j&\\vec k\\\\2&1&-1\\\\2&1&3\\end{vmatrix}=(4,\\,-8,\\,0)\\parallel(1,-2,0)\\]<p>Es de la forma \\(x-2y+D=0\\) y pasa por \\(P\\): \\(1-0+D=0\\iff D=-1\\).</p><div class='res'>\\(x-2y-1=0\\)</div><i class='n' data-t='tp'>Es justo la primera ecuación de \\(r\\): \\(P\\) y \\(r\\) están en ese plano.</i></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>La recta pedida está en el plano \\(\\pi'\\) paralelo a \\(\\pi\\) que pasa por \\(P\\): \\(2x+y+3z+D=0\\), con \\(2+0-6+D=0\\iff D=4\\). Corta a \\(r\\) donde \\(r\\) corta a \\(\\pi'\\):</p>\\[2(1+2t)+t+3(2-t)+4=0\\iff2t+12=0\\iff t=-6\\ \\Rightarrow\\ Q(-11,-6,8)\\]<p>La recta pasa por \\(P\\) y \\(Q\\): \\(\\overrightarrow{PQ}=(-12,-6,10)\\parallel(6,3,-5)\\).</p><div class='f3d' data-f='{\"az\":81,\"el\":30,\"p\":[[\"line\",[-12.2,-6.6,8.6],[3.4,1.2,0.8],\"#2563eb\",2.2,false],[\"txt\",[3.4,1.2,0.8],\"r\",\"#2563eb\",6,0],[\"line\",[-13.4,-7.2,10.0],[3.4,1.2,-4.0],\"#e11d48\",2.2,false],[\"txt\",[3.4,1.2,-4.0],\"s\",\"#e11d48\",6,0],[\"poly\",[[-11.866,-4.986,8.239],[-8.708,-11.301,8.239],[3.866,-5.014,-2.239],[0.708,1.301,-2.239]],\"#8b5cf6\",\"#7c3aed\"],[\"txt\",[3.866,-5.014,-2.239],\"π′\",\"#7c3aed\",4,0],[\"pt\",[1,0,-2],\"P\",7,-6],[\"pt\",[-11,-6,8],\"Q\",7,-6]],\"ley\":[\"plano\",\"recta\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 300' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m09r4a4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m09r4a4d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='m09r4a4g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#64748b'/></marker><marker id='m09r4a4r' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#2563eb'/></marker></defs><line x1='227.0' y1='40.3' x2='44.4' y2='192.5' stroke='#2563eb' stroke-width='2.2'/><text x='50.4' y='192.5' fill='#2563eb' font-weight='700' font-style='italic'>r</text><line x1='241.0' y1='19.7' x2='44.4' y2='246.0' stroke='#e11d48' stroke-width='2.2'/><text x='50.4' y='246.0' fill='#e11d48' font-weight='700' font-style='italic'>s</text><polygon points='226.0,55.0 173.1,18.0 26.0,187.4 78.8,224.3' fill='#8b5cf6' fill-opacity='.26' stroke='#7c3aed' stroke-width='1.2'/><text x='30.0' y='187.4' fill='#7c3aed' font-weight='700' font-style='italic'>π′</text><circle cx='72.5' cy='213.7' r='3.8' fill='#e8487a'/><text x='79.5' y='207.7' font-weight='700'>P</text><circle cx='212.9' cy='52.0' r='3.8' fill='#e8487a'/><text x='219.9' y='46.0' font-weight='700'>Q</text><line x1='24' y1='270' x2='8.2' y2='271.3' stroke='#64748b' stroke-width='1.2'/><text x='-0.3' y='275.7' fill='#64748b' font-size='10'>x</text><line x1='24' y1='270' x2='26.5' y2='277.9' stroke='#64748b' stroke-width='1.2'/><text x='24.4' y='284.7' fill='#64748b' font-size='10'>y</text><line x1='24' y1='270' x2='24.0' y2='256.1' stroke='#64748b' stroke-width='1.2'/><text x='21.0' y='255.3' fill='#64748b' font-size='10'>z</text><g transform='translate(56.0,292)'><rect x='0' y='-8' width='12' height='9' fill='#8b5cf6' fill-opacity='.4' stroke='#7c3aed'/><text x='18' y='0' font-size='10'>plano</text></g><g transform='translate(106.5,292)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#2563eb' stroke-width='2'/><text x='18' y='0' font-size='10'>recta</text></g><g transform='translate(157.0,292)'><circle cx='6' cy='-4' r='3.8' fill='#e8487a'/><text x='18' y='0' font-size='10'>puntos</text></g></svg><p class='mut' style='font-size:.8rem;margin:.2rem 0;text-align:center'>Figura interactiva: arrástrala para girarla en 3D.</p></div><div class='res'>\\(\\begin{cases}x=1+6\\lambda\\\\y=3\\lambda\\\\z=-2-5\\lambda\\end{cases}\\), \\(\\lambda\\in\\mathbb R\\)</div><i class='n' data-t='tp'>Comprobación: \\((6,3,-5)\\cdot(2,1,3)=12+3-15=0\\), es paralela a \\(\\pi\\) ✓.</i></div>"}],"clasificacion":[{"tema":"geom","tipo":"ecs","apartados":"a, b"},{"tema":"geom","tipo":"pos","apartados":"b"}],"origen":{"documento":"MAT-2009-RESERVA_4.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2009-reserva-4-5","n":5,"num":1,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Sea \\(f:(0,+\\infty)\\to\\mathbb R\\) la función dada por \\[f(x)=\\begin{cases}\\dfrac{x(\\ln x)^2}{(x-1)^2}&\\text{si }x\\neq1\\\\[2mm]a&\\text{si }x=1\\end{cases}\\]","apartados":["(1,25 p.) Sabiendo que \\(f\\) es continua, calcula \\(a\\) (\\(\\ln\\) denota el logaritmo neperiano).","(1,25 p.) Estudia la existencia de asíntota horizontal para la gráfica de esta función. En caso de que exista, determina su ecuación."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>Para \\(x\\neq1\\) es cociente de continuas con denominador no nulo. En \\(x=1\\) debe ser \\(a=\\displaystyle\\lim_{x\\to1}f(x)\\):</p>\\[\\lim_{x\\to1}\\frac{x(\\ln x)^2}{(x-1)^2}=\\lim_{x\\to1}x\\cdot\\left(\\frac{\\ln x}{x-1}\\right)^2\\]\\[\\lim_{x\\to1}\\frac{\\ln x}{x-1}=\\frac00\\overset{\\text{L'H}}=\\lim_{x\\to1}\\frac{1/x}1=1\\ \\Rightarrow\\ \\lim_{x\\to1}f(x)=1\\cdot1^2=1\\]<p>(Regla de L'Hôpital<i class='n' data-t='th'>Regla de L'Hôpital: si el límite de \\(\\frac fg\\) da \\(\\frac00\\) o \\(\\frac\\infty\\infty\\), es igual al límite de \\(\\frac{f'}{g'}\\), si este existe.</i>.)</p><div class='res'>\\(a=1\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>El dominio es \\((0,+\\infty)\\): solo hay que estudiar \\(x\\to+\\infty\\). Separo:</p>\\[f(x)=\\frac{x^2}{(x-1)^2}\\cdot\\frac{(\\ln x)^2}x,\\qquad\\lim_{x\\to+\\infty}\\frac{x^2}{(x-1)^2}=1\\]\\[\\lim_{x\\to+\\infty}\\frac{(\\ln x)^2}x=\\frac\\infty\\infty\\overset{\\text{L'H}}=\\lim_{x\\to+\\infty}\\frac{2\\ln x}x\\overset{\\text{L'H}}=\\lim_{x\\to+\\infty}\\frac2x=0\\]<div class='res'>\\(\\displaystyle\\lim_{x\\to+\\infty}f(x)=0\\): asíntota horizontal \\(y=0\\) (en \\(+\\infty\\))</div></div>"}],"clasificacion":[{"tema":"funciones","tipo":"cont","apartados":"a"},{"tema":"funciones","tipo":"lim","apartados":"a, b"},{"tema":"funciones","tipo":"asint","apartados":"b"}],"origen":{"documento":"MAT-2009-RESERVA_4.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2009-reserva-4-6","n":6,"num":2,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Se consideran las funciones \\(f:[0,+\\infty)\\to\\mathbb R\\) y \\(g:\\mathbb R\\to\\mathbb R\\) definidas por \\(f(x)=\\sqrt{3x}\\), \\(g(x)=\\dfrac13x^2\\).","apartados":["(0,5 p.) Haz un esbozo de sus gráficas.","(2 p.) Calcula el área del recinto limitado por las gráficas de ambas funciones."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>\\(f\\) es media rama de parábola de eje horizontal (\\(y^2=3x\\)) y \\(g\\) una parábola con vértice en el origen. Cortes:</p>\\[\\sqrt{3x}=\\frac{x^2}3\\Rightarrow3x=\\frac{x^4}9\\iff x(x^3-27)=0\\iff x=0\\ \\text{ o }\\ x=3\\]<div style='overflow-x:auto'><svg viewBox='0 0 300 220' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='52.5,179.2 55.2,165.8 57.9,160.3 60.6,156.0 63.3,152.4 66.0,149.3 68.8,146.4 71.5,143.8 74.2,141.3 76.9,139.0 79.6,136.8 82.3,134.8 85.0,132.8 87.7,130.9 90.4,129.1 93.1,127.3 95.8,125.6 98.5,124.0 101.2,122.4 104.0,120.8 106.7,119.3 109.4,117.8 112.1,116.3 114.8,114.9 117.5,113.6 120.2,112.2 122.9,110.9 125.6,109.6 128.3,108.3 131.0,107.0 133.8,105.8 136.5,104.6 139.2,103.4 141.9,102.2 144.6,101.1 147.3,99.9 150.0,98.8 152.7,97.7 155.4,96.6 158.1,95.5 160.8,94.4 163.5,93.4 166.3,92.3 169.0,91.3 171.7,90.3 174.4,89.3 177.1,88.3 179.8,87.3 182.5,86.3 185.2,85.4 187.9,84.4 190.6,83.5 193.3,82.6 196.0,81.6 198.8,80.7 201.5,79.8 204.2,78.9 206.9,78.0 209.6,77.1 212.3,76.3 215.0,75.4 215.0,75.4 212.3,78.8 209.6,82.2 206.9,85.5 204.2,88.8 201.5,92.0 198.8,95.1 196.0,98.2 193.3,101.2 190.6,104.2 187.9,107.1 185.2,110.0 182.5,112.8 179.8,115.5 177.1,118.2 174.4,120.8 171.7,123.4 169.0,125.9 166.3,128.3 163.5,130.7 160.8,133.1 158.1,135.4 155.4,137.6 152.7,139.7 150.0,141.8 147.3,143.9 144.6,145.9 141.9,147.8 139.2,149.7 136.5,151.5 133.8,153.3 131.0,155.0 128.3,156.6 125.6,158.2 122.9,159.7 120.2,161.2 117.5,162.6 114.8,164.0 112.1,165.3 109.4,166.5 106.7,167.7 104.0,168.8 101.2,169.9 98.5,170.9 95.8,171.8 93.1,172.7 90.4,173.6 87.7,174.4 85.0,175.1 82.3,175.7 79.6,176.3 76.9,176.9 74.2,177.4 71.5,177.8 68.8,178.2 66.0,178.5 63.3,178.8 60.6,179.0 57.9,179.1 55.2,179.2 52.5,179.2' fill='#b9a4f5' fill-opacity='.55'/><polyline points='52.5,179.2 55.3,165.5 58.2,159.8 61.0,155.4 63.9,151.8 66.7,148.5 69.6,145.6 72.4,142.9 75.2,140.4 78.1,138.0 80.9,135.8 83.8,133.7 86.6,131.6 89.5,129.7 92.3,127.8 95.2,126.0 98.0,124.3 100.8,122.6 103.7,120.9 106.5,119.4 109.4,117.8 112.2,116.3 115.1,114.8 117.9,113.3 120.8,111.9 123.6,110.5 126.4,109.2 129.3,