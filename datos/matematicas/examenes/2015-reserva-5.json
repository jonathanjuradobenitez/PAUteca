  {
   "id": "matematicas-2015-reserva-5-2",
   "n": 2,
   "num": 2,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Calcula \\(\\displaystyle\\int\\frac{dx}{(x-2)\\sqrt{x+2}}\\) (Sugerencia: \\(\\sqrt{x+2}=t\\)).",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>Hago el cambio \\(t=\\sqrt{x+2}\\): \\(x=t^2-2\\), \\(dx=2t\\,dt\\).</p>\\[\\int\\frac{dx}{(x-2)\\sqrt{x+2}}=\\int\\frac{2t\\,dt}{(t^2-4)\\,t}=\\int\\frac2{t^2-4}\\,dt\\]<p>Fracciones simples: \\(\\dfrac2{(t-2)(t+2)}=\\dfrac A{t-2}+\\dfrac B{t+2}\\iff2=A(t+2)+B(t-2)\\). Con \\(t=2\\): \\(A=\\frac12\\); con \\(t=-2\\): \\(B=-\\frac12\\).</p>\\[\\int\\frac2{t^2-4}\\,dt=\\frac12\\ln|t-2|-\\frac12\\ln|t+2|+C=\\frac12\\ln\\left|\\frac{t-2}{t+2}\\right|+C\\]<div class='res'>\\(\\displaystyle\\int\\frac{dx}{(x-2)\\sqrt{x+2}}=\\frac12\\ln\\left|\\frac{\\sqrt{x+2}-2}{\\sqrt{x+2}+2}\\right|+C\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "integ",
     "tipo": "cambio",
     "apartados": ""
    },
    {
     "tema": "integ",
     "tipo": "racional",
     "apartados": ""
    }
   ],
   "origen": {
    "documento": "MAT-2015-RESERVA_5.pdf"
   },
   "dificultad": null,
