  {
   "id": "matematicas-2015-reserva-5-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sea \\(g\\) la función definida por \\(g(x)=\\ln(x)\\) para \\(x\\gt0\\) (\\(\\ln\\) denota la función logaritmo neperiano). Calcula el valor de \\(a\\gt1\\) para el que el área del recinto limitado por la gráfica de \\(g\\), el eje de abscisas y la recta \\(x=a\\) es 1.",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>\\(\\ln x\\) se anula en \\(x=1\\) y es positivo para \\(x\\gt1\\): el recinto está entre \\(x=1\\) y \\(x=a\\), por encima del eje. Uso \\(\\int\\ln x\\,dx=x\\ln x-x\\) (por partes):</p>\\[\\int_1^a\\ln x\\,dx=\\bigl[x\\ln x-x\\bigr]_1^a=a\\ln a-a+1\\]\\[a\\ln a-a+1=1\\iff a(\\ln a-1)=0\\iff\\ln a=1\\iff a=e\\]<p>(\\(a=0\\) no vale, porque \\(a\\gt1\\).)</p><div style='overflow-x:auto'><svg viewBox='0 0 300 170' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='111.4,102.7 113.4,101.1 115.4,99.4 117.4,97.9 119.4,96.3 121.4,94.8 123.4,93.4 125.4,91.9 127.5,90.5 129.5,89.2 131.5,87.8 133.5,86.5 135.5,85.3 137.5,84.0 139.5,82.8 141.5,81.6 143.5,80.4 145.6,79.3 147.6,78.2 149.6,77.1 151.6,76.0 153.6,74.9 155.6,73.9 157.6,72.8 159.6,71.8 161.7,70.8 163.7,69.8 165.7,68.9 167.7,67.9 169.7,67.0 171.7,66.1 173.7,65.2 175.7,64.3 177.8,63.4 179.8,62.6 181.8,61.7 183.8,60.9 185.8,60.0 187.8,59.2 189.8,58.4 191.8,57.6 193.9,56.8 195.9,56.1 197.9,55.3 199.9,54.5 201.9,53.8 203.9,53.1 205.9,52.3 207.9,51.6 210.0,50.9 212.0,50.2 214.0,49.5 216.0,48.8 218.0,48.2 220.0,47.5 222.0,46.8 224.0,46.2 226.1,45.5 228.1,44.9 230.1,44.3 232.1,43.6 232.1,102.7 230.1,102.7 228.1,102.7 226.1,102.7 224.0,102.7 222.0,102.7 220.0,102.7 218.0,102.7 216.0,102.7 214.0,102.7 212.0,102.7 210.0,102.7 207.9,102.7 205.9,102.7 203.9,102.7 201.9,102.7 199.9,102.7 197.9,102.7 195.9,102.7 193.9,102.7 191.8,102.7 189.8,102.7 187.8,102.7 185.8,102.7 183.8,102.7 181.8,102.7 179.8,102.7 177.8,102.7 175.7,102.7 173.7,102.7 171.7,102.7 169.7,102.7 167.7,102.7 165.7,102.7 163.7,102.7 161.7,102.7 159.6,102.7 157.6,102.7 155.6,102.7 153.6,102.7 151.6,102.7 149.6,102.7 147.6,102.7 145.6,102.7 143.5,102.7 141.5,102.7 139.5,102.7 137.5,102.7 135.5,102.7 133.5,102.7 131.5,102.7 129.5,102.7 127.5,102.7 125.4,102.7 123.4,102.7 121.4,102.7 119.4,102.7 117.4,102.7 115.4,102.7 113.4,102.7 111.4,102.7' fill='#b9a4f5' fill-opacity='.55'/><polyline points='72.7,149.9 75.2,145.4 77.7,141.2 80.2,137.3 82.7,133.7 85.2,130.2 87.7,126.9 90.2,123.9 92.7,120.9 95.2,118.1 97.7,115.5 100.2,112.9 102.7,110.4 105.2,108.1 107.8,105.8 110.3,103.7 112.8,101.6 115.3,99.5 117.8,97.6 120.3,95.7 122.8,93.8 125.3,92.0 127.8,90.3 130.3,88.6 132.8,87.0 135.3,85.4 137.8,83.9 140.3,82.3 142.8,80.9 145.3,79.4 147.8,78.0 150.3,76.7 152.8,75.3 155.3,74.0 157.8,72.7 160.3,71.5 162.8,70.3 165.3,69.1 167.8,67.9 170.3,66.7 172.8,65.6 175.3,64.5 177.8,63.4 180.3,62.3 182.9,61.3 185.4,60.2 187.9,59.2 190.4,58.2 192.9,57.2 195.4,56.3 197.9,55.3 200.4,54.4 202.9,53.4 205.4,52.5 207.9,51.6 210.4,50.8 212.9,49.9 215.4,49.0 217.9,48.2 220.4,47.4 222.9,46.6 225.4,45.7 227.9,44.9 230.4,44.2 232.9,43.4 235.4,42.6 237.9,41.9 240.4,41.1 242.9,40.4 245.4,39.6 247.9,38.9 250.4,38.2 252.9,37.5 255.4,36.8 258.0,36.1 260.5,35.5 263.0,34.8 265.5,34.1 268.0,33.5 270.5,32.8 273.0,32.2' fill='none' stroke='#2f6df0' stroke-width='2'/><line x1='232.1' y1='102.7' x2='232.1' y2='43.6' stroke='#64748b' stroke-width='1.4' stroke-dasharray='5 4'/><text x='202.7' y='129.3' fill='#64748b' font-size='10'>x = a = e</text><text x='251.9' y='55.5' fill='#2f6df0' font-size='12'>g</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 102.7H294.0M41.1 164.0V8.0'/></g><line x1='111.4' y1='99.7' x2='111.4' y2='105.7' stroke='currentColor'/><text x='108.4' y='116.7' font-size='10'>1</text><line x1='181.6' y1='99.7' x2='181.6' y2='105.7' stroke='currentColor'/><text x='178.6' y='116.7' font-size='10'>2</text><line x1='251.9' y1='99.7' x2='251.9' y2='105.7' stroke='currentColor'/><text x='248.9' y='116.7' font-size='10'>3</text><line x1='38.1' y1='43.6' x2='44.1' y2='43.6' stroke='currentColor'/><text x='25.1' y='47.6' font-size='10'>1</text></svg></div><div class='res'>\\(a=e\\)</div></div>"
