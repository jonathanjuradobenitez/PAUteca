a":"geom","tipo":"pos","apartados":"a"},{"tema":"geom","tipo":"perp","apartados":"b"}],"origen":{"documento":"MAT-2003-RESERVA-2.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"}]}