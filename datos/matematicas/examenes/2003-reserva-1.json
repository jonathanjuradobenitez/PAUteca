   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Considera las funciones \\(f,g:\\mathbb R\\to\\mathbb R\\) definidas por \\(f(x)=6-x^2\\) y \\(g(x)=|x|\\).",
    "apartados": [
     "(0,75 p.) Dibuja el recinto acotado que está limitado por las gráficas de \\(f\\) y \\(g\\).",
     "(1,75 p.) Calcula el área del recinto descrito en el apartado anterior."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'><p>Las dos son pares. Para \\(x\\geq0\\): \\(6-x^2=x\\iff x^2+x-6=0\\iff x=2\\) (la raíz \\(-3\\) no vale); por simetría también \\(x=-2\\).</p><div style='overflow-x:auto'><svg viewBox='0 0 300 210' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='63.3,124.6 67.7,116.1 72.0,108.1 76.3,100.4 80.7,93.2 85.0,86.5 89.3,80.2 93.7,74.3 98.0,68.8 102.3,63.8 106.7,59.2 111.0,55.1 115.3,51.4 119.7,48.1 124.0,45.3 128.3,42.9 132.7,40.9 137.0,39.4 141.3,38.3 145.7,37.7 150.0,37.4 154.3,37.7 158.7,38.3 163.0,39.4 167.3,40.9 171.7,42.9 176.0,45.3 180.3,48.1 184.7,51.4 189.0,55.1 193.3,59.2 197.7,63.8 202.0,68.8 206.3,74.3 210.7,80.2 215.0,86.5 219.3,93.2 223.7,100.4 228.0,108.1 232.3,116.1 236.7,124.6 236.7,124.6 232.3,126.8 228.0,129.0 223.7,131.2 219.3,133.3 215.0,135.5 210.7,137.7 206.3,139.9 202.0,142.1 197.7,144.2 193.3,146.4 189.0,148.6 184.7,150.8 180.3,152.9 176.0,155.1 171.7,157.3 167.3,159.5 163.0,161.7 158.7,163.8 154.3,166.0 150.0,168.2 145.7,166.0 141.3,163.8 137.0,161.7 132.7,159.5 128.3,157.3 124.0,155.1 119.7,152.9 115.3,150.8 111.0,148.6 106.7,146.4 102.3,144.2 98.0,142.1 93.7,139.9 89.3,137.7 85.0,135.5 80.7,133.3 76.3,131.2 72.0,129.0 67.7,126.8 63.3,124.6' fill='#b9a4f5' fill-opacity='.55'/><polyline points='33.0,196.3 36.9,185.9 40.8,175.8 44.7,166.1 48.6,156.8 52.5,147.8 56.4,139.1 60.3,130.8 64.2,122.9 68.1,115.3 72.0,108.1 75.9,101.2 79.8,94.6 83.7,88.5 87.6,82.6 91.5,77.2 95.4,72.0 99.3,67.3 103.2,62.9 107.1,58.8 111.0,55.1 114.9,51.7 118.8,48.7 122.7,46.1 126.6,43.8 130.5,41.8 134.4,40.3 138.3,39.0 142.2,38.1 146.1,37.6 150.0,37.4 153.9,37.6 157.8,38.1 161.7,39.0 165.6,40.3 169.5,41.8 173.4,43.8 177.3,46.1 181.2,48.7 185.1,51.7 189.0,55.1 192.9,58.8 196.8,62.9 200.7,67.3 204.6,72.0 208.5,77.2 212.4,82.6 216.3,88.5 220.2,94.6 224.1,101.2 228.0,108.1 231.9,115.3 235.8,122.9 239.7,130.8 243.6,139.1 247.5,147.8 251.4,156.8 255.3,166.1 259.2,175.8 263.1,