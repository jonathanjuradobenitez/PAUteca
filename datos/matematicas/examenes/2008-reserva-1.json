4 112.4,79.5 114.4,78.7 116.3,77.9 118.2,77.1 120.1,76.3 122.1,75.5 124.0,74.7 125.9,74.0 127.9,73.2 129.8,72.5 131.7,71.8 133.6,71.1 135.6,70.4 137.5,69.7 139.4,69.0 141.3,68.4 143.3,67.7 145.2,67.1 147.1,66.4 149.0,65.8 151.0,65.2 152.9,64.5 154.8,63.9 156.7,63.3 158.7,62.7 160.6,62.2 162.5,61.6 164.4,61.0 166.4,60.4 168.3,59.9 170.2,59.3 172.1,58.8 174.1,58.2 176.0,57.7 177.9,57.2 179.9,56.6 181.8,56.1 183.7,55.6 185.6,55.1 187.6,54.6 189.5,54.1 191.4,53.6 193.3,53.1 195.3,52.6 197.2,52.1 199.1,51.7 201.0,51.2 203.0,50.7 204.9,50.2 206.8,49.8 208.7,49.3 210.7,48.9 212.6,48.4 214.5,48.0 216.4,47.5 218.4,47.1 220.3,46.6 222.2,46.2 224.1,45.8 226.1,45.3 228.0,44.9 229.9,44.5 231.9,44.1 233.8,43.6 235.7,43.2 237.6,42.8 239.6,42.4 241.5,42.0 243.4,41.6 245.3,41.2 247.3,40.8 249.2,40.4 251.1,40.0 253.0,39.6 255.0,39.2 256.9,38.8 258.8,38.5 260.7,38.1 262.7,37.7 264.6,37.3 266.5,36.9 268.4,36.6 270.4,36.2 272.3,35.8 274.2,35.5 276.1,35.1 278.1,34.7 280.0,34.4' fill='none' stroke='#f0a30a' stroke-width='2'/><circle cx='193.3' cy='53.1' r='3.5' fill='#e8487a'/><text x='185.3' y='69.1'>(1,1)</text><circle cx='48.9' cy='163.4' r='3.5' fill='#e8487a'/><text x='14.9' y='159.4'>(0,0)</text><text x='251.1' y='50.9' fill='#2f6df0' font-size='11'>√x</text><text x='243.9' y='31.0' fill='#f0a30a' font-size='11'>∛x</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 163.4H294.0M48.9 194.0V8.0'/></g><line x1='193.3' y1='160.4' x2='193.3' y2='166.4' stroke='currentColor'/><text x='190.3' y='177.4' font-size='10'>1</text><line x1='45.9' y1='53.1' x2='51.9' y2='53.1' stroke='currentColor'/><text x='32.9' y='57.1' font-size='10'>1</text></svg></div>\\[A=\\int_0^1\\left(x^{1/3}-x^{1/2}\\right)dx=\\Bigl[\\frac34x^{4/3}-\\frac23x^{3/2}\\Bigr]_0^1=\\frac34-\\frac23=\\frac1{12}\\]<div class='res'>Área \\(=\\dfrac1{12}\\ u^2\\)</div></div>"
