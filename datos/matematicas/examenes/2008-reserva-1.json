  {
   "id": "matematicas-2008-reserva-1-7",
   "n": 7,
   "num": 3,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Dadas las matrices \\(A=\\begin{pmatrix}1&1&1\\\\0&1&0\\\\1&2&2\\end{pmatrix}\\), \\(B=\\begin{pmatrix}1&0\\\\0&-1\\\\2&1\\end{pmatrix}\\) y \\(C=\\begin{pmatrix}-2&0&-1\\\\1&-1&1\\end{pmatrix}\\), calcula la matriz \\(P\\) que verifica \\(AP-B=C^T\\) (\\(C^T\\) es la matriz traspuesta de \\(C\\)).",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>\\(AP=C^t+B\\). Si \\(A\\) es invertible, \\(P=A^{-1}(C^t+B)\\).</p>\\[|A|=\\begin{vmatrix}1&1&1\\\\0&1&0\\\\1&2&2\\end{vmatrix}\\]\\[=\\bigl(2+0+0\\bigr)-\\bigl(1+0+0\\bigr)\\]\\[=1\\]<p>Como \\(|A|\\neq0\\), existe la inversa: \\(A^{-1}=\\dfrac1{|A|}(\\operatorname{Adj}A)^t\\).</p>\\[\\operatorname{Adj}A=\\begin{pmatrix}2 & 0 & -1\\\\0 & 1 & -1\\\\-1 & 0 & 1\\end{pmatrix}\\Rightarrow A^{-1}=\\begin{pmatrix}2 & 0 & -1\\\\0 & 1 & 0\\\\-1 & -1 & 1\\end{pmatrix}\\]\\[C^t+B=\\begin{pmatrix}-2 & 1\\\\0 & -1\\\\-1 & 1\\end{pmatrix}+\\begin{pmatrix}1 & 0\\\\0 & -1\\\\2 & 1\\end{pmatrix}=\\begin{pmatrix}-1 & 1\\\\0 & -2\\\\1 & 2\\end{pmatrix}\\]\\[P=\\begin{pmatrix}2 & 0 & -1\\\\0 & 1 & 0\\\\-1 & -1 & 1\\end{pmatrix}\\begin{pmatrix}-1 & 1\\\\0 & -2\\\\1 & 2\\end{pmatrix}=\\begin{pmatrix}-3 & 0\\\\0 & -2\\\\2 & 3\\end{pmatrix}\\]<div class='res'>\\(P=\\begin{pmatrix}-3 & 0\\\\0 & -2\\\\2 & 3\\end{pmatrix}\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "matrices",
     "tipo": "ecmat",
     "apartados": ""
    },
    {
     "tema": "matrices",
     "tipo": "inv",
     "apartados": ""
    }
   ],
   "origen": {
    "documento": "MAT-2008-RESERVA_1.pdf"
   },
   "dificultad": null,
