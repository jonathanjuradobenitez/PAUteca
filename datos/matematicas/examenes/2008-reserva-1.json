  {
   "id": "matematicas-2008-reserva-1-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sea \\(g:(0,+\\infty)\\to\\mathbb R\\) la función dada por \\(g(x)=\\ln x\\) (\\(\\ln\\) denota logaritmo neperiano).",
    "apartados": [
     "(0,75 p.) Justifica que la recta de ecuación \\(y=\\frac1ex\\) es la recta tangente a la gráfica de \\(g\\) en el punto de abscisa \\(x=e\\).",
     "(1,75 p.) Calcula el área del recinto limitado por la gráfica de \\(g\\), el eje de abscisas y la recta tangente del apartado anterior."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[g(e)=\\ln e=1,\\qquad g'(x)=\\frac1x\\Rightarrow g'(e)=\\frac1e\\]\\[y-1=\\frac1e(x-e)\\iff y=\\frac xe\\]<div class='res'>La tangente en \\(x=e\\) es \\(y=\\frac1ex\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>El recinto es el triángulo bajo la tangente entre \\(x=0\\) y \\(x=e\\), quitando la parte bajo \\(\\ln x\\) entre \\(x=1\\) y \\(x=e\\) (donde \\(\\ln x\\geq0\\)):</p><div style='overflow-x:auto'><svg viewBox='0 0 300 190' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='41.1,125.0 43.5,124.1 45.9,123.1 48.2,122.2 50.6,121.2 53.0,120.3 55.4,119.4 57.8,118.4 60.2,117.5 62.6,116.6 65.0,115.6 67.3,114.7 69.7,113.8 72.1,112.8 74.5,111.9 76.9,110.9 79.3,110.0 81.7,109.1 84.1,108.1 86.4,107.2 88.8,106.2 91.2,105.3 93.6,104.4 96.0,103.4 98.4,102.5 100.8,101.6 103.2,100.6 105.5,99.7 107.9,98.8 110.3,97.8 112.7,96.9 115.1,95.9 117.5,95.0 119.9,94.1 122.3,93.1 124.6,92.2 127.0,91.2 129.4,90.3 131.8,89.4 134.2,88.4 136.6,87.5 139.0,86.6 141.4,85.6 143.8,84.7 146.1,83.8 148.5,82.8 150.9,81.9 153.3,80.9 155.7,80.0 158.1,79.1 160.5,78.1 162.9,77.2 165.2,76.2 167.6,75.3 170.0,74.4 172.4,73.4 174.8,72.5 177.2,71.6 179.6,70.6 182.0,69.7 184.3,68.8 186.7,67.8 189.1,66.9 191.5,65.9 193.9,65.0 196.3,64.1 198.7,63.1 201.1,62.2 203.4,61.2 205.8,60.3 208.2,59.4 210.6,58.4 213.0,57.5 215.4,56.6 217.8,55.6 220.2,54.7 222.5,53.8 224.9,52.8 227.3,51.9 229.7,50.9 232.1,50.0 232.1,50.0 229.7,50.9 227.3,51.9 224.9,52.9 222.5,53.8 220.2,54.8 217.8,55.8 215.4,56.9 213.0,57.9 210.6,59.0 208.2,60.0 205.8,61.1 203.4,62.2 201.1,63.3 198.7,64.4 196.3,65.6 193.9,66.7 191.5,67.9 189.1,69.1 186.7,70.3 184.3,71.6 182.0,72.8 179.6,74.1 177.2,75.4 174.8,76.8 172.4,78.1 170.0,79.5 167.6,80.9 165.2,82.3 162.9,83.8 160.5,85.3 158.1,86.8 155.7,88.3 153.3,89.9 150.9,91.5 148.5,93.2 146.1,94.8 143.8,96.6 141.4,98.3 139.0,100.1 136.6,102.0 134.2,103.9 131.8,105.8 129.4,107.8 127.0,109.9 124.6,112.0 122.3,114.2 119.9,116.4 117.5,118.7 115.1,121.1 112.7,123.6 110.3,125.0 107.9,125.0 105.5,125.0 103.2,125.0 100.8,125.0 98.4,125.0 96.0,125.0 93.6,125.0 91.2,125.0 88.8,125.0 86.4,125.0 84.1,125.0 81.7,125.0 79.3,125.0 76.9,125.0 74.5,125.0 72.1,125.0 69.7,125.0 67.3,125.0 65.0,125.0 62.6,125.0 60.2,125.0 57.8,125.0 55.4,125.0 53.0,125.0 50.6,125.0 48.2,125.0 45.9,125.0 43.5,125.0 41.1,125.0' fill='#b9a4f5' fill-opacity='.55'/><polyline points='72.7,184.9 75.2,179.2 77.7,173.9 80.2,168.9 82.7,164.3 85.2,159.9 87.7,155.7 90.2,151.8 92.7,148.1 95.2,144.5 97.7,141.2 100.2,137.9 102.7,134.8 105.2,131.8 107.8,128.9 110.3,126.2 112.8,123.5 115.3,120.9 117.8,118.5 120.3,116.0 122.8,113.7 125.3,111.4 127.8,109.2 130.3,107.1 132.8,105.0 135.3,103.0 137.8,101.0 140.3,99.1 142.8,97.3 145.3,95.4 147.8,93.7 150.3,91.9 152.8,90.2 155.3,88.6 157.8,86.9 160.3,85.3 162.8,83.8 165.3,82.3 167.8,80.8 170.3,79.3 172.8,77.9 175.3,76.4 177.8,75.1 180.3,73.7 182.9,72.4 185.4,71.0 187.9,69.8 190.4,68.5 192.9,67.2 195.4,66.0 197.9,64.8 200.4,63.6 202.9,62.5 205.4,61.3 207.9,60.2 210.4,59.0 212.9,57.9 215.4,56.9 217.9,55.8 220.4,54.7 222.9,53.7 225.4,52.7 227.9,51.7 230.4,50.7 232.9,49.7 235.4,48.7 237.9,47.7 240.4,46.8 242.9,45.9 245.4,44.9 247.9,44.0 250.4,43.1 252.9,42.2 255.4,41.3 258.0,40.5 260.5,39.6 263.0,38.8 265.5,37.9 268.0,37.1 270.5,36.3 273.0,35.5' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='27.0,130.5 150.0,82.2 273.0,33.9' fill='none' stroke='#f0a30a' stroke-width='2'/><circle cx='232.1' cy='50.0' r='3.5' fill='#e8487a'/><text x='226.1' y='42.0'>(e,1)</text><circle cx='111.4' cy='125.0' r='3.5' fill='#e8487a'/><text x='107.4' y='139.0'>1</text><text x='248.4' y='27.5' fill='#f0a30a' font-size='10'>y=x/e</text><text x='251.9' y='59.0' fill='#2f6df0' font-size='10'>ln x</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 125.0H294.0M41.1 184.0V8.0'/></g><line x1='181.6' y1='122.0' x2='181.6' y2='128.0' stroke='currentColor'/><text x='178.6' y='139.0' font-size='10'>2</text><line x1='251.9' y1='122.0' x2='251.9' y2='128.0' stroke='currentColor'/><text x='248.9' y='139.0' font-size='10'>3</text><line x1='38.1' y1='50.0' x2='44.1' y2='50.0' stroke='currentColor'/><text x='25.1' y='54.0' font-size='10'>1</text></svg></div><p>\\(\\int\\ln x\\,dx=x\\ln x-x\\) (por partes, \\(u=\\ln x\\), \\(dv=dx\\)).</p>\\[A=\\int_0^e\\frac xe\\,dx-\\int_1^e\\ln x\\,dx=\\frac e2-\\Bigl[x\\ln x-x\\Bigr]_1^e=\\frac e2-\\bigl(0-(-1)\\bigr)=\\frac e2-1\\]<div class='res'>Área \\(=\\dfrac e2-1\\approx0{,}359\\ u^2\\)</div></div>"
    }
   ],
   "clasificacion": [
