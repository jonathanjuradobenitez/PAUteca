   "puntos": "2,5",
   "enunciado": {
    "intro": "Dados los puntos \\(A(2,1,1)\\) y \\(B(0,0,1)\\), halla los puntos \\(C\\) en el eje \\(OX\\) tales que el área del triángulo de vértices \\(A\\), \\(B\\) y \\(C\\) es 2.",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>\\(C(c,0,0)\\). Área \\(=\\frac12|\\overrightarrow{BA}\\times\\overrightarrow{BC}|\\), con \\(\\overrightarrow{BA}=(2,1,0)\\) y \\(\\overrightarrow{BC}=(c,0,-1)\\):</p>\\[\\overrightarrow{BA}\\times\\overrightarrow{BC}=\\begin{vmatrix}\\vec i&\\vec j&\\vec k\\\\2&1&0\\\\c&0&-1\\end{vmatrix}=(-1,\\,2,\\,-c)\\]\\[\\frac12\\sqrt{1+4+c^2}=2\\iff5+c^2=16\\iff c=\\pm\\sqrt{11}\\]<div class='f3d' data-f='{\"az\":-25,\"el\":28,\"p\":[[\"poly\",[[2,1,1],[0,0,1],[3.317,0,0]],\"#f59e0b\",\"#b45309\"],[\"poly\",[[2,1,1],[0,0,1],[-3.317,0,0]],\"#f59e0b\",\"#b45309\"],[\"line\",[-4,0,0],[4,0,0],\"#94a3b8\",2.2,false],[\"txt\",[4,0,0],\"OX\",\"#94a3b8\",6,0],[\"pt\",[2,1,1],\"A\",7,-6],[\"pt\",[0,0,1],\"B\",7,-6],[\"pt\",[3.317,0,0],\"C₁\",7,-6],[\"pt\",[-3.317,0,0],\"C₂\",7,-6]],\"ley\":[\"plano\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 300' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m08r3b4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m08r3b4d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='m08r3b4g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#64748b'/></marker><marker id='m08r3b4r' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#2563eb'/></marker></defs><polygon points='256.6,116.6 139.2,72.9 233.1,226.5' fill='#f59e0b' fill-opacity='.26' stroke='#b45309' stroke-width='1.2'/><polygon points='256.6,116.6 139.2,72.9 45.3,37.5' fill='#f59e0b' fill-opacity='.26' stroke='#b45309' stroke-width='1.2'/><line x1='26.0' y1='18.0' x2='252.5' y2='246.0' stroke='#94a3b8' stroke-width='2.2'/><text x='258.5' y='246.0