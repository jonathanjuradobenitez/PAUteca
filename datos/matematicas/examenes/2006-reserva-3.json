\\ -1,\\ -1)\\) es perpendicular a \\(\\vec d\\): \\(-2\\cdot(-2)+3\\cdot(-1)+(-1)=0\\) ✓.</i></div>"}],"clasificacion":[{"tema":"geom","tipo":"ecs","apartados":"a"},{"tema":"geom","tipo":"simet","apartados":"b"}],"origen":{"documento":"MAT-2006-RESERVA_3.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"}]}