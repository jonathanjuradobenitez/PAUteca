    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>Un plano perpendicular a la recta \\(s\\) tiene por normal su dirección: \\(\\vec n=\\vec d_s=(0,0,1)\\), es decir, \\(z=D\\). Como contiene a \\(r\\) (que pasa por \\(O\\)): \\(D=0\\).</p><div class='f3d' data-f='{\"az\":35,\"el\":38,\"p\":[[\"poly\",[[2.1,-2.6,0.0],[2.1,2.6,0.0],[-0.6,2.6,0.0],[-0.6,-2.6,0.0]],\"#8b5cf6\",\"#7c3aed\"],[\"txt\",[-0.6,2.6,0.0],\"π\",\"#7c3aed\",4,0],[\"line\",[0.0,-2.4,0.0],[0.0,2.4,0.0],\"#2563eb\",2.2,false],[\"txt\",[0.0,2.4,0.0],\"r\",\"#2563eb\",6,0],[\"line\",[1.0,0.0,-1.8],[1.0,0.0,1.8],\"#2563eb\",2.2,false],[\"txt\",[1.0,0.0,1.8],\"s\",\"#2563eb\",6,0],[\"vec\",[1,0,0.4],[1.0,0.0,1.4],\"#16a34a\",\"d_s\",4,-4],[\"vec\",[0,1.2,0],[0.0,1.2,1.2],\"#dc2626\",\"n\",4,-4],[\"line\",[1.0,0.0,0.25],[1.0,0.25,0.25],\"#475569\",1.3,false],[\"line\",[1.0,0.25,0.25],[1.0,0.25,0.0],\"#475569\",1.3,false],[\"pt\",[1,0,0],\"S\",8,12]],\"ley\":[\"plano\",\"recta\",\"vector normal\",\"vector director\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 409 230' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='n528n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='n528d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='n528g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#64748b'/></marker><marker id='n528r' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#2563eb'/></marker></defs><polygon points='26.0,85.5 237.2,176.6 314.0,109.1 102.8,18.0' fill='#8b5cf6' fill-opacity='.26' stroke='#7c3aed' stroke-width='1.2'/><text x='318.0' y='109.1' fill='#7c3aed' font-weight='700' font-style='italic'>π</text