  {
   "id": "matematicas-2003-junio-5",
   "n": 5,
   "num": 1,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Dadas la parábola de ecuación \\(y=1+x^2\\) y la recta de ecuación \\(y=1+x\\), se pide:",
    "apartados": [
     "(1,5 p.) Área de la región limitada por la recta y la parábola.",
     "(1 p.) Ecuación de la recta paralela a la dada que es tangente a la parábola."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[1+x^2=1+x\\iff x^2-x=0\\iff x=0\\ \\text{ o }\\ x=1\\]<p>Entre 0 y 1 la recta va por encima (\\(x\\geq x^2\\)):</p>\\[A=\\int_0^1(x-x^2)\\,dx=\\Bigl[\\frac{x^2}2-\\frac{x^3}3\\Bigr]_0^1=\\frac16\\]<div class='res'>Área \\(=\\dfrac16\\ u^2\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>Pendiente 1: \\(f'(x)=2x=1\\iff x=\\frac12\\), punto \\(\\left(\\frac12,\\frac54\\right)\\):</p>\\[y-\\frac54=x-\\frac12\\]<div style='overflow-x:auto'><svg viewBox='0 0 300 200' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='100.0,140.0 102.5,138.3 105.0,136.7 107.5,135.0 110.0,133.3 112.5,131.7 115.0,130.0 117.5,128.3 120.0,126.7 122.5,125.0 125.0,123.3 127.5,121.7 130.0,120.0 132.5,118.3 135.0,116.7 137.5,115.0 140.0,113.3 142.5,111.7 145.0,110.0 147.5,108.3 150.0,106.7 152.5,105.0 155.0,103.3 157.5,101.7 160.0,100.0 162.5,98.3 165.0,96.7 167.5,95.0 170.0,93.3 172.5,91.7 175.0,90.0 177.5,88.3 180.0,86.7 182.5,85.0 185.0,83.3 187.5,81.7 190.0,80.0 192.5,78.3 195.0,76.7 197.5,75.0 200.0,73.3 200.0,73.3 197.5,76.6 195.0,79.8 192.5,83.0 190.0,86.0 187.5,89.0 185.0,91.8 182.5,94.6 180.0,97.3 177.5,100.0 175.0,102.5 172.5,105.0 170.0,107.3 167.5,109.6 165.0,111.8 162.5,114.0 160.0,116.0 157.5,118.0 155.0,119.8 152.5,121.6 150.0,123.3 147.5,125.0 145.0,126.5 142.5,128.0 140.0,129.3 137.5,130.6 135.0,131.8 132.5,133.0 130.0,134.0 127.5,135.0 125.0,135.8 122.5,136.6 120.0,137.3 117.5,138.0 115.0,138.5 112.5,139.0 110.0,139.3 107.5,139.6 105.0,139.8 102.5,140.0 100.0,140.0' fill='#b9a4f5' fill-opacity='.55'/><polyline points='20.0,97.3 23.6,101.1 27.2,104.6 30.8,108.0 34.3,111.3 37.9,114.3 41.5,117.2 45.1,119.9 48.7,122.4 52.2,124.8 55.8,127.0 59.4,129.0 63.0,130.9 66.6,132.6 70.2,134.1 73.8,135.4 77.3,136.6 80.9,137.6 84.5,138.4 88.1,139.1 91.7,139.5 95.2,139.8 98.8,140.0 102.4,140.0 106.0,139.8 109.6,139.4 113.2,138.8 116.8,138.1 120.3,137.2 123.9,136.2 127.5,135.0 131.1,133.6 134.7,132.0 138.3,130.2 141.8,128.3 145.4,126.2 149.0,124.0 152.6,121.6 156.2,119.0 159.8,116.2 163.3,113.3 166.9,110.1 170.5,106.9 174.1,103.4 177.7,99.8 181.3,96.0 184.8,92.0 188.4,87.9 192.0,83.6 195.6,79.1 199.2,74.4 202.8,69.6 206.3,64.6 209.9,59.5 213.5,54.1 217.1,48.6 220.7,42.9 224.3,37.1 227.8,31.1 231.4,24.9 235.0,18.5' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='40.0,180.0 160.0,100.0 280.0,20.0' fill='none' stroke='#f0a30a' stroke-width='2'/><polyline points='80.0,170.0 180.0,103.3 280.0,36.7' fill='none' stroke='#16a34a' stroke-width='2'/><circle cx='150.0' cy='123.3' r='3.5' fill='#e8487a'/><text x='156.0' y='137.3'>(½, 5/4)</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 206.7H294.0M100.0 194.0V8.0'/></g><line x1='200.0' y1='203.7' x2='200.0' y2='209.7' stroke='currentColor'/><text x='197.0' y='220.7' font-size='10'>1</text><line x1='97.0' y1='140.0' x2='103.0' y2='140.0' stroke='currentColor'/><text x='84.0' y='144.0' font-size='10'>1</text><line x1='97.0' y1='73.3' x2='103.0' y2='73.3' stroke='currentColor'/><text x='84.0' y='77.3' font-size='10'>2</text></svg></div><div class='res'>\\(y=x+\\dfrac34\\)</div></div>"
    }
