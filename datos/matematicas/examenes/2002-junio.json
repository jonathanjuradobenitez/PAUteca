  {
   "id": "matematicas-2002-junio-8",
   "n": 8,
   "num": 4,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Calcula el área del triángulo de vértices \\(A(1,1,2)\\), \\(B(1,0,-1)\\) y \\(C(1,-3,2)\\).",
    "apartados": []
   },
   "solucion": [
