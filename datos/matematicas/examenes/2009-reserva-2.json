  {
   "id": "matematicas-2009-reserva-2-7",
   "n": 7,
   "num": 3,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sean las matrices \\(A=\\begin{pmatrix}1&-2&1\\\\-2&-1&1\\\\1&0&-1\\end{pmatrix}\\), \\(B=\\begin{pmatrix}3&1&0\\\\-1&2&1\\end{pmatrix}\\) y \\(C=\\begin{pmatrix}-2&1\\\\1&-2\\\\0&3\\end{pmatrix}\\). Determina la matriz \\(X\\) que verifica \\(AX-B^t=2C\\) (\\(B^t\\) es la matriz traspuesta de \\(B\\)).",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>\\(AX=2C+B^t\\). Si \\(A\\) es invertible, \\(X=A^{-1}(2C+B^t)\\).</p>\\[|A|=\\begin{vmatrix}1&-2&1\\\\-2&-1&1\\\\1&0&-1\\end{vmatrix}\\]\\[=\\bigl(1-2+0\\bigr)-\\bigl(-1+0-4\\bigr)\\]\\[=4\\]<p>Como \\(|A|\\neq0\\), existe la inversa: \\(A^{-1}=\\dfrac1{|A|}(\\operatorname{Adj}A)^t\\).</p>\\[\\operatorname{Adj}A=\\begin{pmatrix}1 & -1 & 1\\\\-2 & -2 & -2\\\\-1 & -3 & -5\\end{pmatrix}\\Rightarrow A^{-1}=\\frac1{4}\\begin{pmatrix}1 & -2 & -1\\\\-1 & -2 & -3\\\\1 & -2 & -5\\end{pmatrix}=\\begin{pmatrix}\\frac{1}{4} & - \\frac{1}{2} & - \\frac{1}{4}\\\\- \\frac{1}{4} & - \\frac{1}{2} & - \\frac{3}{4}\\\\\\frac{1}{4} & - \\frac{1}{2} & - \\frac{5}{4}\\end{pmatrix}\\]\\[2C+B^t=\\begin{pmatrix}-4 & 2\\\\2 & -4\\\\0 & 6\\end{pmatrix}+\\begin{pmatrix}3 & -1\\\\1 & 2\\\\0 & 1\\end{pmatrix}=\\begin{pmatrix}-1 & 1\\\\3 & -2\\\\0 & 7\\end{pmatrix}\\]\\[X=\\begin{pmatrix}\\frac{1}{4} & - \\frac{1}{2} & - \\frac{1}{4}\\\\- \\frac{1}{4} & - \\frac{1}{2} & - \\frac{3}{4}\\\\\\frac{1}{4} & - \\frac{1}{2} & - \\frac{5}{4}\\end{pmatrix}\\begin{pmatrix}-1 & 1\\\\3 & -2\\\\0 & 7\\end{pmatrix}=\\begin{pmatrix}- \\frac{7}{4} & - \\frac{1}{2}\\\\- \\frac{5}{4} & - \\frac{9}{2}\\\\- \\frac{7}{4} & - \\frac{15}{2}\\end{pmatrix}\\]<div class='res'>\\(X=\\begin{pmatrix}- \\frac{7}{4} & - \\frac{1}{2}\\\\- \\frac{5}{4} & - \\frac{9}{2}\\\\- \\frac{7}{4} & - \\frac{15}{2}\\end{pmatrix}\\)</div></div>"
    }
   ],
   "clasificacion": [
