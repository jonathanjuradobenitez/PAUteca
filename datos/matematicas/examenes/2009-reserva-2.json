  {
   "id": "matematicas-2009-reserva-2-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sea \\(f\\) la función definida por \\(f(x)=\\dfrac x{\\sqrt{4-9x^4}}\\). Halla la primitiva \\(F\\) de \\(f\\) que cumple \\(F(0)=3\\). (Sugerencia: utiliza el cambio de variable \\(t=\\frac32x^2\\).)",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>Cambio \\(t=\\frac32x^2\\): \\(dt=3x\\,dx\\Rightarrow x\\,dx=\\frac{dt}3\\), y \\(9x^4=4t^2\\), así que \\(\\sqrt{4-9x^4}=\\sqrt{4-4t^2}=2\\sqrt{1-t^2}\\).</p>\\[\\int\\frac x{\\sqrt{4-9x^4}}\\,dx=\\int\\frac{dt/3}{2\\sqrt{1-t^2}}=\\frac16\\int\\frac{dt}{\\sqrt{1-t^2}}=\\frac16\\,\\mathrm{arcsen}\\,t+C=\\frac16\\,\\mathrm{arcsen}\\left(\\frac32x^2\\right)+C\\]<p>\\(F(0)=\\frac16\\,\\mathrm{arcsen}\\,0+C=C=3\\).</p><div class='res'>\\(F(x)=\\dfrac16\\,\\mathrm{arcsen}\\left(\\dfrac32x^2\\right)+3\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "integ",
     "tipo": "cambio",
     "apartados": ""
    },
    {
     "tema": "integ",
     "tipo": "pcond",
     "apartados": ""
    }
   ],
