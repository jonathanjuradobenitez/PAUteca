font-weight='700'>S</text><circle cx='120.4' cy='68.4' r='3.8' fill='#e8487a'/><text x='102.4' y='62.4' font-weight='700'>M</text><line x1='24' y1='270' x2='32.0' y2='281.2' stroke='#64748b' stroke-width='1.2'/><text x='31.8' y='289.1' fill='#64748b' font-size='10'>x</text><line x1='24' y1='270' x2='37.9' y2='263.5' stroke='#64748b' stroke-width='1.2'/><text x='39.7' y='265.3' fill='#64748b' font-size='10'>y</text><line x1='24' y1='270' x2='24.0' y2='260.6' stroke='#64748b' stroke-width='1.2'/><text x='21.0' y='261.3' fill='#64748b' font-size='10'>z</text><g transform='translate(56.0,292)'><rect x='0' y='-8' width='12' height='9' fill='#8b5cf6' fill-opacity='.4' stroke='#7c3aed'/><text x='18' y='0' font-size='10'>plano</text></g><g transform='translate(106.5,292)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#2563eb' stroke-width='2'/><text x='18' y='0' font-size='10'>recta</text></g><g transform='translate(157.0,292)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#16a34a' stroke-width='2.4'/><text x='18' y='0' font-size='10'>vector director</text></g><g transform='translate(260.5,292)'><circle cx='6' cy='-4' r='3.8' fill='#e8487a'/><text x='18' y='0' font-size='10'>puntos</text></g></svg><p class='mut' style='font-size:.8rem;margin:.2rem 0;text-align:center'>Figura interactiva: arrástrala para girarla en 3D.</p></div><div class='res'>Área del cuadrado \\(=\\dfrac{36}5=7{,}2\\ u^2\\)</div></div>"}],"clasificacion":[{"tema":"geom","tipo":"pos","apartados":"a"},{"tema":"geom","tipo":"ecs","apartados":"a"},{"tema":"geom","tipo":"dist","apartados":"b"},{"tema":"geom","tipo":"area","apartados":"b"}],"origen":{"documento":"MAT-2016-JUNIO.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"}]}