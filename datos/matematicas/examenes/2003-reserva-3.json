   "puntos": "2,5",
   "enunciado": {
    "intro": "En la figura adjunta puedes ver representada en el intervalo \\([0,2]\\) la gráfica de la parábola de ecuación \\(y=x^2/4\\). Halla el valor de \\(m\\) para el que las áreas de las superficies rayadas son iguales.<div style='overflow-x:auto'><svg viewBox='0 0 300 170' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='144.8,113.6 146.7,112.6 148.6,111.7 150.5,110.8 152.4,109.8 154.3,108.8 156.2,107.8 158.1,106.8 160.1,105.8 162.0,104.8 163.9,103.7 165.8,102.6 167.7,101.5 169.6,100.4 171.5,99.3 173.4,98.2 175.3,97.0 177.2,95.8 179.1,94.6 181.0,93.4 182.9,92.2 184.8,91.0 186.7,89.7 188.7,88.4 190.6,87.1 192.5,85.8 194.4,84.5 196.3,83.2 198.2,81.8 200.1,80.4 202.0,79.0 202.0,138.2 200.1,138.2 198.2,138.2 196.3,138.2 194.4,138.2 192.5,138.2 190.6,138.2 188.7,138.2 186.7,138.2 184.8,138.2 182.9,138.2 181.0,138.2 179.1,138.2 177.2,138.2 175.3,138.2 173.4,138.2 171.5,138.2 169.6,138.2 167.7,138.2 165.8,138.2 163.9,138.2 162.0,138.2 160.1,138.2 158.1,138.2 156.2,138.2 154.3,138.2 152.4,138.2 150.5,138.2 148.6,138.2 146.7,138.2 144.8,138.2' fill='#b9a4f5' fill-opacity='.55'/><polygon points='202.0,39.7 203.6,39.7 205.1,39.7 206.7,39.7 208.2,39.7 209.8,39.7 211.4,39.7 212.9,39.7 214.5,39.7 216.0,39.7 217.6,39.7 219.2,39.7 220.7,39.7 222.3,39.7 223.8,39.7 225.4,39.7 227.0,39.7 228.5,39.7 230.1,39.7 231.6,39.7 233.2,39.7 234.8,39.7 236.3,39.7 237.9,39.7 239.4,39.7 241.0,39.7 242.6,39.7 244.1,39.7 245.7,39.7 247.2,39.7 248.8,39.7 248.8,39.7 247.2,41.2 245.7,42.6 244.1,44.1 242.6,45.5 241.0,46.9 239.4,48.4 237.9,49.8 236.3,51.2 234.8,52.5 233.2,53.9 231.6,55.3 230.1,56.6 228.5,58.0 227.0,59.3 225.4,60.6 223.8,61.9 222.3,63.2 220.7,64.5 219.2,65.8 217.6,67.0 216.0,68.3 214.5,69.5 212.9,70.7 211.4,72.0 209.8,73.2 208.2,74.4 206.7,75.5 205.1,76.7 203.6,77.9 202.0,79.0' fill='#b9a4f5' fill-opacity='.55'/><polyline points='40.8,138.2 44.3,138.2 47.7,138.1 51.2,137.9 54.7,137.7 58.1,137.5 61.6,137.2 