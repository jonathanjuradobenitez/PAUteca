0' stroke='currentColor'/><text x='37.8' y='119.0' font-size='10'>-2</text><line x1='92.8' y1='102.0' x2='92.8' y2='108.0' stroke='currentColor'/><text x='89.8' y='119.0' font-size='10'>-1</text><line x1='196.8' y1='102.0' x2='196.8' y2='108.0' stroke='currentColor'/><text x='193.8' y='119.0' font-size='10'>1</text><line x1='248.8' y1='102.0' x2='248.8' y2='108.0' stroke='currentColor'/><text x='245.8' y='119.0' font-size='10'>2</text><line x1='141.8' y1='161.7' x2='147.8' y2='161.7' stroke='currentColor'/><text x='128.8' y='165.7' font-size='10'>-2</text><line x1='141.8' y1='48.3' x2='147.8' y2='48.3' stroke='currentColor'/><text x='128.8' y='52.3' font-size='10'>2</text></svg></div><p>Entre \\(-1\\) y \\(2\\) la recta queda por encima (en \\(x=0\\): \\(2\\gt0\\)):</p>\\[A=\\int_{-1}^2\\bigl(2-x^3+3x\\bigr)dx=\\Bigl[2x-\\frac{x^4}4+\\frac{3x^2}2\\Bigr]_{-1}^2=6-\\left(-\\frac34\\right)=\\frac{27}4\\]<div class='res'>Área \\(=\\dfrac{27}4\\ u^2\\)</div></div>"}],"clasificacion":[{"tema":"funciones","tipo":"tang","apartados":"a"},{"tema":"integ","tipo":"area","apartados":"b"}],"origen":{"documento":"MAT-2009-RESERVA_3.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2009-reserva-3-7","n":7,"num":3,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Una empresa envasadora ha comprado un total de 1500 cajas de pescado en tres mercados diferentes, a un precio por caja de 30, 20 y 40 euros respectivamente. El coste total de la operación ha sido de 40500 euros. Calcula cuánto ha pagado la empresa en cada mercado, sabiendo que en el primero de ellos se ha comprado el 30 % de las cajas.","apartados":[]},"solucion":[{"titulo":"Resolución","html":"<div class='ex'><p>Sean \\(x\\), \\(y\\), \\(z\\) las cajas compradas en el primer, segundo y tercer mercado:</p>\\[\\begin{cases}x+y+z=1500\\\\30x+20y+40z=40500\\\\x=0{,}3\\cdot1500=450\\end{cases}\\]<p>Divido la segunda ecuación entre 10: \\(3x+2y+4z=4050\\).</p><p>Lo resuelvo por la regla de Cramer<i class='n' data-t='th'>Regla de Cramer: si \\(|A|\\neq0\\), cada incógnita es el cociente entre el determinante que resulta de sustituir su columna por la de los términos independientes y el determinante \\(|A|\\) de la matriz de coeficientes.</i>:</p>\\[|A|=\\begin{vmatrix}1&1&1\\\\3&2&4\\\\1&0&0\\end{vmatrix}=2\\]\\[x=\\frac{\\begin{vmatrix}1500&1&1\\\\4050&2&4\\\\450&0&0\\end{vmatrix}}{2}=\\frac{900}{2}=450\\]\\[y=\\frac{\\begin{vmatrix}1&1500&1\\\\3&4050&4\\\\1&450&0\\end{vmatrix}}{2}=\\frac{1500}{2}=750\\]\\[z=\\frac{\\begin{vmatrix}1&1&1500\\\\3&2&4050\\\\1&0&450\\end{vmatrix}}{2}=\\frac{600}{2}=300\\]<p>Lo pagado en cada mercado: \\(30\\cdot450=13500\\), \\(20\\cdot750=15000\\) y \\(40\\cdot300=12000\\) euros.</p><div class='res'>Primer mercado 13 500 €, segundo 15 000 € y tercero 12 000 € (450, 750 y 300 cajas)</div><i class='n' data-t='tp'>Comprobación: \\(13500+15000+12000=40500\\) ✓.</i></div>"}],"clasificacion":[{"tema":"sistemas","tipo":"plan","apartados":""}],"origen":{"documento":"MAT-2009-RESERVA_3.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2009-reserva-3-8","n":8,"num":4,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Considera la recta \\(r\\) definida por \\(\\begin{cases}x+y=2\\\\y+z=0\\end{cases}\\) y la recta \\(s\\) que pasa por los puntos \\(A(2,1,0)\\) y \\(B(1,0,-1)\\).","apartados":["(1 p.) Estudia la posición relativa de ambas rectas.","(1,5 p.) Determina un punto \\(C\\) de la recta \\(r\\) tal que los segmentos \\(\\overline{CA}\\) y \\(\\overline{CB}\\) sean perpendiculares."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'><p>\\(r\\): con \\(y=t\\), \\(x=2-t\\), \\(z=-t\\): \\(r\\equiv(2-t,\\,t,\\,-t)\\), con \\(R(2,0,0)\\) y \\(\\vec u=(-1,1,-1)\\). \\(s\\): pasa por \\(A(2,1,0)\\) con \\(\\vec v=-\\overrightarrow{AB}=(1,1,1)\\).</p><p>Los directores no son proporcionales: se cortan o se cruzan. Con \\(\\overrightarrow{RA}=(0,1,0)\\) calculo el producto mixto por la regla de Sarrus<i class='n' data-t='th'>Regla de Sarrus: se suman los productos de la diagonal principal y de los dos triángulos con un lado paralelo a ella (en verde) y se restan los de la diagonal secundaria y sus dos triángulos (en rojo).<span style='display:block;margin:6px 0 0'><svg viewBox='0 0 206 106' width='100%' style='max-width:230px' font-family='system-ui,sans-serif'><text x='0' y='30' font-size='20' font-weight='700' fill='#17a673'>+</text><text x='0' y='86' font-size='20' font-weight='700' fill='#e8487a'>−</text><polygon points='26,10 41,25 56,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='10' r='3.6' fill='#17a673'/><circle cx='41' cy='10' r='2.2' fill='#9ca3af'/><circle cx='56' cy='10' r='2.2' fill='#9ca3af'/><circle cx='26' cy='25' r='2.2' fill='#9ca3af'/><circle cx='41' cy='25' r='3.6' fill='#17a673'/><circle cx='56' cy='25' r='2.2' fill='#9ca3af'/><circle cx='26' cy='40' r='2.2' fill='#9ca3af'/><circle cx='41' cy='40' r='2.2' fill='#9ca3af'/><circle cx='56' cy='40' r='3.6' fill='#17a673'/><polygon points='103,10 118,25 88,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='10' r='2.2' fill='#9ca3af'/><circle cx='103' cy='10' r='3.6' fill='#17a673'/><circle cx='118' cy='10' r='2.2' fill='#9ca3af'/><circle cx='88' cy='25' r='2.2' fill='#9ca3af'/><circle cx='103' cy='25' r='2.2' fill='#9ca3af'/><circle cx='118' cy='25' r='3.6' fill='#17a673'/><circle cx='88' cy='40' r='3.6' fill='#17a673'/><circle cx='103' cy='40' r='2.2' fill='#9ca3af'/><circle cx='118' cy='40' r='2.2' fill='#9ca3af'/><polygon points='180,10 150,25 165,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='10' r='2.2' fill='#9ca3af'/><circle cx='165' cy='10' r='2.2' fill='#9ca3af'/><circle cx='180' cy='10' r='3.6' fill='#17a673'/><circle cx='150' cy='25' r='3.6' fill='#17a673'/><circle cx='165' cy='25' r='2.2' fill='#9ca3af'/><circle cx='180' cy='25' r='2.2' fill='#9ca3af'/><circle cx='150' cy='40' r='2.2' fill='#9ca3af'/><circle cx='165' cy='40' r='3.6' fill='#17a673'/><circle cx='180' cy='40' r='2.2' fill='#9ca3af'/><polygon points='56,66 41,81 26,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='66' r='2.2' fill='#9ca3af'/><circle cx='41' cy='66' r='2.2' fill='#9ca3af'/><circle cx='56' cy='66' r='3.6' fill='#e8487a'/><circle cx='26' cy='81' r='2.2' fill='#9ca3af'/><circle cx='41' cy='81' r='3.6' fill='#e8487a'/><circle cx='56' cy='81' r='2.2' fill='#9ca3af'/><circle cx='26' cy='96' r='3.6' fill='#e8487a'/><circle cx='41' cy='96' r='2.2' fill='#9ca3af'/><circle cx='56' cy='96' r='2.2' fill='#9ca3af'/><polygon points='88,66 118,81 103,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='66' r='3.6' fill='#e8487a'/><circle cx='103' cy='66' r='2.2' fill='#9ca3af'/><circle cx='118' cy='66' r='2.2' fill='#9ca3af'/><circle cx='88' cy='81' r='2.2' fill='#9ca3af'/><circle cx='103' cy='81' r='2.2' fill='#9ca3af'/><circle cx='118' cy='81' r='3.6' fill='#e8487a'/><circle cx='88' cy='96' r='2.2' fill='#9ca3af'/><circle cx='103' cy='96' r='3.6' fill='#e8487a'/><circle cx='118' cy='96' r='2.2' fill='#9ca3af'/><polygon points='165,66 150,81 180,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='66' r='2.2' fill='#9ca3af'/><circle cx='165' cy='66' r='3.6' fill='#e8487a'/><circle cx='180' cy='66' r='2.2' fill='#9ca3af'/><circle cx='150' cy='81' r='3.6' fill='#e8487a'/><circle cx='165' cy='81' r='2.2' fill='#9ca3af'/><circle cx='180' cy='81' r='2.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i>:</p>\\[[\\overrightarrow{RA},\\vec u,\\vec v]=\\begin{vmatrix}0&1&0\\\\-1&1&-1\\\\1&1&1\\end{vmatrix}\\]\\[=\\bigl(0-1+0\\bigr)-\\bigl(0+0-1\\bigr)\\]\\[=0\\]<p>Son coplanarias y no paralelas: se cortan. El punto: \\((2-t,t,-t)=(2+\\mu,1+\\mu,\\mu)\\Rightarrow t=1+\\mu,\\ -t=\\mu\\Rightarrow t=\\frac12\\): \\(I\\left(\\frac32,\\frac12,-\\frac12\\right)\\).</p><div class='res'>\\(r\\) y \\(s\\) se cortan en \\(\\left(\\dfrac32,\\dfrac12,-\\dfrac12\\right)\\)</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>\\(C(2-t,\\,t,\\,-t)\\). Los segmentos son perpendiculares si \\(\\overrightarrow{CA}\\cdot\\overrightarrow{CB}=0\\):</p>\\[\\overrightarrow{CA}=(t,\\ 1-t,\\ t),\\quad\\overrightarrow{CB}=(t-1,\\ -t,\\ t-1)\\]\\[\\overrightarrow{CA}\\cdot\\overrightarrow{CB}=t(t-1)-t(1-t)+t(t-1)=3t^2-3t=3t(t-1)=0\\iff t=0\\ \\text{ o }\\ t=1\\]<div class='f3d' data-f='{\"az\":177,\"el\":44,\"p\":[[\"line\",[2.6,-0.6,0.6],[0.4,1.6,-1.6],\"#2563eb\",2.2,false],[\"txt\",[0.4,1.6,-1.6],\"r\",\"#2563eb\",6,0],[\"line\",[0.2,-0.8,-1.8],[2.6,1.6,0.6],\"#2563eb\",2.2,false],[\"txt\",[2.6,1.6,0.6],\"s\",\"#2563eb\",6,0],[\"line\",[2,0,0],[2,1,0],\"#e11d48\",1.4,false],[\"line\",[2,0,0],[1,0,-1],\"#e11d48\",1.4,false],[\"pt\",[2,1,0],\"A\",7,-6],[\"pt\",[1,0,-1],\"B\",7,-6],[\"pt\",[2,0,0],\"C₁\",7,-6],[\"pt\",[1,1,-1],\"C₂\",7,-6],[\"pt\",[1.5,0.5,-0.5],\"I\",7,-6]],\"ley\":[\"recta\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 300' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m09r3b4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m09r3b4d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='m09r3b4g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#6