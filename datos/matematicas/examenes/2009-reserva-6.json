28.8 259.2,20.8 262.1,12.7 265.0,4.3' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='20.0,45.7 150.0,45.7 280.0,45.7' fill='none' stroke='#f0a30a' stroke-width='2'/><polyline points='20.0,141.9 150.0,141.9 280.0,141.9' fill='none' stroke='#16a34a' stroke-width='2'/><text x='257.5' y='37.6' fill='#f0a30a' font-size='10'>y=4</text><text x='257.5' y='133.9' fill='#16a34a' font-size='10'>y=a</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 174.0H294.0M150.0 204.0V8.0'/></g><line x1='50.0' y1='171.0' x2='50.0' y2='177.0' stroke='currentColor'/><text x='47.0' y='188.0' font-size='10'>-2</text><line x1='100.0' y1='171.0' x2='100.0' y2='177.0' stroke='currentColor'/><text x='97.0' y='188.0' font-size='10'>-1</text><line x1='200.0' y1='171.0' x2='200.0' y2='177.0' stroke='currentColor'/><text x='197.0' y='188.0' font-size='10'>1</text><line x1='250.0' y1='171.0' x2='250.0' y2='177.0' stroke='currentColor'/><text x='247.0' y='188.0' font-size='10'>2</text><line x1='147.0' y1='141.9' x2='153.0' y2='141.9' stroke='currentColor'/><text x='134.0' y='145.9' font-size='10'>1</text><line x1='147.0' y1='45.7' x2='153.0' y2='45.7' stroke='currentColor'/><text x='134.0' y='49.7' font-size='10'>4</text></svg></div><p>Mitad derecha: entre \\(0\\) y \\(\\sqrt a\\) la franja entre \\(y=a\\) e \\(y=4\\); entre \\(\\sqrt a\\) y \\(2\\), entre la parábola e \\(y=4\\):</p>\\[\\frac A2=\\int_0^{\\sqrt a}(4-a)\\,dx+\\int_{\\sqrt a}^2(4-x^2)\\,dx=(4-a)\\sqrt a+\\Bigl[4x-\\frac{x^3}3\\Bigr]_{\\sqrt a}^2\\]\\[=4\\sqrt a-a\\sqrt a+\\frac{16}3-4\\sqrt a+\\frac{a\\sqrt a}3=\\frac{16}3-\\frac23a\\sqrt a\\]\\[A=\\frac{32}3-\\frac43a\\sqrt a=\\frac{28}3\\iff\\frac43a\\sqrt a=\\frac43\\iff a^{3/2}=1\\iff a=1\\]<div class='res'>\\(a=1\\)</div></div>"
