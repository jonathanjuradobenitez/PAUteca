   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>La parábola corta a \\(y=4\\) en \\(x=\\pm2\\) y a \\(y=a\\) en \\(x=\\pm\\sqrt a\\). El recinto es simétrico respecto de \\(OY\\) (dibujo con \\(a=1\\)):</p><div style='overflow-x:auto'><svg viewBox='0 0 300 210' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='50.0,45.7 51.7,45.7 53.3,45.7 55.0,45.7 56.7,45.7 58.3,45.7 60.0,45.7 61.7,45.7 63.3,45.7 65.0,45.7 66.7,45.7 68.3,45.7 70.0,45.7 71.7,45.7 73.3,45.7 75.0,45.7 76.7,45.7 78.3,45.7 80.0,45.7 81.7,45.7 83.3,45.7 85.0,45.7 86.7,45.7 88.3,45.7 90.0,45.7 91.7,45.7 93.3,45.7 95.0,45.7 96.7,45.7 98.3,45.7 100.0,45.7 101.7,45.7 103.3,45.7 105.0,45.7 106.7,45.7 108.3,45.7 110.0,45.7 111.7,45.7 113.3,45.7 115.0,45.7 116.7,45.7 118.3,45.7 120.0,45.7 121.7,45.7 123.3,45.7 125.0,45.7 126.7,45.7 128.3,45.7 130.0,45.7 131.7,45.7 133.3,45.7 135.0,45.7 136.7,45.7 138.3,45.7 140.0,45.7 141.7,45.7 143.3,45.7 145.0,45.7 146.7,45.7 148.3,45.7 150.0,45.7 151.7,45.7 153.3,45.7 155.0,45.7 156.7,45.7 158.3,45.7 160.0,45.7 161.7,45.7 163.3,45.7 165.0,45.7 166.7,45.7 168.3,45.7 170.0,45.7 171.7,45.7 173.3,45.7 175.0,45.7 176.7,45.7 178.3,45.7 180.0,45.7 181.7,45.7 183.3,45.7 185.0,45.7 186.7,45.7 188.3,45.7 190.0,45.7 191.7,45.7 193.3,45.7 195.0,45.7 196.7,45.7 198.3,45.7 200.0,45.7 201.7,45.7 203.3,45.7 205.0,45.7 206.7,45.7 208.3,45.7 210.0,45.7 211.7,45.7 213.3,45.7 215.0,45.7 216.7,45.7 218.3,45.7 220.0,45.7 221.7,45.7 223.3,45.7 225.0,45.7 226.7,45.7 228.3,45.7 230.0,45.7 231.7,45.7 233.3,45.7 235.0,45.7 236.7,45.7 238.3,45.7 240.0,45.7 241.7,45.7 243.3,45.7 245.0,45.7 246.7,45.7 248.3,45.7 250.0,45.7 250.0,45.7 248.3,49.9 246.7,54.1 245.0,58.2 243.3,62.2 241.7,66.2 240.0,70.0 238.3,73.9 236.7,77.6 235.0,81.3 233.3,84.9 231.7,88.4 230.0,91.8 228.3,95.2 226.7,98.5 225.0,101.8 223.3,105.0 221.7,108.1 220.0,111.1 218.3,114.1 216.7,116.9 215.0,119.8 213.3,122.5 211.7,125.2 210.0,127.8 208.3,130.3 206.7,132.8 205.0,135.2 203.3,1