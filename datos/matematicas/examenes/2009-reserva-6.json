  {
   "id": "matematicas-2009-reserva-6-3",
   "n": 3,
   "num": 3,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Se consideran las matrices \\(A=\\begin{pmatrix}-3&1\\\\2&-1\\end{pmatrix}\\) y \\(B=A-kI\\), donde \\(k\\) es una constante e \\(I\\) es la matriz identidad de orden 2.",
    "apartados": [
     "(0,75 p.) Determina los valores de \\(k\\) para los que \\(B\\) no tiene inversa.",
     "(0,5 p.) Calcula \\(B^{-1}\\) para \\(k=-1\\).",
     "(1,25 p.) Determina las constantes \\(\\alpha\\) y \\(\\beta\\) para las que se cumple \\(A^2+\\alpha A=\\beta I\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[B=A-kI=\\begin{pmatrix}-3-k&1\\\\2&-1-k\\end{pmatrix},\\qquad|B|=(3+k)(1+k)-2=k^2+4k+1\\]\\[k^2+4k+1=0\\iff k=\\frac{-4\\pm\\sqrt{12}}2=-2\\pm\\sqrt3\\]<div class='res'>\\(B\\) no tiene inversa para \\(k=-2+\\sqrt3\\) y \\(k=-2-\\sqrt3\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'>\\[B=\\begin{pmatrix}-2 & 1\\\\2 & 0\\end{pmatrix},\\qquad|B|=-2\\neq0,\\qquad B^{-1}=\\frac1{|B|}(\\operatorname{Adj}B)^t=-\\frac12\\begin{pmatrix}0 & -1\\\\-2 & -2\\end{pmatrix}=\\begin{pmatrix}0 & \\frac{1}{2}\\\\1 & 1\\end{pmatrix}\\]<div class='res'>\\(B^{-1}=\\begin{pmatrix}0 & \\frac{1}{2}\\\\1 & 1\\end{pmatrix}\\)</div></div>"
    },
    {
     "titulo": "Apartado c",
     "html": "<div class='ex'>\\[A^2=\\begin{pmatrix}-3 & 1\\\\2 & -1\\end{pmatrix}\\begin{pmatrix}-3 & 1\\\\2 & -1\\end{pmatrix}=\\begin{pmatrix}11 & -4\\\\-8 & 3\\end{pmatrix}\\]\\[A^2+\\alpha A=\\begin{pmatrix}11-3\\alpha&-4+\\alpha\\\\-8+2\\alpha&3-\\alpha\\end{pmatrix}=\\begin{pmatrix}\\beta&0\\\\0&\\beta\\end{pmatrix}\\]<p>De \\(-4+\\alpha=0\\): \\(\\alpha=4\\) (también cumple \\(-8+2\\alpha=0\\)). Entonces \\(\\beta=11-12=-1\\) y \\(3-4=-1\\) ✓.</p><div class='res'>\\(\\alpha=4\\), \\(\\beta=-1\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "matrices",
     "tipo": "det",
     "apartados": "a"
    },
    {
     "tema": "matrices",
     "tipo": "inv",
     "apartados": "a, b"
    },
    {
