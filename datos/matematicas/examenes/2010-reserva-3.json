  {
   "id": "matematicas-2010-reserva-3-4",
   "n": 4,
   "num": 4,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Considera los puntos \\(A(1,2,1)\\) y \\(B(-1,0,3)\\).",
    "apartados": [
     "(1,25 p.) Calcula las coordenadas de los puntos que dividen el segmento \\(AB\\) en tres partes iguales.",
     "(1,25 p.) Halla la ecuación del plano perpendicular al segmento \\(AB\\) y que pasa por \\(A\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'><p>\\(\\overrightarrow{AB}=(-2,-2,2)\\). Los puntos son \\(P_1=A+\\frac13\\overrightarrow{AB}\\) y \\(P_2=A+\\frac23\\overrightarrow{AB}\\):</p>\\[P_1=\\left(\\frac13,\\frac43,\\frac53\\right)\\qquad P_2=\\left(-\\frac13,\\frac23,\\frac73\\right)\\]<div class='res'>\\(P_1\\left(\\dfrac13,\\dfrac43,\\dfrac53\\right)\\) y \\(P_2\\left(-\\dfrac13,\\dfrac23,\\dfrac73\\right)\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>Su normal es \\(\\overrightarrow{AB}\\parallel(1,1,-1)\\): \\(x+y-z+D=0\\). Contiene a \\(A\\): \\(1+2-1+D=0\\iff D=-2\\).</p><div class='f3d' data-f='{\"az\":33,\"el\":8,\"p\":[[\"poly\",[[1.321,3.169,2.49],[3.169,1.321,2.49],[2.179,0.331,0.51],[0.331,2.179,0.51]],\"#8b5cf6\",\"#7c3aed\"],[\"txt\",[2.179,0.331,0.51],\"π\",\"#7c3aed\",4,0],[\"line\",[1,2,1],[-1,0,3],\"#16a34a\",2.0,false],[\"line\",[0.827,1.827,1.173],[1.039,1.615,1.173],\"#475569\",1.3,false],[\"line\",[1.039,1.615,1.173],[1.212,1.788,1.0],\"#475569\",1.3,false],[\"pt\",[1,2,1],\"A\",7,-6],[\"pt\",[-1,0,3],\"B\",7,-6],[\"pt\",[0.333,1.333,1.667],\"P₁\",7,-6],[\"pt\",[-0.333,0.667,2.333],\"P₂\",7,-6]],\"ley\":[\"plano\",\"vector director\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 300' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m10r3a4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m10r3a4d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='m10r3a4g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#64748b'/></marker><marker id='m10r3a4r' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#2563eb'/></marker></defs><polygon points='252.9,99.0 49.2,105.0 26.0,246.0 229.7,240.0' fill='#8b5cf6' fill-opacity='.26' stroke='#7c3aed' stroke-width='1.2'/><text x='30.0' y='246.0' fill='#7c3aed' font-weight='700' font-style='italic'>π</text><line x1='188.7' y1='206.5' x2='141.9' y2='18.0' stroke='#16a34a' stroke-width='2.0'/><line x1='184.6' y1='190.1' x2='161.3' y2='190.8' stroke='#475569' stroke-width='1.3'/><line x1='161.3' y1='190.8' x2='165.3' y2='207.2' stroke='#475569' stroke-width='1.3'/><circle cx='188.7' cy='206.5' r='3.8' fill='#e8487a'/><text x='195.7' y='200.5' font-weight='700'>A</text><circle cx='141.9' cy='18.0' r='3.8' fill='#e8487a'/><text x='148.9' y='12.0' font-weight='700'>B</text><circle cx='173.1' cy='143.6' r='3.8' fill='#e8487a'/><text x='180.1' y='137.6' font-weight='700'>P₁</text><circle cx='157.5' cy='80.8' r='3.8' fill='#e8487a'/><text x='164.5' y='74.8' font-weight='700'>P₂</text><line x1='24' y1='270' x2='15.3' y2='271.9' stroke='#64748b' stroke-width='1.2'/><text x='9.2' y='276.5' fill='#64748b' font-size='10'>x</text><line x1='24' y1='270' x2='37.4' y2='271.2' stroke='#64748b' stroke-width='1.2'/><text x='39.1' y='275.6' fill='#64748b' font-size='10'>y</text><line x1='24' y1='270' x2='24.0' y2='254.2' stroke='#64748b' stroke-width='1.2'/><text x='21.0' y='252.6' fill='#64748b' font-size='10'>z</text><g transform='translate(56.0,292)'><rect x='0' y='-8' width='12' height='9' fill='#8b5cf6' fill-opacity='.4' stroke='#7c3aed'/><text x='18' y='0' font-size='10'>plano</text></g><g transform='translate(106.5,292)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#16a34a' stroke-width='2.4'/><text x='18' y='0' font-size='10'>vector director</text></g><g transform='translate(210.0,292)'><circle cx='6' cy='-4' r='3.8' fill='#e8487a'/><text x='18' y='0' font-size='10'>puntos</text></g></svg><p class='mut' style='font-size:.8rem;margin:.2rem 0;text-align:center'>Figura interactiva: arrástrala para girarla en 3D.</p></div><div class='res'>\\(x+y-z-2=0\\)</div></div>"
    }
   ],
   "clasificacion": [
