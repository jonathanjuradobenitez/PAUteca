  {
   "id": "matematicas-2010-reserva-3-3",
   "n": 3,
   "num": 3,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Considera las siguientes matrices \\(A=\\begin{pmatrix}-1&2\\\\0&1\\end{pmatrix}\\) y \\(B=\\begin{pmatrix}-3&0\\\\2&-1\\end{pmatrix}\\).",
    "apartados": [
     "(0,75 p.) Calcula \\(A^{-1}\\).",
     "(1,75 p.) Resuelve la ecuación matricial \\(AXA^t-B=2I\\), donde \\(I\\) es la matriz identidad de orden 2 y \\(A^t\\) es la matriz traspuesta de \\(A\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[|A|=-1\\neq0\\Rightarrow A^{-1}=\\frac1{-1}\\begin{pmatrix}1&-2\\\\0&-1\\end{pmatrix}=\\begin{pmatrix}-1 & 2\\\\0 & 1\\end{pmatrix}\\]<div class='res'>\\(A^{-1}=\\begin{pmatrix}-1 & 2\\\\0 & 1\\end{pmatrix}\\) (coincide con \\(A\\))</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>\\(AXA^t=2I+B\\). Multiplico por \\(A^{-1}\\) por la izquierda y por \\((A^t)^{-1}=(A^{-1})^t\\) por la derecha<i class='n' data-t='err'>Cada factor se elimina con su inversa por su mismo lado.</i>:</p>\\[X=A^{-1}(2I+B)(A^{-1})^t\\]\\[2I+B=\\begin{pmatrix}-1 & 0\\\\2 & 1\\end{pmatrix},\\qquad A^{-1}(2I+B)=\\begin{pmatrix}5 & 2\\\\2 & 1\\end{pmatrix}\\]\\[X=\\begin{pmatrix}5 & 2\\\\2 & 1\\end{pmatrix}\\begin{pmatrix}-1 & 0\\\\2 & 1\\end{pmatrix}=\\begin{pmatrix}-1 & 2\\\\0 & 1\\end{pmatrix}\\]<div class='res'>\\(X=\\begin{pmatrix}-1 & 2\\\\0 & 1\\end{pmatrix}\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "matrices",
     "tipo": "inv",
     "apartados": "a"
    },
    {
     "tema": "matrices",
     "tipo": "ecmat",
     "apartados": "b"
    }
   ],
   "origen": {
    "documento": "MAT-2010-RESERVA_3.pdf"
   },
