   "revision": "borrador"
  },
  {
   "id": "matematicas-2010-reserva-3-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Considera la función \\(f:\\mathbb R\\to\\mathbb R\\) definida por \\(f(x)=x|2-x|\\).",
    "apartados": [
     "(1 p.) Esboza su gráfica.",
     "(1,5 p.) Calcula el área del recinto limitado por la gráfica de \\(f\\), el eje de abscisas y la recta de ecuación \\(x=3\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[f(x)=x|2-x|=\\begin{cases}-x^2+2x&\\text{si }x\\le2\\\\x^2-2x&\\text{si }x\\gt2\\end{cases}\\]<p>Para \\(x\\le2\\) es una parábola hacia abajo con vértice \\((1,1)\\); para \\(x\\gt2\\), una parábola hacia arriba. Corta al eje en \\(x=0\\) y \\(x=2\\).</p><div style='overflow-x:auto'><svg viewBox='0 0 300 220' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polyline points='30.8,224.8 32.8,220.3 34.8,215.9 36.8,211.5 38.8,207.3 40.8,203.1 42.8,199.0 44.7,195.0 46.7,191.1 48.7,187.2 50.7,183.5 52.7,179.8 54.7,176.2 56.7,172.7 58.6,169.3 60.6,165.9 62.6,162.7 64.6,159.5 66.6,156.4 68.6,153.4 70.6,150.5 72.5,147.6 74.5,144.9 76.5,142.2 78.5,139.6 80.5,137.1 82.5,134.7 84.5,132.3 86.4,130.1 88.4,127.9 90.4,125.8 92.4,123.8 94.4,121.9 96.4,120.1 98.4,118.3 100.3,116.6 102.3,115.0 104.3,113.5 106.3,112.1 108.3,110.8 110.3,109.5 112.3,108.3 114.2,107.3 116.2,106.3 118.2,105.3 120.2,104.5 122.2,103.7 124.2,103.1 126.2,102.5 128.2,102.0 130.1,101.6 132.1,101.2 134.1,101.0 136.1,100.8 138.1,100.7 140.1,100.7 142.1,100.8 144.0,100.9 146.0,101.2 148.0,101.5 150.0,101.9 152.0,102.4 154.0,103.0 156.0,103.7 157.9,104.4 159.9,105.2 161.9,106.2 163.9,107.2 165.9,108.2 167.9,109.4 169.9,110.7 171.8,112.0 173.8,113.4 175.8,114.9 177.8,116.5 179.8,118.1 181.8,119.9 183.8,121.7 185.8,123.6 187.7,125.6 189.7,127.7 191.7,129.9 193.7,131.3 195.7,129.0 197.7,126.6 199.7,124.1 201.6,121.5 203.6,118.8 205.6,116.1 207.6,113.2 209.6,110.3 211.6,107.3 213.6,104.2 215.5,101.1 217.5,97.8 219.5,94.5 221.5,91.1 223.5,87.6 225.5,84.0 227.5,80.3 229.4,76.6 231.4,72.7 233.4,68.8 235.4,64.8 237.4,60.7 239.4,56.5 241.4,52.3 243.3,48.0 245.3,43.5 247.3,39.0 249.3,34.4 251.3,29.8 253.3,25.0 255.3,20.2 257.3,15.3 259.2,10.3 261.2,5.2 263.2,0.0 265.2,-5.2 267.2,-10.6 269.2,-16.0' fill='none' stroke='#2f6df0' stroke-width='2'/><circle cx='139.2' cy='100.7' r='3.5' fill='#e8487a'/><text x='127.2' y='92.7'>(1,1)</text><