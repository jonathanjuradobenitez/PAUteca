  {
   "id": "matematicas-2005-reserva-3-8",
   "n": 8,
   "num": 4,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Considera las rectas \\(r\\equiv\\begin{cases}x+z-2=0\\\\x-y-1=0\\end{cases}\\) y \\(s\\equiv\\dfrac x2=y-1=\\dfrac z3\\).",
    "apartados": [
     "(1,25 p.) Halla la ecuación del plano \\(\\pi\\) que contiene a \\(s\\) y es paralelo a \\(r\\).",
     "(1,25 p.) Calcula la distancia de la recta \\(r\\) al plano \\(\\pi\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'><p>\\(r\\): con \\(x=t\\), \\(y=t-1\\), \\(z=2-t\\): \\(r\\equiv(t,\\,-1+t,\\,2-t)\\), con \\(R(0,-1,2)\\) y \\(\\vec d_r=(1,1,-1)\\). \\(s\\) pasa por \\(S(0,1,0)\\) con \\(\\vec d_s=(2,1,3)\\).</p>\\[\\vec n=\\vec d_s\\times\\vec d_r=\\begin{vmatrix}\\vec i&\\vec j&\\vec k\\\\2&1&3\\\\1&1&-1\\end{vmatrix}=(-4,\\,5,\\,1)\\parallel(4,-5,-1)\\]<p>Plano \\(4x-5y-z+D=0\\) por \\(S\\): \\(-5+D=0\\iff D=5\\).</p><div class='res'>\\(\\pi\\equiv4x-5y-z+5=0\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>\\(r\\parallel\\pi\\), así que la distancia es la de cualquier punto de \\(r\\), por ejemplo \\(R\\). <b>Recta perpendicular a </b>\\(\\pi\\)<b> por </b>\\(R\\)<b>:</b> \\((4t,\\,-1-5t,\\,2-t)\\). <b>Corte con </b>\\(\\pi\\)<b>:</b></p>\\[16t+5+25t-2+t+5=0\\iff42t+8=0\\iff t=-\\frac4{21}\\]\\[d(r,\\pi)=|\\overrightarrow{RM}|=|t|\\,|\\vec n|=\\frac4{21}\\sqrt{42}\\]<div class='f3d' data-f='{\"az\":0,\"el\":48,\"p\":[[\"line\",[-1.6,0.2,-2.4],[1.6,1.8,2.4],\"#2563eb\",2.2,false],[\"txt\",[1.6,1.8,2.4],\"s\",\"#2563eb\",6,0],[\"line\",[-1.0,-2.0,3.0],[1.0,0.0,1.0],\"#2563eb\",2.2,false],[\"txt\",[1.0,0.0,1.0],\"r\",\"#2563eb\",6,0],[\"poly\",[[2.239,2.181,3.302],[-1.034,-0.438,3.302],[-1.385,0.0,-0.29],[1.889,2.619,-0.29]],\"#8b5cf6\",\"#7c3aed\"],[\"txt\",[-1.385,0.0,-0.29],\"π\",\"#7c3aed\",4,0],[\"line\",[0,-1,2],[-0.762,-0.048,2.19],\"#e11d48\",1.6,false],[\"pt\",[0,-1,2],\"R\",7,-6],[\"pt\",[-0.762,-0.048,2.19],\"M\",7,-6]],\"ley\":[\"plano\",\"recta\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 300' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m05r3b4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m05r3b4d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='m05r3b4g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#64748b'/></marker><marker id='m05r3b4r' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#2563eb'/></marker></defs><line x1='135.6' y1='187.2' x2='215.3' y2='145.6' stroke='#2563eb' stroke-width='2.2'/><text x='221.3' y='145.6' fill='#2563eb' font-weight='700' font-style='italic'>s</text><line x1='26.0' y1='29.3' x2='125.6' y2='170.1' stroke='#2563eb' stroke-width='2.2'/><text x='131.6' y='170.1' fill='#2563eb' font-weight='700' font-style='italic'>r</text><polygon points='234.3,139.2 103.8,18.0 125.7,124.8 256.1,246.0' fill='#8b5cf6' fill-opacity='.26' stroke='#7c3aed' stroke-width='1.2'/><text x='129.7' y='124.8' fill='#7c3aed' font-weight='700' font-style='italic'>π</text><line x1='75.8' y1='99.7' x2='123.3' y2='65.1' stroke='#e11d48' stroke-width='1.6'/><circle cx='75.8' cy='99.7' r='3.8' fill='#e8487a'/><text x='82.8' y='93.7' font-weight='700'>R</text><circle cx='123.3' cy='65.1' r='3.8' fill='#e8487a'/><text x='130.3' y='59.1' font-weight='700'>M</text><line x1='24' y1='270' x2='24.0' y2='281.9' stroke='#64748b' stroke-width='1.2'/><text x='21.0' y='290.1' fill='#64748b' font-size='10'>x</text><line x1='24' y1='270' x2='40.0' y2='270.0' stroke='#64748b' stroke-width='1.2'/><text x='42.6' y='274.0' fill='#64748b' font-size='10'>y</text><line x1='24' y1='270' x2='24.0' y2='259.3' stroke='#64748b' stroke-width='1.2'/><text x='21.0' y='259.5' fill='#64748b' font-size='10'>z</text><g transform='translate(56.0,292)'><rect x='0' y='-8' width='12' height='9' fill='#8b5cf6' fill-opacity='.4' stroke='#7c3aed'/><text x='18' y='0' font-size='10'>plano</text></g><g transform='translate(106.5,292)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#2563eb' stroke-width='2'/><text x='18' y='0' font-size='10'>recta</text></g><g transform='translate(157.0,292)'><circle cx='6' cy='-4' r='3.8' fill='#e8487a'/><text x='18' y='0' font-size='10'>puntos</text></g></svg><p class='mut' style='font-size:.8rem;margin:.2rem 0;text-align:center'>Figura interactiva: arrástrala para girarla en 3D.</p></div><div class='res'>\\(d(r,\\pi)=\\dfrac{4\\sqrt{42}}{21}\\approx1{,}23\\) unidades</div><i class='n' data-t='tp'>Con la fórmula: \\(\\dfrac{|0+5-2+5|}{\\sqrt{42}}=\\dfrac8{\\sqrt{42}}=\\dfrac{4\\sqrt{42}}{21}\\) ✓.</i></div>"
    }
