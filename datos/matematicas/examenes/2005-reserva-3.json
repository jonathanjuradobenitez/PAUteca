  {
   "id": "matematicas-2005-reserva-3-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Calcula \\(\\displaystyle\\int_{-1}^0\\ln(2+x)\\,dx\\), siendo \\(\\ln\\) la función logaritmo neperiano.",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>Por partes<i class='n' data-t='th'>Integración por partes: \\(\\int u\\,dv=uv-\\int v\\,du\\).</i> con \\(u=\\ln(2+x)\\), \\(dv=dx\\) (\\(du=\\frac{dx}{2+x}\\); tomo \\(v=2+x\\), que también es primitiva de 1):</p>\\[\\int\\ln(2+x)\\,dx=(2+x)\\ln(2+x)-\\int dx=(2+x)\\ln(2+x)-x+C\\]\\[\\int_{-1}^0\\ln(2+x)\\,dx=\\Bigl[(2+x)\\ln(2+x)-x\\Bigr]_{-1}^0=2\\ln2-(0+1)=2\\ln2-1\\]<div class='res'>\\(2\\ln2-1\\approx0{,}386\\)</div></div>"
    }
   ],
   "clasificacion": [
