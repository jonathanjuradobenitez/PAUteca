  {
   "id": "matematicas-2011-reserva-4-2",
   "n": 2,
   "num": 2,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Calcula un número positivo \\(a\\), menor que 2, para que el recinto limitado por la parábola de ecuación \\(y=\\frac12x^2\\) y las dos rectas horizontales de ecuaciones \\(y=a\\) e \\(y=2\\), tenga un área de \\(\\frac{14}3\\) unidades cuadradas.",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>El recinto está dentro de la parábola, entre las rectas \\(y=a\\) e \\(y=2\\). Integro respecto de \\(y\\)<i class='n' data-t='tp'>Con rectas horizontales es más cómodo integrar en \\(y\\): a cada altura \\(y\\), la anchura del recinto es la distancia entre las dos ramas de la parábola.</i>: de \\(y=\\frac{x^2}2\\), \\(x=\\pm\\sqrt{2y}\\), y la anchura es \\(2\\sqrt{2y}\\). En el dibujo, el caso \\(a=\\frac12\\):</p><div style='overflow-x:auto'><svg viewBox='0 0 300 180' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='41.7,49.0 44.4,49.0 47.1,49.0 49.8,49.0 52.5,49.0 55.2,49.0 57.9,49.0 60.6,49.0 63.3,49.0 66.0,49.0 68.8,49.0 71.5,49.0 74.2,49.0 76.9,49.0 79.6,49.0 82.3,49.0 85.0,49.0 87.7,49.0 90.4,49.0 93.1,49.0 95.8,49.0 98.5,49.0 101.2,49.0 104.0,49.0 106.7,49.0 109.4,49.0 112.1,49.0 114.8,49.0 117.5,49.0 120.2,49.0 122.9,49.0 125.6,49.0 128.3,49.0 131.0,49.0 133.8,49.0 136.5,49.0 139.2,49.0 141.9,49.0 144.6,49.0 147.3,49.0 150.0,49.0 152.7,49.0 155.4,49.0 158.1,49.0 160.8,49.0 163.5,49.0 166.2,49.0 169.0,49.0 171.7,49.0 174.4,49.0 177.1,49.0 179.8,49.0 182.5,49.0 185.2,49.0 187.9,49.0 190.6,49.0 193.3,49.0 196.0,49.0 198.8,49.0 201.5,49.0 204.2,49.0 206.9,49.0 209.6,49.0 212.3,49.0 215.0,49.0 217.7,49.0 220.4,49.0 223.1,49.0 225.8,49.0 228.5,49.0 231.2,49.0 234.0,49.0 236.7,49.0 239.4,49.0 242.1,49.0 244.8,49.0 247.5,49.0 250.2,49.0 252.9,49.0 255.6,49.0 258.3,49.0 258.3,49.0 255.6,53.7 252.9,58.4 250.2,62.9 247.5,67.3 244.8,71.6 242.1,75.8 239.4,79.8 236.7,83.7 234.0,87.5 231.2,91.2 228.5,94.8 225.8,98.2 223.1,101.5 220.4,104.7 217.7,107.8 215.0,110.8 212.3,113.6 209.6,116.3 206.9,118.9 204.2,121.4 201.5,121.4 198.8,121.4 196.0,121.4 193.3,121.4 190.6,121.4 187.9,121.4 185.2,121.4 182.5,121.4 179.8,121.4 177.1,121.4 174.4,121.4 171.7,121.4 169.0,121.4 166.2,121.4 163.5,121.4 160.8,121.4 158.1,121.4 155.4,121.4 152.7,121.4 150.0,121.4 147.3,121.4 144.6,121.4 141.9,121.4 139.2,121.4 136.5,121.4 133.8,121.4 131.0,121.4 128.3,121.4 125.6,121.4 122.9,121.4 120.2,121.4 117.5,121.4 114.8,121.4 112.1,121.4 109.4,121.4 106.7,121.4 104.0,121.4 101.2,121.4 98.5,121.4 95.8,121.4 93.1,118.9 90.4,116.3 87.7,113.6 85.0,110.8 82.3,107.8 79.6,104.7 76.9,101.5 74.2,98.2 71.5,94.8 68.8,91.2 66.0,87.5 63.3,83.7 60.6,79.8 57.9,75.8 55.2,71.6 52.5,67.3 49.8,62.9 47.1,58.4 44.4,53.7 41.7,49.0' fill='#b9a4f5' fill-opacity='.55'/><polyline points='28.1,23.3 32.2,31.3 36.2,39.1 40.3,46.5 44.4,53.7 48.4,60.7 52.5,67.3 56.6,73.7 60.6,79.8 64.7,85.6 68.8,91.2 72.8,96.5 76.9,101.5 80.9,106.3 85.0,110.8 89.1,115.0 93.1,118.9 97.2,122.6 101.2,126.0 105.3,129.1 109.4,131.9 113.4,134.5 117.5,136.8 121.6,138.9 125.6,140.6 129.7,142.1 133.8,143.3 137.8,144.3 141.9,145.0 145.9,145.4 150.0,145.5 154.1,145.4 158.1,145.0 162.2,144.3 166.2,143.3 170.3,142.1 174.4,140.6 178.4,138.9 182.5,136.8 186.6,134.5 190.6,131.9 194.7,129.1 198.8,126.0 202.8,122.6 206.9,118.9 210.9,115.0 215.0,110.8 219.1,106.3 223.1,101.5 227.2,96.5 231.2,91.2 235.3,85.6 239.4,79.8 243.4,73.7 247.5,67.3 251.6,60.7 255.6,53.7 259.7,46.5 263.8,39.1 267.8,31.3 271.9,23.3' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='20.0,49.0 150.0,49.0 280.0,49.0' fill='none' stroke='#f0a30a' stroke-width='2'/><polyline points='20.0,121.4 150.0,121.4 280.0,121.4' fill='none' stroke='#16a34a' stroke-width='2'/><text x='242.1' y='39.3' fill='#f0a30a' font-size='10'>y = 2</text><text x='225.8' y='133.4' fill='#16a34a' font-size='10'>y = a</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 145.5H294.0M150.0 174.0V8.0'/></g><line x1='41.7' y1='142.5' x2='41.7' y2='148.5' stroke='currentColor'/><text x='38.7' y='159.5' font-size='10'>-2</text><line x1='95.8' y1='142.5' x2='95.8' y2='148.5' stroke='currentColor'/><text x='92.8' y='159.5' font-size='10'>-1</text><line x1='204.2' y1='142.5' x2='204.2' y2='148.5' stroke='currentColor'/><text x='201.2' y='159.5' font-size='10'>1</text><line x1='258.3' y1='142.5' x2='258.3' y2='148.5' stroke='currentColor'/><text x='255.3' y='159.5' font-size='10'>2</text><line x1='147.0' y1='97.2' x2='153.0' y2='97.2' stroke='currentColor'/><text x='134.0' y='101.2' font-size='10'>1</text><line x1='147.0' y1='49.0' x2='153.0' y2='49.0' stroke='currentColor'/><text x='134.0' y='53.0' font-size='10'>2</text></svg></div>\\[A=\\int_a^2 2\\sqrt{2y}\\,dy=2\\sqrt2\\Bigl[\\frac23y^{3/2}\\Bigr]_a^2=\\frac{4\\sqrt2}3\\bigl(2\\sqrt2-a^{3/2}\\bigr)=\\frac{16}3-\\frac{4\\sqrt2}3a^{3/2}\\]\\[\\frac{16}3-\\frac{4\\sqrt2}3a^{3/2}=\\frac{14}3\\iff a^{3/2}=\\frac1{2\\sqrt2}=2^{-3/2}\\iff a=\\frac12\\]<div class='res'>\\(a=\\dfrac12\\)</div></div>"
    }
