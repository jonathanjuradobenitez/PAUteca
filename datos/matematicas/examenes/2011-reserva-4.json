.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i>:</p>\\[[\\overrightarrow{RS},\\vec u,\\vec v]=\\begin{vmatrix}9&-12&0\\\\2&-1&1\\\\0&0&1\\end{vmatrix}\\]\\[=\\bigl(-9+0+0\\bigr)-\\bigl(0+0-24\\bigr)\\]\\[=15\\neq0\\]<p>Las rectas se cruzan. Busco \\(P\\in r\\), \\(Q\\in s\\) con \\(\\overrightarrow{PQ}\\) perpendicular a ambas:</p>\\[P(-7+2t,\\,7-t,\\,t),\\quad Q(2,\\,-5,\\,\\mu),\\quad\\overrightarrow{PQ}=(9-2t,\\ -12+t,\\ \\mu-t)\\]\\[\\begin{cases}\\overrightarrow{PQ}\\cdot\\vec u=18-4t+12-t+\\mu-t=0\\\\\\overrightarrow{PQ}\\cdot\\vec v=\\mu-t=0\\end{cases}\\iff\\mu=t,\\ 30-5t=0\\iff t=\\mu=6\\]<p>\\(P(5,1,6)\\), \\(Q(2,-5,6)\\), \\(\\overrightarrow{PQ}=(-3,-6,0)\\parallel(1,2,0)\\).</p><div class='f3d' data-f='{\"az\":120,\"el\":28,\"p\":[[\"line\",[1.0,3.0,4.0],[7.4,-0.2,7.2],\"#2563eb\",2.2,false],[\"txt\",[7.4,-0.2,7.2],\"r\",\"#2563eb\",6,0],[\"line\",[2.0,-5.0,2.0],[2.0,-5.0,8.0],\"#16a34a\",2.2,false],[\"txt\",[2.0,-5.0,8.0],\"s\",\"#16a34a\",6,0],[\"line\",[1.4,-6.2,6.0],[5.6,2.2,6.0],\"#c2410c\",1.6,false],[\"txt\",[5.6,2.2,6.0],\"p\",\"#c2410c\",6,0],[\"line\",[5.49,0.755,6.245],[5.222,0.218,6.245],\"#475569\",1.3,false],[\"line\",[5.222,0.218,6.245],[4.732,0.463,6.0],\"#475569\",1.3,false],[\"line\",[2.0,-5.0,6.6],[2.268,-4.463,6.6],\"#475569\",1.3,false],[\"line\",[2.268,-4.463,6.6],[2.268,-4.463,6.0],\"#475569\",1.3,false],[\"pt\",[5,1,6],\"P\",7,-6],[\"pt\",[2,-5,6],\"Q\",7,-6]],\"ley\":[\"recta\",\"vector director\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 300' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m11r4b4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m11r4b4d' viewBox='0 0 10 10' refX='9' refY='5' markerWid