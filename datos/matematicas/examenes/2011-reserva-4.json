  {
   "id": "matematicas-2011-reserva-4-7",
   "n": 7,
   "num": 3,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Dada la matriz \\(A=\\begin{pmatrix}-1&1\\\\2&-1\\end{pmatrix}\\)",
    "apartados": [
     "(1 p.) Demuestra que \\(A^2+2A=I\\) y que \\(A^{-1}=A+2I\\), siendo \\(I\\) la matriz identidad de orden 2.",
     "(1,5 p.) Calcula la matriz \\(X\\) que verifica la ecuación \\(A^2+XA+5A=4I\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[A^2=\\begin{pmatrix}3 & -2\\\\-4 & 3\\end{pmatrix},\\qquad A^2+2A=\\begin{pmatrix}3 & -2\\\\-4 & 3\\end{pmatrix}+\\begin{pmatrix}-2 & 2\\\\4 & -2\\end{pmatrix}=\\begin{pmatrix}1 & 0\\\\0 & 1\\end{pmatrix}=I\\ ✓\\]<p>Saco \\(A\\) factor común: \\(A(A+2I)=I\\), así que \\(A^{-1}=A+2I\\) ✓.</p><div class='res'>Se cumple, y \\(A^{-1}=A+2I=\\begin{pmatrix}1 & 1\\\\2 & 1\\end{pmatrix}\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>\\(XA=4I-A^2-5A\\). Por el apartado a), \\(A^2=I-2A\\), así que \\(XA=3I-3A\\). Multiplico por \\(A^{-1}\\) por la derecha:</p>\\[X=(3I-3A)A^{-1}=3A^{-1}-3I=3(A+2I)-3I=3A+3I\\]<div class='res'>\\(X=\\begin{pmatrix}0 & 3\\\\6 & 0\\end{pmatrix}\\)</div></div>"
    }
   ],
   "clasificacion": [
