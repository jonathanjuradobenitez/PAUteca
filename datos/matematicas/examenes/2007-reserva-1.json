  {
   "id": "matematicas-2007-reserva-1-8",
   "n": 8,
   "num": 4,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Considera los vectores \\(\\vec u=(1,1,m)\\), \\(\\vec v=(0,m,-1)\\) y \\(\\vec w=(1,2m,0)\\).",
    "apartados": [
     "(1,25 p.) Determina el valor de \\(m\\) para que los vectores \\(\\vec u\\), \\(\\vec v\\) y \\(\\vec w\\) sean linealmente dependientes.",
     "(1,25 p.) Para el valor de \\(m\\) obtenido en el apartado anterior, expresa el vector \\(\\vec w\\) como combinación lineal de los vectores \\(\\vec u\\) y \\(\\vec v\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
