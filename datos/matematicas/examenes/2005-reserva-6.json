  {
   "id": "matematicas-2005-reserva-6-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Considera la integral definida \\(I=\\displaystyle\\int_3^8\\frac1{\\sqrt{1+x}-1}\\,dx\\).",
    "apartados": [
     "(1,25 p.) Exprésala aplicando el cambio de variables \\(\\sqrt{1+x}-1=t\\).",
     "(1,25 p.) Calcula \\(I\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'><p>\\(\\sqrt{1+x}-1=t\\Rightarrow\\sqrt{1+x}=t+1\\Rightarrow x=(t+1)^2-1\\), \\(dx=2(t+1)\\,dt\\). Límites: \\(x=3\\Rightarrow t=1\\); \\(x=8\\Rightarrow t=2\\).</p><div class='res'>\\(I=\\displaystyle\\int_1^2\\frac{2(t+1)}t\\,dt\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'>\\[I=\\int_1^2\\left(2+\\frac2t\\right)dt=\\Bigl[2t+2\\ln t\\Bigr]_1^2=(4+2\\ln2)-2=2+2\\ln2\\]<div class='res'>\\(I=2+2\\ln2\\approx3{,}39\\)</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "integ",
     "tipo": "cambio",
     "apartados": "a, b"
    },
    {
     "tema": "integ",
     "tipo": "def",
     "apartados": "b"
    }
   ],
   "origen": {
    "documento": "MAT-2005-RESERVA_6.pdf"
   },
   "dificultad": null,
