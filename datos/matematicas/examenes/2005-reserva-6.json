  {
   "id": "matematicas-2005-reserva-6-1",
   "n": 1,
   "num": 1,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "De una función \\(f:\\mathbb R\\to\\mathbb R\\) se sabe que \\(f(0)=2\\) y que \\(f'(x)=2x\\).",
    "apartados": [
     "(1 p.) Determina \\(f\\).",
     "(1,5 p.) Calcula el área de la región limitada por la gráfica de \\(f\\), por el eje de abscisas y por las rectas de ecuaciones \\(x=-2\\) y \\(x=2\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[f(x)=\\int2x\\,dx=x^2+C,\\qquad f(0)=C=2\\]<div class='res'>\\(f(x)=x^2+2\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>\\(f(x)=x^2+2\\gt0\\): el área es la integral.</p><div style='overflow-x:auto'><svg viewBox='0 0 300 200' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='57.1,40.5 61.8,48.5 66.4,56.1 71.1,63.3 75.7,70.1 80.4,76.4 85.0,82.4 89.6,87.9 94.3,93.0 98.9,97.7 103.6,102.1 108.2,105.9 112.9,109.4 117.5,112.5 122.1,115.2 126.8,117.4 131.4,119.3 136.1,120.7 140.7,121.7 145.4,122.4 150.0,122.6 154.6,122.4 159.3,121.7 163.9,120.7 168.6,119.3 173.2,117.4 177.9,115.2 182.5,112.5 187.1,109.4 191.8,105.9 196.4,102.1 201.1,97.7 205.7,93.0 210.4,87.9 215.0,82.4 219.6,76.4 224.3,70.1 228.9,63.3 233.6,56.1 238.2,48.5 242.9,40.5 242.9,163.6 238.2,163.6 233.6,163.6 228.9,163.6 224.3,163.6 219.6,163.6 215.0,163.6 210.4,163.6 205.7,163.6 201.1,163.6 196.4,163.6 191.8,163.6 187.1,163.6 182.5,163.6 177.9,163.6 173.2,163.6 168.6,163.6 163.9,163.6 159.3,163.6 154.6,163.6 150.0,163.6 145.4,163.6 140.7,163.6 136.1,163.6 131.4,163.6 126.8,163.6 122.1,163.6 117.5,163.6 112.9,163.6 108.2,163.6 103.6,163.6 98.9,163.6 94.3,163.6 89.6,163.6 85.0,163.6 80.4,163.6 75.7,163.6 71.1,163.6 66.4,163.6 61.8,163.6 57.1,163.6' fill='#b9a4f5' fill-opacity='.55'/><polyline points='38.6,4.4 42.3,12.2 46.0,19.6 49.7,26.9 53.4,33.8 57.1,40.5 60.9,46.9 64.6,53.1 68.3,59.0 72.0,64.7 75.7,70.1 79.4,75.2 83.1,80.0 86.9,84.6 90.6,89.0 94.3,93.0 98.0,96.8 101.7,100.4 105.4,103.7 109.1,106.7 112.9,109.4 116.6,111.9 120.3,114.2 124.0,116.1 127.7,117.8 131.4,119.3 135.1,120.5 138.9,121.4 142.6,122.0 146.3,122.4 150.0,122.6 153.7,122.4 157.4,122.0 161.1,121.4 164.9,120.5 168.6,119.3 172.3,117.8 176.0,116.1 179.7,114.2 183.4,111.9 187.1,109.4 190.9,106.7 194.6,103.7 198.3,100.4 202.0,96.8 205.7,93.0 209.4,89.0 213.1,84.6 216.9,80.0 220.6,75.2 224.3,70.1 228.0,64.7 231.7,59.0 235.4,53.1 239.1,46.9 242.9,40.5 246.6,33.8 250.3,26.9 254.0,19.6 257.7,12.2 261.4,4.4' fill='none' stroke='#2f6df0' stroke-width='2'/><line x1='57.1' y1='163.6' x2='57.1' y2='40.5' stroke='#94a3b8' stroke-width='1.4' stroke-dasharray='5 4'/><line x1='242.9' y1='163.6' x2='242.9' y2='40.5' stroke='#94a3b8' stroke-width='1.4' stroke-dasharray='5 4'/><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 163.6H294.0M150.0 194.0V8.0'/></g><line x1='57.1' y1='160.6' x2='57.1' y2='166.6' stroke='currentColor'/><text x='54.1' y='177.6' font-size='10'>-2</text><line x1='103.6' y1='160.6' x2='103.6' y2='166.6' stroke='currentColor'/><text x='100.6' y='177.6' font-size='10'>-1</text><line x1='196.4' y1='160.6' x2='196.4' y2='166.6' stroke='currentColor'/><text x='193.4' y='177.6' font-size='10'>1</text><line x1='242.9' y1='160.6' x2='242.9' y2='166.6' stroke='currentColor'/><text x='239.9' y='177.6' font-size='10'>2</text><line x1='147.0' y1='122.6' x2='153.0' y2='122.6' stroke='currentColor'/><text x='134.0' y='126.6' font-size='10'>2</text><line x1='147.0' y1='40.5' x2='153.0' y2='40.5' stroke='currentColor'/><text x='134.0' y='44.5' font-size='10'>6</text></svg></div>\\[A=\\int_{-2}^2(x^2+2)\\,dx=\\Bigl[\\frac{x^3}3+2x\\Bigr]_{-2}^2=\\left(\\frac83+4\\right)-\\left(-\\frac83-4\\right)=\\frac{40}3\\]<div class='res'>Área \\(=\\dfrac{40}3\\ u^2\\)</div></div>"
    }
