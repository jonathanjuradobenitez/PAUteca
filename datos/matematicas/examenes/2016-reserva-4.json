='translate(106.5,265)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#2563eb' stroke-width='2'/><text x='18' y='0' font-size='10'>recta</text></g><g transform='translate(157.0,265)'><circle cx='6' cy='-4' r='3.8' fill='#e8487a'/><text x='18' y='0' font-size='10'>puntos</text></g></svg><p class='mut' style='font-size:.8rem;margin:.2rem 0;text-align:center'>Figura interactiva: arrástrala para girarla en 3D.</p></div><div class='res'>Área \\(=\\dfrac{\\sqrt2}2\\approx0{,}707\\ u^2\\)</div></div>"},{"titulo":"Apartado c","html":"<div class='ex'><p>\\(\\overrightarrow{AD}=\\overrightarrow{BC}\\):</p>\\[D=A+\\overrightarrow{BC}=(1,1,0)+\\left(-\\frac13,-\\frac13,\\frac23\\right)=\\left(\\frac23,\\frac23,\\frac23\\right)\\]<div class='res'>\\(D\\left(\\dfrac23,\\dfrac23,\\dfrac23\\right)\\)</div><i class='n' data-t='tp'>Comprobación: \\(D\\) está en \\(r\\) (\\(t=\\frac23\\)) ✓.</i></div>"}],"clasificacion":[{"tema":"geom","tipo":"ecs","apartados":"a"},{"tema":"geom","tipo":"perp","apartados":"b"},{"tema":"geom","tipo":"area","apartados":"b"},{"tema":"geom","tipo":"vec","apartados":"c"}],"origen":{"documento":"MAT-2016-RESERVA_4.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"}]}