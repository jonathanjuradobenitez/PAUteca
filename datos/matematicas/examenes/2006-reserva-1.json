   "revision": "borrador"
  },
  {
   "id": "matematicas-2006-reserva-1-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sea \\(f:\\mathbb R\\to\\mathbb R\\) la función definida por \\[f(x)=\\begin{cases}-\\dfrac ax&\\text{si }x\\leq-1\\\\[1mm]x^2+1&\\text{si }x\\gt-1\\end{cases}\\]",
    "apartados": [
     "(0,75 p.) Halla el valor de \\(a\\) sabiendo que \\(f\\) es continua.",
     "(0,5 p.) Esboza la gráfica de \\(f\\).",
     "(1,25 p.) Calcula el área del recinto limitado por la gráfica de \\(f\\), el eje de abscisas y las rectas \\(x+2=0\\) y \\(x-2=0\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[\\lim_{x\\to-1^-}\\left(-\\frac ax\\right)=a=f(-1),\\qquad\\lim_{x\\to-1^+}(x^2+1)=2\\ \\Rightarrow\\ a=2\\]<div class='res'>\\(a=2\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
