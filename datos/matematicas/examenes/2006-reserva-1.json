0.5,164.5 108.2,164.5 105.9,164.5 103.6,164.5 101.2,164.5 98.9,164.5 96.6,164.5 94.3,164.5 92.0,164.5 89.6,164.5 87.3,164.5 85.0,164.5 82.7,164.5 80.4,164.5 78.0,164.5 75.7,164.5 73.4,164.5 71.1,164.5 68.8,164.5 66.4,164.5 64.1,164.5 61.8,164.5 59.5,164.5 57.1,164.5' fill='#b9a4f5' fill-opacity='.55'/><polyline points='20.0,146.1 22.1,145.8 24.2,145.5 26.3,145.1 28.4,144.8 30.4,144.5 32.5,144.1 34.6,143.7 36.7,143.4 38.8,143.0 40.9,142.6 43.0,142.1 45.1,141.7 47.2,141.2 49.2,140.7 51.3,140.2 53.4,139.7 55.5,139.2 57.6,138.6 59.7,138.0 61.8,137.4 63.9,136.7 66.0,136.0 68.1,135.3 70.1,134.5 72.2,133.7 74.3,132.9 76.4,132.0 78.5,131.0 80.6,130.0 82.7,128.9 84.8,127.8 86.9,126.6 88.9,125.3 91.0,123.9 93.1,122.4 95.2,120.8 97.3,119.0 99.4,117.2 101.5,115.1 103.6,112.9' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='103.6,112.9 106.0,115.6 108.5,118.1 111.0,120.5 113.5,122.7 116.0,124.8 118.4,126.8 120.9,128.6 123.4,130.2 125.9,131.7 128.3,133.1 130.8,134.3 133.3,135.4 135.8,136.3 138.2,137.1 140.7,137.7 143.2,138.2 145.7,138.5 148.1,138.7 150.6,138.7 153.1,138.6 155.6,138.3 158.0,137.9 160.5,137.4 163.0,136.7 165.5,135.8 168.0,134.9 170.4,133.7 172.9,132.4 175.4,131.0 177.9,129.4 180.3,127.7 182.8,125.8 185.3,123.8 187.8,121.6 190.2,119.3 192.7,116.9 195.2,114.3 197.7,111.5 200.1,108.6 202.6,105.6 205.1,102.4 207.6,99.0 210.0,95.5 212.5,91.9 215.0,88.1 217.5,84.2 220.0,80.1 222.4,75.9 224.9,71.5 227.4,67.0 229.9,62.4 232.3,57.6 234.8,52.6 237.3,47.5 239.8,42.3 242.2,36.9 244.7,31.3 247.2,25.6 249.7,19.8 252.1,13.8' fill='none' stroke='#2f6df0' stroke-width='2'/><line x1='57.1' y1='164.5' x2='57.1' y2='138.7' stroke='#94a3b8' stroke-width='1.4' stroke-dasharray='5 4'/><line x1='242.9' y1='164.5' x2='242.9' y2='35.5' stroke='#94a3b8' stroke-width='1.4' stroke-dasharray='5 4'/><circle cx='103.6' cy='112.9' r='3.5' fill='#e8487a'/><text x='57.6' y='108.9'>(−1,2)</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 164.5H294.0M150.0 194.0V8.0'/></g><line x1='57.1' y1='161.5' x2='57.1' y2='167.5' stroke='currentColor'/><text x='54.1' y='178.5' font-size='10'>-2</text><line x1='103.6' y1='161.5' x2='103.6' y2='167.5' stroke='currentColor'/><text x='100.6' y='178.5' font-size='10'>-1</text><line x1='196.4' y1='161.5' x2='196.4' y2='167.5' stroke='currentColor'/><text x='193.4' y='178.5' font-size='10'>1</text><line x1='242.9' y1='161.5' x2='242.9' y2='167.5' stroke='currentColor'/><text x='239.9' y='178.5' font-size='10'>2</text><line x1='147.0' y1='112.9' x2='153.0' y2='112.9' stroke='currentColor'/><text x='134.0' y='116.9' font-size='10'>2</text><line x1='147.0' y1='61.3' x2='153.0' y2='61.3' stroke='currentColor'/><text x='134.0' y='65.3' font-size='10'>4</text></svg></div></div>"
    },
    {
     "titulo": "Apartado c",
     "html": "<div class='ex'><p>\\(f\\gt0\\) en \\([-2,2]\\):</p>\\[A=\\int_{-2}^{-1}\\left(-\\frac2x\\right)dx+\\int_{-1}^2(x^2+1)\\,dx=\\Bigl[-2\\ln|x|\\Bigr]_{-2}^{-1}+\\Bigl[\\frac{x^3}3+x\\Bigr]_{-1}^2=2\\ln2+6\\]<div class='res'>Área \\(=6+2\\ln2\\approx7{,}39\\ u^2\\)</div></div>"
    }
   ],
