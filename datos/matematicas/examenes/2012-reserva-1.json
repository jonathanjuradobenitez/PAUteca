nsform='translate(106.5,178)'><line x1='0' y1='-4' x2='14' y2='-4' stroke='#16a34a' stroke-width='2.4'/><text x='18' y='0' font-size='10'>vector director</text></g><g transform='translate(210.0,178)'><circle cx='6' cy='-4' r='3.8' fill='#e8487a'/><text x='18' y='0' font-size='10'>puntos</text></g></svg><p class='mut' style='font-size:.8rem;margin:.2rem 0;text-align:center'>Figura interactiva: arrástrala para girarla en 3D.</p></div><div class='res'>\\(d(OX,r)=4\\) unidades</div><i class='n' data-t='tp'>Comprobación con la fórmula: \\(\\vec u\\times\\vec v=(0,\\ 0,\\ 2)\\) y \\(\\dfrac{|[\\overrightarrow{OS},\\vec u,\\vec v]|}{|\\vec u\\times\\vec v|}=4\\) ✓.</i></div>"}],"clasificacion":[{"tema":"geom","tipo":"pos","apartados":""},{"tema":"geom","tipo":"dist","apartados":""}],"origen":{"documento":"MAT-2012-RESERVA_1.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"}]}