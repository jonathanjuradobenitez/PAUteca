25.6' x2='185.5' y2='131.6' stroke='currentColor'/><text x='182.5' y='142.6' font-size='10'>1</text><line x1='232.7' y1='125.6' x2='232.7' y2='131.6' stroke='currentColor'/><text x='229.7' y='142.6' font-size='10'>3</text><line x1='158.8' y1='182.9' x2='164.8' y2='182.9' stroke='currentColor'/><text x='145.8' y='186.9' font-size='10'>-4</text><line x1='158.8' y1='74.3' x2='164.8' y2='74.3' stroke='currentColor'/><text x='145.8' y='78.3' font-size='10'>4</text></svg></div><div class='res'>Corta a la asíntota horizontal en \\((-2,2)\\)</div></div>"}],"clasificacion":[{"tema":"funciones","tipo":"asint","apartados":"a, c"},{"tema":"funciones","tipo":"mono","apartados":"b"}],"origen":{"documento":"MAT-2012-RESERVA_1.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2012-reserva-1-6","n":6,"num":2,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Sea la función \\(f:\\mathbb R\\to\\mathbb R\\) definida por \\(f(x)=x^2\\cos(x)\\). Determina la primitiva de \\(f\\) cuya gráfica pasa por el punto \\((\\pi,0)\\).","apartados":[]},"solucion":[{"titulo":"Resolución","html":"<div class='ex'><p>Integro por partes dos veces<i class='n' data-t='th'>Integración por partes: \\(\\int u\\,dv=uv-\\int v\\,du\\).</i>:</p>\\[u=x^2,\\ dv=\\cos x\\,dx:\\quad\\int x^2\\cos x\\,dx=x^2\\,\\mathrm{sen}\\,x-\\int2x\\,\\mathrm{sen}\\,x\\,dx\\]\\[u=2x,\\ dv=\\mathrm{sen}\\,x\\,dx:\\quad\\int2x\\,\\mathrm{sen}\\,x\\,dx=-2x\\cos x+2\\,\\mathrm{sen}\\,x\\]\\[F(x)=x^2\\,\\mathrm{sen}\\,x+2x\\cos x-2\\,\\mathrm{sen}\\,x+C\\]<p>\\(F(\\pi)=0+2\\pi(-1)-0+C=0\\iff C=2\\pi\\).</p><div class='res'>\\(F(x)=x^2\\,\\mathrm{sen}\\,x+2x\\cos x-2\\,\\mathrm{sen}\\,x+2\\pi\\)</div></div>"}],"clasificacion":[{"tema":"integ","tipo":"part","apartados":""},{"tema":"integ","tipo":"pcond","apartados":""}],"origen":{"documento":"MAT-2012-RESERVA_1.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2012-reserva-1-7","n":7,"num":3,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Dado el sistema de ecuaciones \\[\\begin{cases}kx+2y=3\\\\-x+2kz=-1\\\\3x-y-7z=k+1\\end{cases}\\]","apartados":["(1,75 p.) Estudia el sistema para los distintos valores del parámetro \\(k\\).","(0,75 p.) Resuélvelo para \\(k=1\\)."]},"solucion":[{"titulo":"Apartado a","html":"<div class='ex'>\\[A^*=\\left(\\begin{array}{ccc|c}k&2&0&3\\\\-1&0&2k&-1\\\\3&-1&-7&k+1\\end{array}\\right)\\]<p>Uso el teorema de Rouché-Frobenius<i class='n' data-t='th'>Rouché-Frobenius: el sistema es compatible si y solo si \\(\\operatorname{rg}A=\\operatorname{rg}A^*\\); determinado si ese rango es el número de incógnitas, indeterminado si es menor.</i>. Por la regla de Sarrus<i class='n' data-t='th'>Regla de Sarrus: se suman los productos de la diagonal principal y de los dos triángulos con un lado paralelo a ella (en verde) y se restan los de la diagonal secundaria y sus dos triángulos (en rojo).<span style='display:block;margin:6px 0 0'><svg viewBox='0 0 206 106' width='100%' style='max-width:230px' font-family='system-ui,sans-serif'><text x='0' y='30' font-size='20' font-weight='700' fill='#17a673'>+</text><text x='0' y='86' font-size='20' font-weight='700' fill='#e8487a'>−</text><polygon points='26,10 41,25 56,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='10' r='3.6' fill='#17a673'/><circle cx='41' cy='10' r='2.2' fill='#9ca3af'/><circle cx='56' cy='10' r='2.2' fill='#9ca3af'/><circle cx='26' cy='25' r='2.2' fill='#9ca3af'/><circle cx='41' cy='25' r='3.6' fill='#17a673'/><circle cx='56' cy='25' r='2.2' fill='#9ca3af'/><circle cx='26' cy='40' r='2.2' fill='#9ca3af'/><circle cx='41' cy='40' r='2.2' fill='#9ca3af'/><circle cx='56' cy='40' r='3.6' fill='#17a673'/><polygon points='103,10 118,25 88,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='10' r='2.2' fill='#9ca3af'/><circle cx='103' cy='10' r='3.6' fill='#17a673'/><circle cx='118' cy='10' r='2.2' fill='#9ca3af'/><circle cx='88' cy='25' r='2.2' fill='#9ca3af'/><circle cx='103' cy='25' r='2.2' fill='#9ca3af'/><circle cx='118' cy='25' r='3.6' fill='#17a673'/><circle cx='88' cy='40' r='3.6' fill='#17a673'/><circle cx='103' cy='40' r='2.2' fill='#9ca3af'/><circle cx='118' cy='40' r='2.2' fill='#9ca3af'/><polygon points='180,10 150,25 165,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='10' r='2.2' fill='#9ca3af'/><circle cx='165' cy='10' r='2.2' fill='#9ca3af'/><circle cx='180' cy='10' r='3.6' fill='#17a673'/><circle cx='150' cy='25' r='3.6' fill='#17a673'/><circle cx='165' cy='25' r='2.2' fill='#9ca3af'/><circle cx='180' cy='25' r='2.2' fill='#9ca3af'/><circle cx='150' cy='40' r='2.2' fill='#9ca3af'/><circle cx='165' cy='40' r='3.6' fill='#17a673'/><circle cx='180' cy='40' r='2.2' fill='#9ca3af'/><polygon points='56,66 41,81 26,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='66' r='2.2' fill='#9ca3af'/><circle cx='41' cy='66' r='2.2' fill='#9ca3af'/><circle cx='56' cy='66' r='3.6' fill='#e8487a'/><circle cx='26' cy='81' r='2.2' fill='#9ca3af'/><circle cx='41' cy='81' r='3.6' fill='#e8487a'/><circle cx='56' cy='81' r='2.2' fill='#9ca3af'/><circle cx='26' cy='96' r='3.6' fill='#e8487a'/><circle cx='41' cy='96' r='2.2' fill='#9ca3af'/><circle cx='56' cy='96' r='2.2' fill='#9ca3af'/><polygon points='88,66 118,81 103,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='66' r='3.6' fill='#e8487a'/><circle cx='103' cy='66' r='2.2' fill='#9ca3af'/><circle cx='118' cy='66' r='2.2' fill='#9ca3af'/><circle cx='88' cy='81' r='2.2' fill='#9ca3af'/><circle cx='103' cy='81' r='2.2' fill='#9ca3af'/><circle cx='118' cy='81' r='3.6' fill='#e8487a'/><circle cx='88' cy='96' r='2.2' fill='#9ca3af'/><circle cx='103' cy='96' r='3.6' fill='#e8487a'/><circle cx='118' cy='96' r='2.2' fill='#9ca3af'/><polygon points='165,66 150,81 180,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='66' r='2.2' fill='#9ca3af'/><circle cx='165' cy='66' r='3.6' fill='#e8487a'/><circle cx='180' cy='66' r='2.2' fill='#9ca3af'/><circle cx='150' cy='81' r='3.6' fill='#e8487a'/><circle cx='165' cy='81' r='2.2' fill='#9ca3af'/><circle cx='180' cy='81' r='2.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i>:</p>\\[|A|=\\begin{vmatrix}k&2&0\\\\-1&0&2k\\\\3&-1&-7\\end{vmatrix}\\]\\[=\\bigl(0+12 k+0\\bigr)-\\bigl(0- 2 k^{2}+14\\bigr)\\]\\[=2k^2+12k-14=2(k-1)(k+7)\\]<p><b>• Si </b>\\(k\\neq1,-7\\)<b>:</b> compatible determinado.</p><p><b>• Si </b>\\(k=-7\\)<b>:</b> \\(\\begin{vmatrix}-7&2\\\\-1&0\\end{vmatrix}=2\\neq0\\): \\(\\operatorname{rg}A=2\\). Menor de \\(A^*\\) de las columnas 1, 2 y 4:</p>\\[\\begin{vmatrix}-7&2&3\\\\-1&0&-1\\\\3&-1&-6\\end{vmatrix}\\]\\[=\\bigl(0-6+3\\bigr)-\\bigl(0-7+12\\bigr)\\]\\[=-8\\neq0\\]<p>\\(\\operatorname{rg}A^*=3\\). <b>Incompatible.</b></p><p><b>• Si </b>\\(k=1\\)<b>:</b> \\(\\begin{vmatrix}1&2\\\\-1&0\\end{vmatrix}=2\\neq0\\): \\(\\operatorname{rg}A=2\\). Menor de \\(A^*\\) de las columnas 1, 2 y 4:</p>\\[\\begin{vmatrix}1&2&3\\\\-1&0&-1\\\\3&-1&2\\end{vmatrix}\\]\\[=\\bigl(0-6+3\\bigr)-\\bigl(0+1-4\\bigr)\\]\\[=0\\]<p>\\(\\operatorname{rg}A^*=2\\). <b>Compatible indeterminado.</b></p><div class='res'>Si \\(k\\neq1,-7\\): compatible determinado. Si \\(k=1\\): compatible indeterminado. Si \\(k=-7\\): incompatible</div></div>"},{"titulo":"Apartado b","html":"<div class='ex'><p>Con \\(k=1\\): \\(x+2y=3\\), \\(-x+2z=-1\\). </p><p>Doy a la incógnita \\(z\\) el valor \\(z=t\\) y lo paso al segundo miembro<i class='n' data-t='why'>La incógnita que no está en el menor no nulo pasa al segundo miembro como parámetro; así queda un sistema con tantas ecuaciones como incógnitas y determinante distinto de 0, que se resuelve por Cramer.</i>:</p>\\[\\begin{cases}x+2y=3\\\\-x=- 2 t - 1\\end{cases}\\]<p>Lo resuelvo por la regla de Cramer<i class='n' data-t='th'>Regla de Cramer: si \\(|A|\\neq0\\), cada incógnita es el cociente entre el determinante que resulta de sustituir su columna por la de los términos independientes y el determinante \\(|A|\\) de la matriz de coeficientes.</i>:</p>\\[|A|=\\begin{vmatrix}1&2\\\\-1&0\\end{vmatrix}=2\\]\\[x=\\frac{\\begin{vmatrix}3&2\\\\- 2 t - 1&0\\end{vmatrix}}{2}=\\frac{2 (2 t + 1)}{2}=2 t + 1\\]\\[y=\\frac{\\begin{vmatrix}1&3\\\\-1&- 2 t - 1\\end{vmatrix}}{2}=\\frac{- 2 (t - 1)}{2}=1 - t\\]<div class='res'>\\(x=1+2t,\\ y=1-t,\\ z=t\\), con \\(t\\in\\mathbb R\\)</div><i class='n' data-t='tp'>Comprobación en la 3.ª, \\(3x-y-7z=2\\): \\(3+6t-1+t-7t=2\\) ✓.</i></div>"}],"clasificacion":[{"tema":"sistemas","tipo":"disc","apartados":"a"},{"tema":"sistemas","tipo":"res","apartados":"b"}],"origen":{"documento":"MAT-2012-RESERVA_1.pdf"},"dificultad":null,"etiquetas":[],"revision":"borrador"},{"id":"matematicas-2012-reserva-1-8","n":8,"num":4,"bloque":"Opción B","puntos":"2,5","enunciado":{"intro":"Calcula de manera razonada la distancia del eje \\(OX\\) a la recta \\(r\\) de ecuaciones \\(\\begin{cases}2x-3y=4\\\\2x-3y-z=0\\end{cases}\\)","apartados":[]},"solucion":[{"titulo":"Resolución","html":"<div class='ex'><p>Restando las dos ecuaciones de \\(r\\): \\(z=4\\). Entonces \\(2x-3y=4\\); con \\(y=2\\mu\\), \\(x=2+3\\mu\\): \\(r\\equiv(2+3\\mu,\\,2\\mu,\\,4)\\). El eje \\(OX\\) es \\((t,0,0)\\).</p><p>\\(OX\\) pasa por \\(O(0,\\ 0,\\ 0)\\) con \\(\\vec u=(1,\\ 0,\\ 0)\\); \\(r\\) pasa por \\(S(2,\\ 0,\\ 4)\\) con \\(\\vec v=(3,\\ 2,\\ 0)\\). Los directores no son proporcionales, así que las rectas se cortan o se cruzan. Con \\(\\overrightarrow{OS}=(2,\\ 0,\\ 4)\\) calculo el producto mixto por la regla de Sarrus<i class='n' data-t='th'>Regla de Sarrus: se suman los productos de la diagonal principal y de los dos triángulos con un lado paralelo a ella (en verde) y se restan los de la diagonal secundaria y sus dos triángulos (en rojo).<span style='display:block;margin:6px 0 0'><svg viewBox='0 0 206 106' width='100%' style='max-width:230px' font-family='system-ui,sans-serif'><text x='0' y='30' font-size='20' font-weight='700' fill='#17a673'>+</text><text x='0' y='86' font-size='20' font-weight='700' fill='#e8487a'>−</text><polygon points='26,10 41,25 56,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='10' r='3.6' fill='#17a673'/><circle cx='41' cy='10' r='2.2' fill='#9ca3af'/><circle cx='56' cy='10' r='2.2' fill='#9ca3af'/><circle cx='26' cy='25' r='2.2' fill='#9ca3af'/><circle cx='41' cy='25' r='3.6' fill='#17a673'/><circle cx='56' cy='25' r='2.2' fill='#9ca3af'/><circle cx='26' cy='40' r='2.2' fill='#9ca3af'/><circle cx='41' cy='40' r='2.2' fill='#9ca3af'/><circle cx='56' cy='40' r='3.6' fill='#17a673'/><polygon points='103,10 118,25 88,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='10' r='2.2' fill='#9ca3af'/><circle cx='103' cy='10' r='3.6' fill='#17a673'/><circle cx='118' cy='10' r='2.2' fill='#9ca3af'/><circle cx='88' cy='25' r='2.2' fill='#9ca3af'/><circle cx='103' cy='25' r='2.2' fill='#9ca3af'/><circle cx='118' cy='25' r='3.6' fill='#17a673'/><circle cx='88' cy='40' r='3.6' fill='#17a673'/><circle cx='103' cy='40' r='2.2' fill='#9ca3af'/><circle cx='118' cy='40' r='2.2' fill='#9ca3af'/><polygon points='180,10 150,25 165,40' fill='#17a673' fill-opacity='.15' stroke='#17a673' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='10' r='2.2' fill='#9ca3af'/><circle cx='165' cy='10' r='2.2' fill='#9ca3af'/><circle cx='180' cy='10' r='3.6' fill='#17a673'/><circle cx='150' cy='25' r='3.6' fill='#17a673'/><circle cx='165' cy='25' r='2.2' fill='#9ca3af'/><circle cx='180' cy='25' r='2.2' fill='#9ca3af'/><circle cx='150' cy='40' r='2.2' fill='#9ca3af'/><circle cx='165' cy='40' r='3.6' fill='#17a673'/><circle cx='180' cy='40' r='2.2' fill='#9ca3af'/><polygon points='56,66 41,81 26,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='26' cy='66' r='2.2' fill='#9ca3af'/><circle cx='41' cy='66' r='2.2' fill='#9ca3af'/><circle cx='56' cy='66' r='3.6' fill='#e8487a'/><circle cx='26' cy='81' r='2.2' fill='#9ca3af'/><circle cx='41' cy='81' r='3.6' fill='#e8487a'/><circle cx='56' cy='81' r='2.2' fill='#9ca3af'/><circle cx='26' cy='96' r='3.6' fill='#e8487a'/><circle cx='41' cy='96' r='2.2' fill='#9ca3af'/><circle cx='56' cy='96' r='2.2' fill='#9ca3af'/><polygon points='88,66 118,81 103,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='88' cy='66' r='3.6' fill='#e8487a'/><circle cx='103' cy='66' r='2.2' fill='#9ca3af'/><circle cx='118' cy='66' r='2.2' fill='#9ca3af'/><circle cx='88' cy='81' r='2.2' fill='#9ca3af'/><circle cx='103' cy='81' r='2.2' fill='#9ca3af'/><circle cx='118' cy='81' r='3.6' fill='#e8487a'/><circle cx='88' cy='96' r='2.2' fill='#9ca3af'/><circle cx='103' cy='96' r='3.6' fill='#e8487a'/><circle cx='118' cy='96' r='2.2' fill='#9ca3af'/><polygon points='165,66 150,81 180,96' fill='#e8487a' fill-opacity='.15' stroke='#e8487a' stroke-width='1.8' stroke-linejoin='round'/><circle cx='150' cy='66' r='2.2' fill='#9ca3af'/><circle cx='165' cy='66' r='3.6' fill='#e8487a'/><circle cx='180' cy='66' r='2.2' fill='#9ca3af'/><circle cx='150' cy='81' r='3.6' fill='#e8487a'/><circle cx='165' cy='81' r='2.2' fill='#9ca3af'/><circle cx='180' cy='81' r='2.2' fill='#9ca3af'/><circle cx='150' cy='96' r='2.2' fill='#9ca3af'/><circle cx='165' cy='96' r='2.2' fill='#9ca3af'/><circle cx='180' cy='96' r='3.6' fill='#e8487a'/></svg></span></i><i class='n' data-t='th'>Si el producto mixto es 0 las rectas son coplanarias y se cortan; si no, se cruzan.</i>:</p>\\[[\\overrightarrow{OS},\\vec u,\\vec v]=\\begin{vmatrix}2&0&4\\\\1&0&0\\\\3&2&0\\end{vmatrix}\\]\\[=\\bigl(0+0+8\\bigr)-\\bigl(0+0+0\\bigr)\\]\\[=8\\neq0\\]<p>Las rectas <b>se cruzan</b>. La distancia es la longitud del segmento \\(PQ\\) perpendicular a las dos (\\(P\\in OX\\), \\(Q\\in r\\))<i class='n' data-t='why'>El segmento perpendicular común es el camino más corto entre dos rectas que se cruzan.</i>:</p>\\[P(t,\\ 0,\\ 0),\\quad Q(2+3\\mu,\\ 2\\mu,\\ 4),\\quad\\overrightarrow{PQ}=(3 \\mu - t + 2,\\ 2 \\mu,\\ 4)\\]\\[\\begin{cases}\\overrightarrow{PQ}\\cdot\\vec u=0\\\\\\overrightarrow{PQ}\\cdot\\vec v=0\\end{cases}\\iff\\begin{cases}3 \\mu - t + 2=0\\\\13 \\mu - 3 t + 6=0\\end{cases}\\]<p>Resolviendo: \\(t=2\\), \\(\\mu=0\\). Entonces \\(P(2,\\ 0,\\ 0)\\) y \\(Q(2,\\ 0,\\ 4)\\):</p>\\[d(OX,r)=|\\overrightarrow{PQ}|=\\left|(0,\\ 0,\\ 4)\\right|=4\\]<div class='f3d' data-f='{\"az\":108,\"el\":16,\"p\":[[\"line\",[0.4,0.0,0.0],[3.6,0.0,0.0],\"#2563eb\",2.2,false],[\"txt\",[3.6,0.0,0.0],\"OX\",\"#2563eb\",6,0],[\"line\",[-2.8,-3.2,4.0],[6.8,3.2,4.0],\"#16a34a\",2.2,false],[\"txt\",[6.8,3.2,4.0],\"r\",\"#16a34a\",6,0],[\"line\",[2.0,0.0,0.0],[2.0,0.0,4.0],\"#c2410c\",2.0,false],[\"line\",[2.25,0.0,0.0],[2.25,0.0,0.25],\"#475569\",1.3,false],[\"line\",[2.25,0.0,0.25],[2.0,0.0,0.25],\"#475569\",1.3,false],[\"line\",[2.208,0.139,4.0],[2.208,0.139,3.75],\"#475569\",1.3,false],[\"line\",[2.208,0.139,3.75],[2.0,0.0,3.75],\"#475569\",1.3,false],[\"pt\",[2.0,0.0,0.0],\"P\",8,12],[\"pt\",[2.0,0.0,4.0],\"Q\",7,-6]],\"ley\":[\"recta\",\"vector director\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 186' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m12r1b4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m12r1b4d' viewBox='0 0 10 10' refX='9' refY='5