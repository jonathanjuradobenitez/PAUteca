  {
   "id": "matematicas-2007-reserva-6-6",
   "n": 6,
   "num": 2,
   "bloque": "Opción B",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sea \\(f:\\mathbb R\\to\\mathbb R\\) la función definida por \\(f(x)=x^2\\).",
    "apartados": [
     "(0,75 p.) Determina la ecuación de la recta tangente a la gráfica de \\(f\\) en el punto de abscisa \\(x=1\\).",
     "(1,75 p.) Dibuja el recinto limitado por la gráfica de \\(f\\), la recta tangente obtenida en el apartado anterior y el eje \\(OX\\). Calcula su área."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'>\\[f(1)=1,\\quad f'(x)=2x\\Rightarrow f'(1)=2,\\qquad y-1=2(x-1)\\]<div class='res'>\\(y=2x-1\\)</div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>La tangente corta al eje \\(OX\\) en \\(x=\\frac12\\). El recinto queda bajo la parábola entre \\(x=0\\) y \\(x=1\\), quitando el triángulo bajo la tangente entre \\(\\frac12\\) y \\(1\\):</p><div style='overflow-x:auto'><svg viewBox='0 0 300 220' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='81.9,161.4 84.0,161.4 86.0,161.4 88.1,161.3 90.2,161.1 92.2,161.0 94.3,160.8 96.3,160.6 98.4,160.3 100.5,160.0 102.5,159.6 104.6,159.3 106.7,158.9 108.7,158.4 110.8,157.9 112.9,157.4 114.9,156.9 117.0,156.3 119.0,155.6 121.1,155.0 123.2,154.3 125.2,153.6 127.3,152.8 129.4,152.0 131.4,151.1 133.5,150.3 135.6,149.4 137.6,148.4 139.7,147.4 141.7,146.4 143.8,145.4 145.9,144.3 147.9,143.1 150.0,142.0 152.1,140.8 154.1,139.6 156.2,138.3 158.3,137.0 160.3,135.6 162.4,134.3 164.4,132.9 166.5,131.4 168.6,129.9 170.6,128.4 172.7,126.9 174.8,125.3 176.8,123.6 178.9,122.0 181.0,120.3 183.0,118.6 185.1,116.8 187.1,115.0 189.2,113.1 191.3,111.3 193.3,109.4 195.4,107.4 197.5,105.4 199.5,103.4 201.6,101.4 203.7,99.3 205.7,97.1 205.7,97.1 203.7,99.3 201.6,101.4 199.5,103.6 197.5,105.7 195.4,107.9 193.3,110.0 191.3,112.1 189.2,114.3 187.1,116.4 185.1,118.6 183.0,120.7 181.0,122.9 178.9,125.0 176.8,127.1 174.8,129.3 172.7,131.4 170.6,133.6 168.6,135.7 166.5,137.9 164.4,140.0 162.4,142.1 160.3,144.3 158.3,146.4 156.2,148.6 154.1,150.7 152.1,152.9 150.0,155.0 147.9,157.1 145.9,159.3 143.8,161.4 141.7,161.4 139.7,161.4 137.6,161.4 135.6,161.4 133.5,161.4 131.4,161.4 129.4,161.4 127.3,161.4 125.2,161.4 123.2,161.4 121.1,161.4 119.0,161.4 117.0,161.4 114.9,161.4 112.9,161.4 110.8,161.4 108.7,161.4 106.7,161.4 104.6,161.4 102.5,161.4 100.5,161.4 98.4,161.4 96.3,161.4 94.3,161.4 92.2,161.4 90.2,161.4 88.1,161.4 86.0,161.4 84.0,161.4 81.9,161.4' fill='#b9a4f5' fill-opacity='.55'/><polyline points='20.0,145.4 24.0,147.4 28.0,149.3 32.1,151.0 36.1,152.6 40.1,154.1 44.1,155.4 48.2,156.7 52.2,157.7 56.2,158.7 60.2,159.5 64.3,160.1 68.3,160.7 72.3,161.0 76.3,161.3 80.4,161.4 84.4,161.4 88.4,161.3 92.4,161.0 96.5,160.5 100.5,160.0 104.5,159.3 108.5,158.5 112.5,157.5 116.6,156.4 120.6,155.2 124.6,153.8 128.6,152.3 132.7,150.6 136.7,148.8 140.7,146.9 144.7,144.9 148.8,142.7 152.8,140.4 156.8,137.9 160.8,135.3 164.9,132.6 168.9,129.7 172.9,126.7 176.9,123.6 181.0,120.3 185.0,116.9 189.0,113.3 193.0,109.6 197.0,105.8 201.1,101.9 205.1,97.8 209.1,93.6 213.1,89.2 217.2,84.7 221.2,80.1 225.2,75.3 229.2,70.4 233.3,65.4 237.3,60.2 241.3,54.9 245.3,49.4 249.4,43.8 253.4,38.1 257.4,32.3 261.4,26.3' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='106.7,200.0 190.2,113.2 273.8,26.4' fill='none' stroke='#f0a30a' stroke-width='2'/><circle cx='205.7' cy='97.1' r='3.5' fill='#e8487a'/><text x='171.7' y='91.1'>(1,1)</text><circle cx='143.8' cy='161.4' r='3.5' fill='#e8487a'/><text x='135.8' y='177.4'>(½,0)</text><text x='242.9' y='29.6' fill='#f0a30a' font-size='10'>y=2x−1</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 161.4H294.0M81.9 214.0V8.0'/></g><line x1='205.7' y1='158.4' x2='205.7' y2='164.4' stroke='currentColor'/><text x='202.7' y='175.4' font-size='10'>1</text><line x1='78.9' y1='97.1' x2='84.9' y2='97.1' stroke='currentColor'/><text x='65.9' y='101.1' font-size='10'>1</text><line x1='78.9' y1='32.9' x2='84.9' y2='32.9' stroke='currentColor'/><text x='65.9' y='36.9' font-size='10'>2</text></svg></div>\\[A=\\int_0^1x^2\\,dx-\\int_{1/2}^1(2x-1)\\,dx=\\frac13-\\Bigl[x^2-x\\Bigr]_{1/2}^1=\\frac13-\\left(0+\\frac14\\right)=\\frac1{12}\\]<div class='res'>Área \\(=\\dfrac1{12}\\ u^2\\)</div></div>"
