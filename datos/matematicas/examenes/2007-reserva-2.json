  },
  {
   "id": "matematicas-2007-reserva-2-2",
   "n": 2,
   "num": 2,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Sean \\(f:\\mathbb R\\to\\mathbb R\\) y \\(g:\\mathbb R\\to\\mathbb R\\) las funciones definidas mediante \\(f(x)=x^3+3x^2\\) y \\(g(x)=x+3\\).",
    "apartados": [
     "(1,25 p.) Esboza las gráficas de \\(f\\) y de \\(g\\) calculando sus puntos de corte.",
     "(1,25 p.) Calcula el área de cada uno de los dos recintos limitados entre las gráficas de \\(f\\) y \\(g\\)."
    ]
   },
   "solucion": [
    {
     "titulo": "Apartado a",
     "html": "<div class='ex'><p><b>Cortes:</b></p>\\[x^3+3x^2=x+3\\iff x^2(x+3)-(x+3)=0\\iff(x+3)(x^2-1)=0\\iff x=-3,\\ -1,\\ 1\\]<p>Puntos \\((-3,0)\\), \\((-1,2)\\) y \\((1,4)\\).</p><p><b>Esbozo de </b>\\(f\\)<b>:</b> \\(f(x)=x^2(x+3)\\) corta al eje en \\(x=-3\\) y en \\(x=0\\) (raíz doble). \\(f'(x)=3x^2+6x=3x(x+2)\\): máximo en \\((-2,4)\\) y mínimo en \\((0,0)\\). \\(g\\) es una recta.</p><div style='overflow-x:auto'><svg viewBox='0 0 300 230' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polygon points='57.1,162.5 59.5,152.2 61.8,142.5 64.1,133.6 66.4,125.3 68.8,117.6 71.1,110.6 73.4,104.1 75.7,98.3 78.0,93.0 80.4,88.3 82.7,84.1 85.0,80.4 87.3,77.2 89.6,74.6 92.0,72.3 94.3,70.5 96.6,69.2 98.9,68.2 101.2,67.7 103.6,67.5 105.9,67.7 108.2,68.2 110.5,69.0 112.9,70.2 115.2,71.6 117.5,73.3 119.8,75.2 122.1,77.4 124.5,79.8 126.8,82.3 129.1,85.1 131.4,88.0 133.8,91.1 136.1,94.3 138.4,97.6 140.7,100.9 143.0,104.4 145.4,107.9 147.7,111.4 150.0,115.0 152.3,118.6 154.6,122.1 157.0,125.6 159.3,129.1 161.6,132.4 163.9,135.7 166.2,138.9 168.6,142.0 170.9,144.9 173.2,147.7 175.5,150.2 177.9,152.6 180.2,154.8 182.5,156.7 184.8,158.4 187.1,159.8 189.5,161.0 191.8,161.8 194.1,162.3 196.4,162.5 198.8,162.3 201.1,161.8 203.4,160.8 205.7,159.5 208.0,157.7 210.4,155.4 212.7,152.8 215.0,149.6 217.3,145.9 219.6,141.7 222.0,137.0 224.3,131.7 226.6,125.9 228.9,119.4 231.2,112.4 233.6,104.7 235.9,96.4 238.2,87.5 240.5,77.8 242.9,67.5 242.9,67.5 240.5,68.7 238.2,69.9 235.9,71.1 233.6,72.2 231.2,73.4 228.9,74.6 226.6,75.8 224.3,77.0 222.0,78.2 219.6,79.4 217.3,80.6 215.0,81.8 212.7,82.9 210.4,84.1 208.0,85.3 205.7,86.5 203.4,87.7 201.1,88.9 198.8,90.1 196.4,91.2 194.1,92.4 191.8,93.6 189.5,94.8 187.1,96.0 184.8,97.2 182.5,98.4 180.2,99.6 177.9,100.8 175.5,101.9 173.2,103.1 170.9,104.3 168.6,105.5 166.2,106.7 163.9,107.9 161.6,109.1 159.3,110.2 157.0,111.4 154.6,112.6 152.3,113.8 150.0,115.0 147.7,116.2 145.4,117.4 143.0,118.6 140.7,119.8 138.4,120.9 136.1,122.1 133.8,123.3 131.4,124.5 129.1,125.7 126.8,126.9 124.5,128.1 122.1,129.2 119.8,130.4 117.5,131.6 115.2,132.8 112.9,134.0 110.5,135.2 108.2,136.4 105.9,137.6 103.6,138.8 101.2,139.9 98.9,141.1 96.6,142.3 94.3,143.5 92.0,144.7 89.6,145.9 87.3,147.1 85.0,148.2 82.7,149.4 80.4,150.6 78.0,151.8 75.7,153.0 73.4,154.2 71.1,155.4 68.8,156.6 66.4,157.8 64.1,158.9 61.8,160.1 59.5,161.3 57.1,162.5' fill='#b9a4f5' fill-opacity='.55'/><polyline points='29.3,347.2 31.6,327.5 33.8,308.7 36.1,290.8 38.4,273.7 40.7,257.4 42.9,241.9 45.2,227.2 47.5,213.3 49.8,200.2 52.0,187.8 54.3,176.1 56.6,165.1 58.9,154.8 61.1,145.2 63.4,136.2 65.7,127.8 68.0,120.1 70.2,113.0 72.5,106.5 74.8,100.5 77.1,95.2 79.3,90.3 81.6,86.0 83.9,82.1 86.2,78.8 88.4,75.9 90.7,73.5 93.0,71.5 95.3,69.9 97.5,68.8 99.8,68.0 102.1,67.6 104.4,67.5 106.6,67.8 108.9,68.4 111.2,69.3 113.5,70.5 115.7,72.0 118.0,73.7 120.3,75.6 122.6,77.8 124.8,80.2 127.1,82.7 129.4,85.4 131.7,88.3 133.9,91.3 136.2,94.5 138.5,97.7 140.8,101.0 143.0,104.4 145.3,107.8 147.6,111.3 149.9,114.8 152.1,118.3 154.4,121.7 156.7,125.2 159.0,128.6 161.2,131.9 163.5,135.1 165.8,138.3 168.1,141.3 170.3,144.2 172.6,147.0 174.9,149.5 177.2,151.9 179.4,154.1 181.7,156.1 184.0,157.8 186.3,159.3 188.5,160.6 190.8,161.5 193.1,162.1 195.4,162.5 197.6,162.5 199.9,162.1 202.2,161.4 204.5,160.2 206.7,158.7 209.0,156.8 211.3,154.4 213.6,151.6 215.8,148.3 218.1,144.5 220.4,140.3 222.7,135.5 224.9,130.1 227.2,124.3 229.5,117.8 231.8,110.8 234.0,103.1 236.3,94.9 238.6,86.0 240.9,76.4 243.1,66.2 245.4,55.3 247.7,43.7 250.0,31.4 252.2,18.3 254.5,4.5 256.8,-10.1' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='20.0,181.5 150.0,115.0 280.0,48.5' fill='none' stroke='#f0a30a' stroke-width='2'/><circle cx='57.1' cy='162.5' r='3.5' fill='#e8487a'/><text x='11.1' y='154.5'>(−3,0)</text><circle cx='150.0' cy='115.0' r='3.5' fill='#e8487a'/><text x='156.0' y='129.0'>(−1,2)</text><circle cx='242.9' cy='67.5' r='3.5' fill='#e8487a'/><text x='250.9' y='71.5'>(1,4)</text><circle cx='103.6' cy='67.5' r='3.5' fill='#e8487a'/><text x='103.6' y='67.5'></text><circle cx='196.4' cy='162.5' r='3.5' fill='#e8487a'/><text x='196.4' y='162.5'></text><text x='89.6' y='53.2' fill='#2f6df0' font-size='9'>máx (−2,4)</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 162.5H294.0M196.4 224.0V8.0'/></g><line x1='57.1' y1='159.5' x2='57.1' y2='165.5' stroke='currentColor'/><text x='54.1' y='176.5' font-size='10'>-3</text><line x1='103.6' y1='159.5' x2='103.6' y2='165.5' stroke='currentColor'/><text x='100.6' y='176.5' font-size='10'>-2</text><line x1='150.0' y1='159.5' x2='150.0' y2='165.5' stroke='currentColor'/><text x='147.0' y='176.5' font-size='10'>-1</text><line x1='242.9' y1='159.5' x2='242.9' y2='165.5' stroke='currentColor'/><text x='239.9' y='176.5' font-size='10'>1</text><line x1='193.4' y1='115.0' x2='199.4' y2='115.0' stroke='currentColor'/><text x='180.4' y='119.0' font-size='10'>2</text><line x1='193.4' y1='67.5' x2='199.4' y2='67.5' stroke='currentColor'/><text x='180.4' y='71.5' font-size='10'>4</text></svg></div></div>"
    },
    {
     "titulo": "Apartado b",
     "html": "<div class='ex'><p>En \\((-3,-1)\\) va por encima \\(f\\) (en \\(x=-2\\): \\(4\\gt1\\)); en \\((-1,1)\\), \\(g\\) (en \\(x=0\\): \\(3\\gt0\\)).</p>\\[A_1=\\int_{-3}^{-1}(x^3+3x^2-x-3)\\,dx=\\Bigl[\\frac{x^4}4+x^3-\\frac{x^2}2-3x\\Bigr]_{-3}^{-1}=\\frac74-\\left(-\\frac94\\right)=4\\]\\[A_2=\\int_{-1}^{1}(-x^3-3x^2+x+3)\\,dx=\\Bigl[-\\frac{x^4}4-x^3+\\frac{x^2}2+3x\\Bigr]_{-1}^{1}=\\frac94-\\left(-\\frac74\\right)=4\\]<div class='res'>Los dos recintos tienen área \\(4\\ u^2\\) cada uno</div></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "funciones",
     "tipo": "rep",
     "apartados": "a"
    },
