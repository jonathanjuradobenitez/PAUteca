  {
   "id": "matematicas-2002-reserva-3-4",
   "n": 4,
   "num": 4,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Halla el punto de la recta \\(r\\equiv\\begin{cases}x+3y+z=1\\\\y+z=-1\\end{cases}\\) que está más cercano al punto \\(P(1,-1,0)\\).",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>\\(r\\): con \\(y=t\\), \\(z=-1-t\\) y \\(x=1-3t-z=2-2t\\): \\(r\\equiv(2-2t,\\,t,\\,-1-t)\\), con \\(\\vec d=(-2,1,-1)\\).</p><p><b>Plano perpendicular a </b>\\(r\\)<b> por </b>\\(P\\)<b>:</b> \\(-2x+y-z+D=0\\), con \\(-2-1+D=0\\iff D=3\\). <b>Corte con </b>\\(r\\)<b>:</b></p>\\[-2(2-2t)+t-(-1-t)+3=0\\iff6t=0\\iff t=0\\]<div class='f3d' data-f='{\"az\":87,\"el\":44,\"p\":[[\"line\",[4.4,-1.2,0.2],[-0.4,1.2,-2.2],\"#2563eb\",2.2,false],[\"txt\",[-0.4,1.2,-2.2],\"r\",\"#2563eb\",6,0],[\"line\",[1,-1,0],[2,0,-1],\"#e11d48\",1.6,false],[\"pt\",[1,-1,0],\"P\",7,-6],[\"pt\",[2,0,-1],\"Q\",7,-6]],\"ley\":[\"recta\",\"puntos\"]}' style='overflow-x:auto'><svg viewBox='0 0 340 260' width='100%' style='max-width:440px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><defs><marker id='m02r3a4n' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#dc2626'/></marker><marker id='m02r3a4d' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#16a34a'/></marker><marker id='m02r3a4g' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#64748b'/></marker><marker id='m02r3a4r' viewBox='0 0 10 10' refX='9' refY='5' markerWidth='7' markerHeight='7' orient='auto'><path d='M0 0L10 5L0 10z' fill='#2563eb'/></marker></defs><line x1='26.0' y1='18.0' x2='314.0' y2='206.3' stroke='#2563eb' stroke-width='2.2'/><text x='320.0' y='206.3' fill='#2563eb' font-weight='700' font-style='italic'>r</text><line x1='225.4' y1='27.3' x2='170.0' y2='112.2' stroke='#e11d48' stroke-width='1.6'/><circle cx='225.4' cy='27.3' r='3.8' fill='#e8487a'/><text x='232.4' y='21.3' font-weight='700'>P</text><circle cx='170.0' cy='112.2' r='3.8' fill='#e8487a'/><text x='177.0' y='106.2' font-weight='700'>Q</text><line x1='24' y1='230' x2='8.0' y2='230.6' stroke='#64748b' strok