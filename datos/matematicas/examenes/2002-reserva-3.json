 "ejercicios": [
  {
   "id": "matematicas-2002-reserva-3-1",
   "n": 1,
   "num": 1,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "De entre todas las rectas que pasan por el origen de coordenadas, determina las que son tangentes a la curva de ecuación \\(y=\\frac14x^2+4x+4\\). Calcula los puntos de tangencia correspondientes.",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>Tangente en el punto de abscisa \\(a\\): \\(f(a)=\\frac{a^2}4+4a+4\\), \\(f'(a)=\\frac a2+4\\). Pasa por el origen si \\(0=f(a)+f'(a)(0-a)\\):</p>\\[\\frac{a^2}4+4a+4-\\frac{a^2}2-4a=0\\iff4-\\frac{a^2}4=0\\iff a=\\pm4\\]<p>• \\(a=4\\): punto \\((4,24)\\), pendiente \\(f'(4)=6\\): \\(y=6x\\).<br>• \\(a=-4\\): punto \\((-4,-8)\\), pendiente \\(f'(-4)=2\\): \\(y=2x\\).</p><div style='overflow-x:auto'><svg viewBox='0 0 300 220' width='100%' style='max-width:380px' font-family='system-ui,sans-serif' font-size='11' fill='currentColor'><polyline points='20.0,191.4 23.1,193.3 26.2,195.1 29.2,196.7 32.3,198.3 35.4,199.7 38.5,201.0 41.6,202.3 44.6,203.4 47.7,204.4 50.8,205.3 53.9,206.1 56.9,206.8 60.0,207.3 63.1,207.8 66.2,208.2 69.3,208.4 72.3,208.5 75.4,208.6 78.5,208.5 81.6,208.3 84.7,208.0 87.7,207.6 90.8,207.1 93.9,206.5 97.0,205.7 100.1,204.9 103.1,204.0 106.2,202.9 109.3,201.7 112.4,200.5 115.4,199.1 118.5,197.6 121.6,196.0 124.7,194.3 127.8,192.5 130.8,190.6 133.9,188.5 137.0,186.4 140.1,184.1 143.2,181.8 146.2,179.3 149.3,176.7 152.4,174.1 155.5,171.3 158.6,168.4 161.6,165.4 164.7,162.3 167.8,159.0 170.9,155.7 173.9,152.3 177.0,148.7 180.1,145.0 183.2,141.3 186.3,137.4 189.3,133.4 192.4,129.3 195.5,125.1 198.6,120.8 201.7,116.4 204.7,111.9 207.8,107.2 210.9,102.5 214.0,97.6 217.1,92.7 220.1,87.6 223.2,82.4 226.3,77.2 229.4,71.8 232.4,66.3 235.5,60.6 238.6,54.9 241.7,49.1 244.8,43.2 247.8,37.1 250.9,31.0 254.0,24.7 257.1,18.3 260.2,11.9 263.2,5.3 266.3,-1.4' fill='none' stroke='#2f6df0' stroke-width='2'/><polyline points='162.3,198.3 209.5,109.6 256.7,20.9' fill='none' stroke='#f0a30a' stroke-width='2'/><polyline points='115.8,200.0 170.5,165.7 225.3,131.4' fill='none' stroke='#16a34a' stroke-width='2'/><circle cx='238.9' cy='54.3' r='3.5' fill='#e8487a'/><text x='192.9' y='52.3'>(4,24)</text><circle cx='129.5' cy='191.4' r='3.5' fill='#e8487a'/><text x='105.5' y='207.4'>(−4,−8)</text><g stroke='currentColor' fill='none' stroke-width='1.2'><path d='M12.0 157.1H294.0M184.2 214.0V8.0'/></g><line x1='74.7' y1='154.1' x2='74.7' y2='160.1' stroke='currentColor'/><text x='71.7' y='171.1' font-size='10'>-8</text><line x1='129.5' y1='154.1' x2='129.5' y2='160.1' stroke='currentColor'/><text x='126.5' y='171.1' font-size='10'>-4</text><line x1='238.9' y1='154.1' x2='238.9' y2='160.1' stroke='currentColor'/><text x='235.9' y='171.1' font-size='10'>4</text><line x1='181.2' y1='191.4' x2='187.2' y2='191.4' stroke='currentColor'/><text x='168.2' y='195.4' font-size='10'>-8</text><line x1='181.2' y1='122.9' x2='187.2' y2='122.9' stroke='currentColor'/><text x='168.2' y='126.9' font-size='10'>8</text><line x1='181.2' y1='88.6' x2='187.2' y2='88.6' stroke='currentColor'/><text x='168.2' y='92.6' font-size='10'>16</text><line x1='181.2' y1='54.3' x2='187.2' y2='54.3' stroke='currentColor'/><text x='168.2' y='58.3' font-size='10'>24</text></svg></div><div class='res'>\\(y=6x\\), tangente en \\((4,24)\\), e \\(y=2x\\), tangente en \\((-4,-8)\\)</div></div>"
    }
   ],
   "clasificacion": [
