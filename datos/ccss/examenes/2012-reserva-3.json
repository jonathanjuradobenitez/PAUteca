 "convocatoria": "Reserva 3",
 "documento": null,
 "ejercicios": [
  {
   "id": "ccss-2012-reserva-3-1",
   "n": 1,
   "num": 1,
   "bloque": "Opción A",
   "puntos": "2,5",
   "enunciado": {
    "intro": "Halle la matriz \\(X\\) que verifique la ecuación matricial \\(A^2\\cdot X=A-B\\cdot C\\), siendo \\(A\\), \\(B\\) y \\(C\\) las matrices \\(A=\\begin{pmatrix}1&1\\\\0&2\\end{pmatrix}\\), \\(B=\\begin{pmatrix}1&0&1\\\\-1&1&4\\end{pmatrix}\\), \\(C=\\begin{pmatrix}-1&0\\\\-1&1\\\\2&0\\end{pmatrix}\\).",
    "apartados": []
   },
   "solucion": [
    {
     "titulo": "Resolución",
     "html": "<div class='ex'><p>Si \\(A^2\\) tiene inversa, multiplicamos por \\((A^2)^{-1}\\) por la izquierda<i class='n' data-t='why'>\\(A^2\\) está a la izquierda de \\(X\\), así que su inversa también se pone a la izquierda.</i>:</p>\\[X=(A^2)^{-1}\\,(A-B\\cdot C)\\]<p>Calculamos cada pieza:</p>\\[A^2=\\begin{pmatrix}1&1\\\\0&2\\end{pmatrix}\\begin{pmatrix}1&1\\\\0&2\\end{pmatrix}=\\begin{pmatrix}1&3\\\\0&4\\end{pmatrix}\\]\\[B\\cdot C=\\begin{pmatrix}1&0&1\\\\-1&1&4\\end{pmatrix}\\begin{pmatrix}-1&0\\\\-1&1\\\\2&0\\end{pmatrix}=\\begin{pmatrix}-1+0+2&0\\\\1-1+8&1\\end{pmatrix}=\\begin{pmatrix}1&0\\\\8&1\\end{pmatrix}\\]\\[A-B\\cdot C=\\begin{pmatrix}0&1\\\\-8&1\\end{pmatrix}\\]<p>\\(|A^2|=4\\neq0\\), luego existe la inversa:</p>\\[(A^2)^{-1}=\\frac1{|A^2|}\\bigl(\\mathrm{Adj}\\,A^2\\bigr)^t=\\frac14\\begin{pmatrix}4&-3\\\\0&1\\end{pmatrix}\\]\\[X=\\frac14\\begin{pmatrix}4&-3\\\\0&1\\end{pmatrix}\\begin{pmatrix}0&1\\\\-8&1\\end{pmatrix}=\\frac14\\begin{pmatrix}24&1\\\\-8&1\\end{pmatrix}\\]<div class='res'>\\(X=\\begin{pmatrix}6&\\frac14\\\\[2pt]-2&\\frac14\\end{pmatrix}\\)</div><i class='n' data-t='tp'>Comprobación: \\(A^2X=\\begin{pmatrix}6-6&\\frac14+\\frac34\\\\-8&1\\end{pmatrix}=\\begin{pmatrix}0&1\\\\-8&1\\end{pmatrix}\\) ✓.</i></div>"
    }
   ],
   "clasificacion": [
    {
     "tema": "matrices",
     "tipo": "ecmat",
     "apartados": ""
    },
    {
     "tema": "matrices",
     "tipo": "inv",
